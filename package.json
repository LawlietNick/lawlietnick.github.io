{
  "name": "nk-2026-astrojs",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run validate:content && npm run validate:classification",
    "test": "npm run test:unit && npm run test:legacy",
    "test:unit": "vitest run",
    "test:legacy": "node --test test/*.test.*",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:classification": "node scripts/validate-page-classification.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.2",
    "docx": "^9.7.1",
    "mermaid": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.0"
  }
}

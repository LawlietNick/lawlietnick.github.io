---
import AskAI from "../components/AskAI.astro";
import Badge from "../components/Badge.astro";
import Base from "../layouts/Base.astro";
import ButtonLink from "../components/ButtonLink.astro";
import Hero from "../components/Hero.astro";
import PatternList from "../components/PatternList.astro";
import PostHero from "../components/PostHero.astro";
import PostList from "../components/PostList.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ServiceGroups from "../components/ServiceGroups.astro";
import ServiceProof from "../components/ServiceProof.astro";
import SplitSection from "../components/SplitSection.astro";

const processItems = [
  {
    title: "Make the current state visible",
    text: "Map what exists, what is missing and what the setup needs to support.",
  },
  {
    title: "Turn findings into a working pattern",
    text: "Create practical recommendations, specifications or workflows.",
  },
  {
    title: "Leave the team with something usable",
    text: "Document decisions so the work survives everyday use.",
  },
];

const formatItems = [
  "SEO audit",
  "Measurement plan",
  "GTM implementation",
  "Dashboard development",
  "AI workflow design",
  "Ongoing sparring",
];

const samplePosts = [
  {
    title: "Use AI for multi-expert analysis with one prompt",
    description:
      "Turn ChatGPT or Gemini into a panel of experts instead of another polite summary machine.",
    date: "2025-11-09",
    minutes: 4,
    url: "/blog/ai-panel-with-experts/",
  },
  {
    title: "Create a cleaner measurement plan",
    description:
      "A small structure for deciding what to track before opening the tag manager.",
    date: "2025-08-14",
    minutes: 3,
    url: "/templates/cookiebot-guide/",
  },
  {
    title: "Make recurring SEO checks less fragile",
    description:
      "How to turn scattered audit notes into a repeatable workflow.",
    date: "2025-07-02",
    minutes: 5,
    url: "/blog/prompt-optimization-chatgpt/",
  },
];

const samplePostHero = {
  title: "Use AI for multi-expert analysis with one prompt",
  description:
    "Turn ChatGPT or Gemini into a panel of experts. Useful when a single neat answer is too tidy for the actual problem.",
  date: "2025-11-09",
  image: "/images/blog/ai-panel-with-experts.jpeg",
  imageAlt: "Animal expert panel around a meeting table",
  imageCredit: "Generated by ChatGPT",
};

// service hub building blocks (ServiceCard / ServiceGroups)
const sampleServices = [
  {
    href: "/services/technical-seo-audit/",
    icon: "⌕",
    title: "Technical SEO Audit",
    summary: "Find and prioritise the technical issues that stop the right pages being found.",
    group: "diagnose",
    order: 1,
  },
  {
    href: "/services/google-analytics-audit/",
    icon: "◎",
    title: "Google Analytics Audit",
    summary: "Find tracking gaps and unreliable reports in GA4, then turn them into a plan.",
    group: "diagnose",
    order: 2,
  },
  {
    href: "/services/tag-manager-audit/",
    icon: "✦",
    title: "Tag Manager Audit",
    summary: "Review GTM tags, triggers and consent logic, then turn it into a cleanup plan.",
    group: "diagnose",
    order: 3,
  },
];
---

<Base
  title="Design System"
  description="Internal visual QA gallery for the Niko site design system."
  noindex
>
  <section class="about ds-hero">
    <div>
      <p class="eyebrow">Design system</p>
      <h1>Current elements, extracted into a small system.</h1>
    </div>
    <div>
      <p>
        This page is an internal visual QA surface for tokens, typography,
        buttons, badges, sections, lists and prose. It is hidden from normal
        navigation and marked noindex.
      </p>
      <ButtonLink href="/services/" label="Example CTA" />
    </div>
  </section>

  <section class="ds-section" aria-labelledby="tokens-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Tokens</p>
      <h2 id="tokens-title">Color roles</h2>
    </div>
    <div class="ds-swatches">
      <div class="ds-swatch ds-swatch--ink"><span>Ink</span></div>
      <div class="ds-swatch ds-swatch--bg"><span>Background</span></div>
      <div class="ds-swatch ds-swatch--muted"><span>Muted</span></div>
      <div class="ds-swatch ds-swatch--accent"><span>Accent</span></div>
      <div class="ds-swatch ds-swatch--pop"><span>Pop</span></div>
      <div class="ds-swatch ds-swatch--surface"><span>Surface</span></div>
      <div class="ds-swatch ds-swatch--danger"><span>Danger</span></div>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="type-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Typography</p>
      <h2 id="type-title">Display and body rhythm</h2>
    </div>
    <div class="ds-type">
      <h1>SEO, analytics and AI workflows.</h1>
      <h2>Make the setup visible before automating it.</h2>
      <h3>One serif voice for every heading level</h3>
      <h4>Minor headings gain weight, not noise</h4>
      <h5>Compact headings stay unmistakably headings</h5>
      <h6>The smallest level still reads as structure</h6>
      <p>
        Body copy should stay plain, practical and readable. The voice can be
        personal, but it should not become vague consultancy fog. The heading
        ladder above shows the global fluid scale: h1–h3 at weight 620, h4–h6
        compensating with weight 650 and looser leading.
      </p>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="font-usage-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Font usage</p>
      <h2 id="font-usage-title">Two fonts, clear jobs</h2>
      <p>
        Fraunces carries the display voice. Roboto Flex does the practical work.
        The system should feel expressive in headings and calm everywhere else.
      </p>
    </div>

    <div class="ds-font-grid">
      <article class="surface ds-font-card ds-font-card--display">
        <p class="eyebrow">Display face</p>
        <p class="ds-token-name">--font-display: Fraunces</p>
        <p class="ds-font-sample">
          Clear decisions from messy signals.
        </p>
        <p>
          Use for page titles, section headings, post titles and selected brand
          moments. Avoid long paragraphs.
        </p>
      </article>

      <article class="surface ds-font-card ds-font-card--body">
        <p class="eyebrow">Body and UI face</p>
        <p class="ds-token-name">--font-body: Roboto Flex</p>
        <p class="ds-font-sample">
          I help teams measure, analyze and improve digital work with cleaner
          data, practical workflows and documentation people can actually use.
        </p>
        <p>
          Use for body copy, navigation, buttons, metadata, service cards and
          interface text.
        </p>
      </article>

      <article class="surface ds-font-card">
        <p class="eyebrow">Weights</p>
        <dl class="ds-type-scale">
          <div>
            <dt>Body</dt>
            <dd class="ds-weight-body">420, everyday reading</dd>
          </div>
          <div>
            <dt>Medium</dt>
            <dd class="ds-weight-medium">560, metadata and quiet emphasis</dd>
          </div>
          <div>
            <dt>Strong</dt>
            <dd class="ds-weight-strong">650, compact headings and links</dd>
          </div>
          <div>
            <dt>Bold</dt>
            <dd class="ds-weight-bold">700, CTAs and strong emphasis</dd>
          </div>
        </dl>
      </article>

      <article class="surface ds-font-card">
        <p class="eyebrow">Labels and code</p>
        <div class="ds-label-demo">
          <span class="eyebrow">Eyebrow label</span>
          <span class="tag">Analytics</span>
          <Badge>Podcast</Badge>
        </div>
        <p>
          Labels use Roboto Flex with uppercase tracking. Code stays inside
          prose and technical examples only:
        </p>
        <code>dataLayer.push({`{ event: "generate_lead" }`})</code>
      </article>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="brand-details-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Brand details</p>
      <h2 id="brand-details-title">Small details that carry the site voice</h2>
    </div>
    <div class="ds-brand-grid">
      <article class="surface ds-card ds-mark-card">
        <p class="eyebrow">Hero mark</p>
        <h3>Messy data into <span class="brand-mark">decisions</span></h3>
        <p>
          The mark is an italic accent with a soft rotated band. It should feel
          a little hand-touched without turning into decoration soup.
        </p>
      </article>

      <article class="surface ds-card">
        <h3 class="section-title">Section title</h3>
        <p>
          Use the ruled section title when a page needs a quiet structural
          marker rather than another heavy block.
        </p>
      </article>

      <article class="surface ds-card">
        <p class="eyebrow">Stats</p>
        <div class="stats ds-stats-sample">
          <div><strong>08</strong><span>Years experience</span></div>
          <div><strong>∞</strong><span>Data curiosity</span></div>
        </div>
      </article>

      <article class="surface ds-card">
        <p class="eyebrow">Metadata and links</p>
        <div class="byline ds-byline-sample">
          <span class="tag">Analytics</span>
          <span class="tag">SEO</span>
        </div>
        <p>
          Inline links use the same accent system: <a class="text-link" href="/blog/ai-panel-with-experts/">read the note</a>.
        </p>
        <a class="more" href="/services/">Explore services</a>
      </article>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="actions-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Actions and labels</p>
      <h2 id="actions-title">CTAs, badges and tags</h2>
    </div>
    <div class="ds-row">
      <ButtonLink href="/services/" label="Start a project" />
      <ButtonLink href="/about/" label="Secondary action" variant="secondary" />
      <Badge>Podcast</Badge>
      <span class="tag">Analytics</span>
    </div>
  </section>

  <SplitSection
    id="split-example"
    eyebrow="Split section"
    title="A reusable two-column section for service and about content."
  >
    <p>
      The split section keeps the site rhythm familiar while letting pages use
      less duplicated HTML. Use it when the section has a short framing column
      and a more detailed copy column.
    </p>
    <p>
      Keep bespoke sections bespoke when the structure is doing something more
      specific, such as the home hero or public appearances list.
    </p>
  </SplitSection>

  <section class="ds-section" aria-labelledby="lists-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Lists</p>
      <h2 id="lists-title">Process and format lists</h2>
    </div>
    <div class="ds-list-grid">
      <PatternList items={processItems} />
      <PatternList items={formatItems} variant="arrow" />
    </div>
  </section>

  <section class="ds-section" aria-labelledby="surface-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Surfaces</p>
      <h2 id="surface-title">Quiet panels</h2>
    </div>
    <div class="ds-surface-grid">
      <article class="surface ds-card">
        <Badge>Example</Badge>
        <h3>Reusable without becoming generic</h3>
        <p>
          Surfaces should frame content quietly. Avoid turning every section
          into a card grid.
        </p>
      </article>
      <article class="surface ds-card">
        <span class="tag">Workflow</span>
        <h3>Small comic twist</h3>
        <p>
          Personality should appear in details such as labels, arrows and the
          halftone CTA shadow.
        </p>
      </article>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="services-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Services</p>
      <h2 id="services-title">Service cards and proof</h2>
      <p>
        The service hub uses its own card, distinct from the flat work cards: a
        comic panel on the signature halftone-dot offset shadow (same motif as
        the CTA). It lifts, the border and icon go accent, and the dotted shadow
        pops out on hover and focus. The proof strip carries verified credibility
        only.
      </p>
    </div>

    <ServiceProof />

    <div class="ds-service-grid">
      {
        sampleServices.map((s) => (
          <ServiceCard href={s.href} icon={s.icon} title={s.title} summary={s.summary} />
        ))
      }
    </div>
  </section>

  <section class="ds-section prose" aria-labelledby="prose-title">
    <p class="eyebrow">Prose</p>
    <h2 id="prose-title">Markdown content style</h2>
    <p>
      Long-form writing uses a narrower measure and practical hierarchy. Code
      blocks wrap long lines so technical posts do not break the mobile layout.
      Inline links <a href="/blog/ai-panel-with-experts/">render in the accent
      style</a> with a soft underline that solidifies on hover.
    </p>
    <table>
      <thead>
        <tr>
          <th>Pattern</th>
          <th>Use</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>CTA</td>
          <td>Primary action, not every link.</td>
        </tr>
        <tr>
          <td>Badge</td>
          <td>Type, status or small public proof metadata.</td>
        </tr>
        <tr>
          <th>Row header</th>
          <td>Body row headers keep the 1px rhythm of their neighbors.</td>
        </tr>
      </tbody>
    </table>
    <figure>
      <img
        src="/images/blog/prompt-optimization-chatgpt.jpeg"
        alt="Cartoon turtle dressed as a prompt engineer"
        width="480"
        loading="lazy"
      />
      <figcaption>Captions live inside the dashed image panel.</figcaption>
    </figure>
  </section>

  <section class="ds-section prose" aria-labelledby="forms-title">
    <p class="eyebrow">Forms</p>
    <h2 id="forms-title">Form controls</h2>
    <form action="#" method="post">
      <fieldset>
        <legend>Sample fields</legend>
        <div class="form-field">
          <label for="ds-name">Text field</label>
          <input type="text" id="ds-name" name="ds-name" placeholder="Placeholder text" />
        </div>
        <div class="form-field">
          <label for="ds-email">Field with an error</label>
          <input
            type="email"
            id="ds-email"
            name="ds-email"
            value="not-an-email"
            aria-invalid="true"
            aria-describedby="ds-email-error"
          />
          <p id="ds-email-error" role="alert">Enter a valid email address.</p>
        </div>
        <div class="form-field">
          <label for="ds-select">Select field</label>
          <select id="ds-select" name="ds-select">
            <option value="">Choose an option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
          </select>
        </div>
        <div class="form-choice">
          <input type="checkbox" id="ds-check" name="ds-check" checked />
          <label for="ds-check">Checked choice in brand accent</label>
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit">Submit</button>
        <button type="button">Regular button</button>
        <button type="button" disabled>Disabled button</button>
      </div>
    </form>
  </section>

  <section class="ds-section" aria-labelledby="page-patterns-title">
    <div class="ds-section__heading">
      <p class="eyebrow">Page patterns</p>
      <h2 id="page-patterns-title">Bespoke sections worth checking together</h2>
      <p>
        These patterns stay closer to pages than primitives. They are included
        here so visual QA catches the parts of the site with the most
        personality.
      </p>
    </div>

    <div class="ds-pattern-stack">
      <article class="ds-pattern">
        <p class="eyebrow">Home hero</p>
        <Hero
          title="I turn messy data into"
          mark="decisions"
          copy="Analytics, SEO and AI workflows that teams can actually use."
          cta="Work with me"
          href="/services/"
        />
      </article>

      <article class="ds-pattern">
        <p class="eyebrow">Service groups</p>
        <ServiceGroups
          items={sampleServices}
          groupLabels={{ diagnose: "Find out what is wrong" }}
          order={["diagnose"]}
        />
      </article>

      <article class="ds-pattern">
        <p class="eyebrow">Post hero</p>
        <PostHero fm={samplePostHero} />
      </article>

      <article class="ds-pattern">
        <p class="eyebrow">Ask AI strip</p>
        <AskAI
          url="https://karppinen.one/blog/ai-panel-with-experts/"
          title="Use AI for multi-expert analysis with one prompt"
        />
      </article>

      <article class="ds-pattern">
        <p class="eyebrow">Writing list</p>
        <PostList posts={samplePosts} title="Recent Posts" />
      </article>

      <article class="ds-pattern">
        <p class="eyebrow">Appearances item</p>
        <div class="ds-appearance-list">
          <article class="ds-appearance">
            <div class="ds-appearance__meta">
              <time datetime="2025-06-25">25.6.2025</time>
              <Badge class="appearance__type">Podcast</Badge>
            </div>
            <div class="ds-appearance__body">
              <h3>Signal: Web-analytiikka, SEO ja evästeet</h3>
              <p>
                Keskustelimme evästeistä, web-analytiikasta, tekoälystä ja
                hakukoneoptimoinnin muutoksesta.
              </p>
              <a
                class="ds-appearance__link"
                href="https://open.spotify.com/episode/0tHszPbmKj7UVnMrscOsQy?si=627aee896bcd46b3"
              >
                Kuuntele jakso Spotifyssa <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .ds-hero {
    border-top: 0;
  }

  .ds-hero p {
    max-width: 62ch;
    margin-top: 0;
  }

  .ds-section {
    padding-block: var(--section-y);
    border-top: 1px solid var(--line);
  }

  .ds-section__heading {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .ds-section__heading h2 {
    margin: 0.75rem 0 0;
    font-size: clamp(1.8rem, 4.5cqi, 2.7rem);
  }

  .ds-swatches,
  .ds-list-grid,
  .ds-surface-grid,
  .ds-brand-grid,
  .ds-font-grid {
    display: grid;
    gap: 1rem;
  }

  .ds-swatches {
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }

  .ds-swatch {
    min-height: 7rem;
    display: flex;
    align-items: end;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-bold);
  }

  .ds-swatch--ink {
    color: var(--bg);
    background: var(--ink);
  }

  .ds-swatch--bg {
    color: var(--ink);
    background: var(--bg);
  }

  .ds-swatch--muted {
    color: var(--bg);
    background: var(--muted);
  }

  .ds-swatch--accent {
    color: var(--bg);
    background: var(--accent);
  }

  .ds-swatch--pop {
    color: var(--color-neutral-950);
    background: var(--pop);
  }

  .ds-swatch--surface {
    color: var(--ink);
    background: var(--color-surface);
  }

  .ds-swatch--danger {
    color: var(--bg);
    background: var(--color-danger);
  }

  .ds-type {
    max-width: 52rem;
  }

  /* the ladder demos the real global scale — no size overrides here */
  .ds-type :is(h1, h2, h3, h4, h5, h6) {
    margin: 0 0 0.85rem;
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .ds-list-grid,
  .ds-surface-grid,
  .ds-brand-grid,
  .ds-font-grid {
    grid-template-columns: 1fr;
  }

  .ds-service-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    margin-top: 1.5rem;
  }

  @container page (min-width: 46rem) {
    .ds-service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ds-card {
    padding: 1.5rem;
  }

  .ds-card h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.2rem;
  }

  .ds-card p {
    margin: 0;
    color: var(--muted);
  }

  .ds-font-card {
    padding: 1.5rem;
  }

  .ds-font-card > :first-child {
    margin-top: 0;
  }

  .ds-font-card > :last-child {
    margin-bottom: 0;
  }

  .ds-token-name {
    margin: 0.65rem 0 1rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .ds-font-sample {
    margin: 0 0 1rem;
  }

  .ds-font-card--display .ds-font-sample {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6cqi, 3.4rem);
    font-weight: var(--font-weight-bold);
    font-variation-settings: "opsz" 144, "WONK" 1;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .ds-font-card--body .ds-font-sample {
    max-width: 58ch;
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
    color: var(--ink);
  }

  .ds-type-scale {
    display: grid;
    gap: 0.85rem;
    margin: 1rem 0 0;
  }

  .ds-type-scale div {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .ds-type-scale dt {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .ds-type-scale dd {
    margin: 0;
  }

  .ds-weight-body {
    font-weight: var(--font-weight-body);
  }

  .ds-weight-medium {
    font-weight: var(--font-weight-medium);
  }

  .ds-weight-strong {
    font-weight: var(--font-weight-strong);
  }

  .ds-weight-bold {
    font-weight: var(--font-weight-bold);
  }

  .ds-label-demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    margin-block: 1rem;
  }

  .ds-font-card code {
    display: inline-block;
    max-width: 100%;
    padding: 0.25rem 0.5rem;
    overflow-wrap: anywhere;
    color: var(--ink);
    background: var(--color-accent-soft);
    border-radius: var(--radius-xs);
  }

  .ds-mark-card h3 {
    margin: 0.7rem 0 0.8rem;
    font-size: clamp(1.7rem, 4.5cqi, 2.5rem);
  }

  .ds-card .section-title {
    margin: 0 0 1rem;
  }

  .ds-stats-sample {
    margin-top: 0.8rem;
  }

  .ds-byline-sample {
    margin-block: 0.8rem 1rem;
  }

  .ds-card .more {
    margin: 1rem 0 0;
  }

  .ds-pattern-stack {
    display: grid;
    gap: 3rem;
  }

  .ds-pattern {
    min-width: 0;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .ds-pattern > .eyebrow {
    margin: 0 0 1rem;
  }

  .ds-pattern :global(.hero) {
    padding-block: 1rem 0;
  }

  .ds-pattern :global(.hero-cards) {
    min-height: clamp(15rem, 42cqi, 20rem);
  }

  .ds-pattern :global(.service-group) {
    margin-top: 0;
  }

  .ds-pattern :global(.service-group) :global(.section-title) {

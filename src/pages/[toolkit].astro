---
import Base from "../layouts/Base.astro";
import ToolkitList from "../components/ToolkitList.astro";
import { toolkit } from "../data/toolkit.js";
import { interactiveTools } from "../data/interactive-tools.js";

// item markdown per category (add a category dir and its entries appear here)
const itemGlobs = {
  tools: import.meta.glob("./tools/*.md", { eager: true }),
  templates: import.meta.glob("./templates/*.md", { eager: true }),
};

export function getStaticPaths() {
  return toolkit.map((item) => ({ params: { toolkit: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const c = item.en;
const mdItems = Object.entries(itemGlobs[item.slug] ?? {}).filter(([, mod]) => !mod.frontmatter.draft).map(([path, mod]) => ({
  ...mod.frontmatter,
  href: `/${item.slug}/${path.split("/").pop().replace(/\.md$/, "")}/`,
}));
const interactive = interactiveTools
  .filter((t) => t.category === item.slug && t.en)
  .map((t) => ({ ...t.en, icon: t.icon, art: t.art, order: t.order ?? 0, href: `/${item.slug}/${t.slug}/` }));
const items = [...mdItems, ...interactive].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const empty = items.length === 0;
---

<Base title={c.label} documentTitle={c.documentTitle} description={c.desc} schemaPageType="toolkit" noindex={empty}>
  <header class="toolkit-hero wide-band">
    <h1>{c.label}</h1>
    <p class="toolkit-intro">{c.desc}</p>
    {empty && <p class="toolkit-empty">This collection is being put together. Check back soon.</p>}
  </header>

  {
    !empty && <ToolkitList items={items.map((e) => ({ ...e, icon: e.icon ?? "✦", cta: item.slug === "tools" ? "Open tool" : "Open template" }))} />
  }
</Base>

<style>
  .toolkit-hero { padding-block: 1rem 0.5rem; }
  .toolkit-hero h1 { margin: 0; }
  .toolkit-intro { margin: 0.75rem 0 0; max-width: 52ch; color: var(--muted); font-size: 1.05rem; }
  .toolkit-empty {
    color: var(--muted);
  }
</style>

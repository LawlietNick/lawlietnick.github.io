---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolHero from "../../components/ToolHero.astro";
import CookieBannerStyler from "../../components/CookieBannerStyler.astro";

const title = "Cookiebot banner styler";
const summary =
  "Pick colours and text alignment for a Cookiebot banner, preview it live, and copy ready-to-paste CSS, HTML and JavaScript for the custom template.";
---

<Base title={title} description={summary} alternate={{ lang: "fi", href: "/fi/tyokalut/cookiebot-bannerin-muotoilija/" }}>
  <Breadcrumb
    crumbs={[
      { label: "Home", href: "/", icon: true },
      { label: "Tools", href: "/tools/" },
      { label: title },
    ]}
  />

  <ToolHero title={title} summary={summary}>
    <p class="content-links">
      This tool is based on Generaxion’s{" "}
      <a href="https://github.com/generaxion/cookiebot-accessible-template">
       accessible Cookiebot template
      </a>.
    </p>
  </ToolHero>

  <div class="wide-band">
    <CookieBannerStyler />
  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolHero from "../../components/ToolHero.astro";
import MetricQualityChecker from "../../components/MetricQualityChecker.astro";

const title = "Metric quality checker";
const summary = "Run any metric through eight practical questions to see whether it is decorative, diagnostic, supporting or business-critical.";
---

<Base title={title} description={summary} alternate={{ lang: "fi", href: "/fi/tyokalut/mittarin-laatutarkistus/" }}>
  <Breadcrumb
    crumbs={[
      { label: "Home", href: "/", icon: true },
      { label: "Tools", href: "/tools/" },
      { label: title },
    ]}
  />

  <ToolHero title={title} summary={summary}>
    <p class="tool-note">A good metric earns attention by improving decisions, not merely by being easy to count.</p>
  </ToolHero>

  <div class="wide-band">
    <MetricQualityChecker />
  </div>
</Base>

---
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ToolHero from "../../../components/ToolHero.astro";
import PaymentReferralTool from "../../../components/PaymentReferralTool.astro";

const title = "Viittausten poissulkeminen";
const summary = "Asiakas maksaa maksupalvelussa ja palaa kauppaan, mutta GA4 kirjaa oston maksupalvelun nimiin. Valitse käyttämäsi palvelut ja kopioi niiden domainit GA4:n ei-toivottujen viittausten listalle.";
---

<Base primaryCategory="analytics" title={title} description={summary} alternate={{ lang: "en", href: "/tools/", translated: false }}>
  <Breadcrumb
    fi
    crumbs={[
      { label: "Etusivu", href: "/fi/", icon: true },
      { label: "Työkalut", href: "/fi/tyokalut/" },
      { label: title },
    ]}
  />

  <ToolHero title={title} summary={summary}>
    <p class="tool-note">
      Asiakas maksaa maksupalvelun sivulla ja palaa verkkokauppaan. GA4 voi nähdä paluun uutena tulolähteenä ja kirjata oston viittaukseksi (referral). Mainos tai hakukone, joka toi asiakkaan kauppaan, jää ilman kunniaa. Alla oleva lista kertoo GA4:lle, ettei maksupalvelu ole tulolähde.
    </p>
  </ToolHero>

  <div class="wide-band">
    <PaymentReferralTool />
  </div>
</Base>

---
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import ToolHero from "../../../components/ToolHero.astro";
import DataLayerDocumenter from "../../../components/datalayer-documenter/DataLayerDocumenter";

const title = "dataLayer-dokumentaatiogeneraattori";
const summary = "Valitse tarvittavat GA4-tapahtumat, muokkaa ohje suoraan valmiissa dokumentissa ja vie se Markdown- tai DOCX-tiedostona.";
---

<Base primaryCategory="analytics" title={title} description={summary} alternate={{ lang: "en", href: "/tools/" }}>
  <Breadcrumb
    fi
    crumbs={[
      { label: "Etusivu", href: "/fi/", icon: true },
      { label: "Työkalut", href: "/fi/tyokalut/" },
      { label: title },
    ]}
  />

  <ToolHero title={title} summary={summary}>
    <p class="tool-note">Muokkaat koko ajan juuri sitä sisältöä, jonka viet kehittäjälle.</p>
  </ToolHero>

  <div class="datalayer-tool-shell wide-band">
    <DataLayerDocumenter client:only="react" />
  </div>

  <section class="about datalayer-usage">
    <div>
      <p class="eyebrow">Ennen toimitusta</p>
      <h2>Tarkista toteutus verkkokaupan todellisesta toiminnasta</h2>
    </div>
    <div>
      <ol>
        <li>Valitse vain tapahtumat, joille löytyy selkeä käyttötapaus ja lähetyshetki.</li>
        <li>Korvaa esimerkkituotteet asiakkaan todellista tietomallia vastaavilla arvoilla.</li>
        <li>Sovi item_id:n lähde ja arvon laskenta ennen kehitystyön aloittamista.</li>
        <li>Testaa tapahtumat, päällekkäisten tapahtumien estäminen ja Consent Mode GTM:n esikatselutilassa.</li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .datalayer-tool-shell {
    margin-bottom: 2rem;
  }

  .datalayer-usage {
    padding-top: 3rem;
  }

  .datalayer-usage h2 {
    max-width: 15ch;
  }

  .datalayer-usage ol {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding-left: 1.25rem;
  }

</style>

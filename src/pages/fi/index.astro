---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import ButtonLink from "../../components/ButtonLink.astro";
import PostList from "../../components/PostList.astro";
import SplitSection from "../../components/SplitSection.astro";
import { selectRecentPosts } from "../../utils/recent-posts.ts";
import { showServices } from "../../data/site.js";

const withTrailingSlash = (path) => path.endsWith("/") ? path : `${path}/`;
const posts = selectRecentPosts(Object.values(import.meta.glob("./blog/*.md", { eager: true }))
  .map((p) => ({
    ...p.frontmatter,
    url: withTrailingSlash(p.url),
    minutes: Math.max(1, Math.round(p.rawContent().split(/\s+/).length / 200)),
  })));
---

<Base
  documentTitle="Niko Karppinen | SEO- ja analytiikkakonsultti"
  description="Niko Karppinen auttaa tiimejä parantamaan digitaalista mittaamista, hakukoneoptimointia, analytiikkaa ja käytännön AI-työnkulkuja."
  banner
>
  <Hero fi={true} />

  <SplitSection variant="about">
    <Fragment slot="title">
      <h2>Kun lukuihin ei voi luottaa, uusi dashboard ei auta.</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Useimmat seurannan ongelmat eivät johdu puuttuvasta raportista. Ne
        johtuvat epäselvistä tavoitteista, kirjavista toteutuksista tai siitä,
        ettei kukaan oikein omista kokonaisuutta.
      </p>
      <p>
        Selvitän, mikä seurannassa tai sivustossa on oikeasti vialla, ja korjaan
        asiat tärkeysjärjestyksessä. Lopputuloksena on seuranta, johon voi
        luottaa, ja raportit, joiden perusteella on helppo päättää seuraavista
        toimista.
      </p>
      <p>
        Sama koskee tekoälyä. Jos data ja prosessit ovat sekaisin, AI tekee
        samat virheet nopeammin. Siksi kannattaa aloittaa siitä, mitä mitataan,
        kuka omistaa datan ja missä kohdassa ihminen tekee päätöksen.
      </p>
      {showServices && (
        <p>
          <ButtonLink href="/fi/palvelut/" label="Katso palvelut" variant="secondary" />
        </p>
      )}
    </Fragment>
  </SplitSection>

  <PostList {posts} fi={true} title="Uusimmat kirjoitukset" allHref="/fi/blog/" allLabel="Kaikki kirjoitukset" />
</Base>

---
import Base from "../../layouts/Base.astro";
import SplitSection from "../../components/SplitSection.astro";
import AboutIntro from "../../components/AboutIntro.astro";
import Appearances from "../../components/Appearances.astro";
---

<Base title="Minusta" description="Niko Karppinen on SEO- ja analytiikkakonsultti, jonka työhön kuuluvat digitaalinen mittaaminen, seurannan toteutukset ja verkkosivustojen kehittäminen." schemaPageType="about">
  <AboutIntro fi={true} />

  <SplitSection id="approach" variant="about">
    <Fragment slot="title">
      <h2>Miten työskentelen</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Hyvän työn pitäisi helpottaa päätöksentekoa. Tämä ajatus ohjaa
        tekemistäni riippumatta siitä, onko kyse SEO:sta, analytiikasta,
        seurannasta tai sivuston rakenteesta.
      </p>
      <p>
        Yhdistän työssäni SEO:ta, analytiikkaa, sisältöä ja teknistä toteutusta.
        En tarkastele niitä erillisinä asioina, koska yhden alueen ratkaisut
        vaikuttavat usein myös muihin.
      </p>
      <p>
        En lähde aina suoraan ratkaisemaan annettua ongelmaa. Ennen ratkaisua
        varmistan, että ongelma on määritelty tarpeeksi tarkasti. Usein jo
        tarkempi määrittely muuttaa sitä, mitä kannattaa tehdä seuraavaksi.
      </p>
      <p>
        Kun asia tuntuu abstraktilta, teen siitä konkreettisen. Se voi
        tarkoittaa kaaviota, esimerkkiä, pientä testiä tai toimivaa
        prototyyppiä. Mieluummin testaan ajatuksen käytännössä kuin jätän
        jälkeeni suosituksen, jonka toimivuutta kukaan ei ole kokeillut.
      </p>
      <p>
        Tekoäly voi auttaa tekemään työtä nopeammin ja johdonmukaisemmin
        hyvin määritellyn prosessin mukaisesti. Se ei kuitenkaan korjaa
        epäselvää prosessia, huonoa lähtödataa tai sitä, ettei kukaan tiedä,
        mitä tavoitellaan.
      </p>
      <p>
        Automatisoin mielelläni rutiinityön, mutta päätökset jäävät ihmiselle.
        Rakennan työnkulkuihin kohdat, joissa joku tarkistaa tuloksen, ennen kuin
        se siirtyy eteenpäin.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="values" variant="about">
    <Fragment slot="title">
      <h2>Mistä välitän</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Välitän selkeydestä ja luottamuksesta. Mittaamisen pitäisi auttaa
        päättämään, mitä tehdään seuraavaksi. Jokaisella seurattavalla luvulla
        pitäisi olla käyttötarkoitus.
      </p>
      <p>
        Haluan, että työni perusteella ihmiset ymmärtävät, mitä on havaittu,
        mihin päätelmät perustuvat ja miten niiden pohjalta voi toimia.
        Työkalut voivat tuoda esiin ilmiöitä, mutta ihmiset arvioivat niiden
        merkityksen asiakkaalle, liiketoiminnalle ja brändille.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="background" variant="about">
    <Fragment slot="title">
      <h2>Kokemus ja näkökulma</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Olen työskennellyt SEO:n, analytiikan ja digimarkkinoinnin parissa
        vuodesta 2017. Kokemusta on kertynyt verkkokaupasta, televiestinnästä,
        vakuutusalalta, terveydenhuollosta, julkiselta sektorilta sekä
        B2B- ja kuluttajapalveluista.
      </p>
      <p>
        Työni on sisältänyt teknistä hakukoneoptimointia, analytiikan ja
        seurannan toteutuksia, mittaamisen suunnittelua, suostumusratkaisuja
        ja raportointia. Olen ollut mukana myös verkkosivustouudistuksissa
        ja suunnitellut sivustorakenteita hakukysynnän perusteella.
      </p>
      <p>
        Minua kiinnostaa, miten teknologia, sisältö, rakenne ja
        tarinankerronta toimivat yhdessä. Pidän siitä, miten yksittäisistä
        osista rakennetaan toimiva kokonaisuus ja miten rakenne vaikuttaa
        lopputulokseen. Sama kiinnostus seuraa mukana myös vapaa-ajalle.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="outside-work" variant="about">
    <Fragment slot="title">
      <h2>Vapaa-ajalla</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Vapaa-ajallani katson elokuvia ja animea sekä pelaan tarinavetoisia
        yksinpelejä. Alan Wake ja Metal Gear Solid kuuluvat suosikkeihini.
        Pidän hyvin rakennetuista tarinoista, vahvasta tunnelmasta ja vähän
        erikoisista maailmoista.
      </p>
      <p>
        Luen myös sarjakuvia, etenkin Batmania ja Teenage Mutant Ninja
        Turtlesia. Minua kiinnostavat omaperäiset ideat ja maailmat, jotka
        noudattavat johdonmukaisesti omia sääntöjään.
      </p>
      <p>
        Tanssin kuubalaista salsaa ja lockingia. Molemmissa nautin rytmistä,
        harjoittelusta ja improvisaatiosta. Tutustakin liikkeestä löydän
        usein jotain uutta harjoiteltavaa. Olen opetellut hyväksymään sen,
        etten vielä osaa kaikkea, ja nauttimaan harjoittelusta silti.
      </p>
    </Fragment>
  </SplitSection>

  <Appearances fi={true} />
</Base>
---
import Base from "../../layouts/Base.astro";
import SplitSection from "../../components/SplitSection.astro";
import AboutIntro from "../../components/AboutIntro.astro";
import Appearances from "../../components/Appearances.astro";
---

<Base title="Minusta" description="Niko Karppinen on SEO- ja analytiikkakonsultti, joka työskentelee digitaalisen mittaamisen, teknisten toteutusten ja käytännöllisten digitaalisten järjestelmien parissa." schemaPageType="about">
  <AboutIntro fi={true} />

  <SplitSection id="approach" variant="about">
    <Fragment slot="title">
      <h2>Miten lähestyn työtä</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Hyvien järjestelmien pitäisi tehdä seuraavasta päätöksestä helpompi.
        Palaan yleensä tähän ajatukseen, oli kyse mittaamisesta,
        sivustorakenteesta, seurannasta tai jostain niiden väliltä.
      </p>
      <p>
        Työni sijoittuu usein SEO:n, analytiikan, sisällön, seurannan ja teknisen
        toteutuksen väliin. Katson, miten nämä alueet liittyvät toisiinsa, sen
        sijaan että käsittelisin jokaista erillisenä ongelmana. Joskus se
        tarkoittaa myös itse ongelman kyseenalaistamista. Ratkaisemmeko oikeaa
        asiaa, vai olemmeko vain hyväksyneet alkuperäisen määrittelyn?
      </p>
      <p>
        Kun jokin tuntuu abstraktilta, yritän tehdä siitä konkreettisen. Se voi
        tarkoittaa esimerkkejä, vertauksia, kaavioita tai pientä toimivaa mallia.
        Rakennan mieluummin jotain testattavaa kuin jätän jälkeeni epämääräisen
        suosituksen, joka vain kuulostaa valmiilta.
      </p>
      <p>
        Tekoäly voi auttaa soveltamaan selkeää prosessia johdonmukaisemmin. Se ei
        korjaa huonoa lähdedataa, epäselvää omistajuutta tai prosessia, jota
        kukaan ei oikein ymmärrä.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="values" variant="about">
    <Fragment slot="title">
      <h2>Mistä välitän</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Välitän selkeydestä, luottamuksesta ja hyödyllisestä rakenteesta.
        Mittaamisen pitäisi tukea oikeita päätöksiä, ei tuottaa lisää
        ylläpidettäviä lukuja.
      </p>
      <p>
        Hyvän työn pitäisi antaa ihmisille riittävästi kontekstia arvioida, mikä
        on tärkeää, ja riittävästi rakennetta toimia sen pohjalta. Työkalut
        voivat tuoda esiin ilmiöitä, mutta ihmiset päättävät edelleen, mikä on
        tärkeää asiakkaalle, liiketoiminnalle ja brändille.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="background" variant="about">
    <Fragment slot="title">
      <h2>Tausta</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Olen työskennellyt SEO:n, analytiikan ja digimarkkinoinnin parissa
        vuodesta 2017. Sinä aikana olen työskennellyt verkkokaupan,
        televiestinnän, vakuutusalan, terveydenhuollon, julkisen sektorin,
        B2B-liiketoiminnan ja kuluttajapalveluiden parissa.
      </p>
      <p>
        Työni on kattanut teknisen SEO:n, analytiikan ja seurannan toteutuksia,
        suostumusratkaisuja, mittaussuunnittelua, dashboardeja,
        verkkosivustouudistuksia ja hakulähtöistä sivustorakenteen suunnittelua.
      </p>
      <p>
        Olen aina ollut kiinnostunut siitä, miten teknologia, sisältö, rakenne ja
        tarinankerronta toimivat yhdessä. Olen kirjoittanut myös
        lyhytelokuvakäsikirjoituksia. En ammatillisena meriittinä, vaan koska
        pidän siitä, miten ideat, rytmi ja viestintä toimivat yhdessä.
      </p>
    </Fragment>
  </SplitSection>

  <SplitSection id="outside-work" variant="about">
    <Fragment slot="title">
      <h2>Vapaa-ajalla</h2>
    </Fragment>
    <Fragment slot="copy">
      <p>
        Työn ulkopuolella vietän paljon aikaa elokuvien, animen ja
        tarinavetoisten yksinpelien parissa. Alan Wake ja Metal Gear Solid ovat
        erityisiä suosikkejani. Pidän yleensä tarinoista, joissa on vahva
        rakenne, tunnelma ja hieman erikoisia maailmoja.
      </p>
      <p>
        Sarjakuvat ovat toinen vakio, etenkin Batman ja Teenage Mutant Ninja
        Turtles. Minulla on heikko kohta vahvoille konsepteille ja maailmoille,
        jotka ottavat oman sisäisen logiikkansa tosissaan.
      </p>
      <p>
        Tanssin myös kuubalaista salsaa ja lockingia. Molemmissa yhdistyvät
        rakenne, rytmi, harjoittelu ja improvisaatio. Ne ovat myös varsin
        tehokkaita paljastamaan väärään paikkaan osuneen itsevarmuuden.
      </p>
    </Fragment>
  </SplitSection>

  <Appearances fi={true} />
</Base>
---
// Short author bio after the article body, before the article telemetry.
// Facts mirror the about pages; update both when the profile changes.
import { Picture } from "astro:assets";
import portrait from "../assets/about/portrait.jpeg";
import { authorName, siteConfig, contactUrl } from "../data/site.js";

const { fi = false, aboutHref } = Astro.props;
const host = new URL(Astro.site ?? siteConfig.url).host;
const preferredSourceHref = `https://www.google.com/preferences/source?q=${host}`;
const c = fi
  ? {
      label: "Kirjoittajasta",
      bio: "Olen työskennellyt SEO:n, analytiikan ja digimarkkinoinnin parissa vuodesta 2017. Autan tiimejä korjaamaan seurantaa, ymmärtämään dataansa ja parantamaan verkkosivustojaan.",
      about: "Lisää minusta",
      preferred: "Suosi Googlessa",
      preferredLabel: "Lisää Karppinen.one ensisijaiseksi lähteeksi Google-haussa",
    }
  : {
      label: "About the author",
      bio: "I have worked in SEO, analytics and digital marketing since 2017. I help teams fix their tracking, understand their data and improve their websites.",
      about: "More about me",
      preferred: "Prefer on Google",
      preferredLabel: "Add Karppinen.one as a preferred source in Google Search",
    };
---

<aside class="author-bio" aria-label={c.label}>
  <Picture class="author-bio__photo" src={portrait} alt="" widths={[160, 320]} sizes="(max-width: 640px) 4.5rem, 9rem" formats={["avif", "webp"]} loading="lazy" />
  <div class="author-bio__body">
    <p class="author-bio__name">
      <a href={aboutHref} rel="author">{authorName}</a>
      <span class="author-bio__role">{siteConfig.person.jobTitle}</span>
    </p>
    <p class="author-bio__text">{c.bio}</p>
    <p class="author-bio__links">
      <a href={aboutHref}>
        <span class="content-link">{c.about}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
      </a>
      <a href={contactUrl} rel="me noopener">
        <span class="content-link">LinkedIn</span>
      </a>
      <a href={preferredSourceHref} target="_blank" rel="noopener noreferrer" aria-label={`${c.preferred}: ${c.preferredLabel}`} data-link-area="end-of-article" data-link-type="preferred-source" data-link-level="secondary">
        <span class="content-link">{c.preferred}</span>
      </a>
    </p>
  </div>
</aside>

<style>
  .author-bio {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem 1.75rem;
    align-items: start;
    margin: 3rem 0 0;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .author-bio :global(.author-bio__photo) {
    grid-column: 1;
    grid-row: 1 / 3;
    display: block;
    width: 9rem;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    object-fit: cover;
    transform: rotate(-2deg);
  }
  .author-bio p { margin: 0; }
  .author-bio__body { display: contents; }
  .author-bio__name {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }
  .author-bio__name a {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--font-weight-strong);
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-decoration: none;
    text-underline-offset: 0.15em;
  }
  .author-bio__name a:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .author-bio a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
    border-radius: var(--radius-xs);
  }
  .author-bio__role {
    display: block;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: var(--font-size-ui-sm);
    line-height: var(--line-height-ui);
  }
  .author-bio__text {
    grid-column: 2;
    grid-row: 2;
    max-width: 70ch;
    font-size: 1rem;
    line-height: var(--line-height-body);
  }
  .author-bio__links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: var(--font-size-ui-sm);
  }
  .author-bio__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    color: var(--accent);
    text-decoration: none;
  }
  .author-bio__links svg { flex-shrink: 0; }
  .author-bio__links :global(.external-link-icon) { margin-inline-start: 0; }

  @media (max-width: 40rem) {
    .author-bio {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 1.5rem 1rem;
      padding: 1.25rem;
    }
    .author-bio :global(.author-bio__photo) {
      grid-row: 1;
      width: 4.5rem;
    }
    .author-bio__name { align-self: center; }
    .author-bio__name a { font-size: 1.5rem; }
    .author-bio__role { margin-top: 0.4rem; }
    .author-bio__text { grid-column: 1 / -1; }
    .author-bio__links { padding-top: 0.5rem; }
  }
  @media print { .author-bio { display: none; } }
</style>

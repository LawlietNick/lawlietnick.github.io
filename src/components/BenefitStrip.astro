---
interface Props {
  texts: [string, string, string];
}

const { texts } = Astro.props;
---

<ul class="benefit-strip" role="list">
  {texts.map((text) => <li>{text}</li>)}
</ul>

<style>
  .benefit-strip {
    display: grid;
    list-style: none;
    margin: 0 0 var(--section-y);
    padding: 0;
    border-block: 1px solid var(--line);
    color: var(--ink);
  }

  .benefit-strip > li {
    margin: 0;
    padding-block: var(--split-gap);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.7cqi, 2.5rem);
    font-weight: var(--font-weight-body);
    line-height: 1.2;
    text-align: start;
    text-wrap: balance;
    hyphens: auto;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .benefit-strip > li + li {
    border-top: 1px solid var(--line);
  }

  @container page (min-width: 58rem) {
    .benefit-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .benefit-strip > li {
      padding-block: var(--section-y);
      padding-inline: var(--split-gap);
    }

    .benefit-strip > li:first-child {
      padding-inline-start: 0;
    }

    .benefit-strip > li:last-child {
      padding-inline-end: 0;
    }

    .benefit-strip > li + li {
      border-top: 0;
      border-inline-start: 1px solid var(--line);
    }
  }
</style>

---
import Badge from "./Badge.astro";
import { appearances } from "../data/appearances.js";

const { fi = false } = Astro.props;
const language = fi ? "fi" : "en";
const t = fi
  ? {
      title: "Esiintymiset ja julkaisut",
      intro: "Jaan ajatuksia artikkelien, koulutusten, webinaarien ja podcastien kautta, erityisesti SEO:sta, analytiikasta, mittaamisesta ja tekoälyn käytännön hyödyntämisestä digityössä.",
      listen: "Kuuntele",
    }
  : {
      title: "Talks, podcasts, publications",
      intro: "I share ideas through articles, training, webinars and podcasts, especially around SEO, analytics, measurement and the practical use of AI in digital work.",
      listen: "Listen on",
    };
const dateFormat = new Intl.DateTimeFormat(fi ? "fi-FI" : "en-GB", {
  day: "numeric",
  month: fi ? "numeric" : "long",
  year: "numeric",
  timeZone: "UTC",
});
const languageNames = new Intl.DisplayNames([language], { type: "language" });
---

<section class="appearances" id="proof" aria-labelledby="appearances-title">
  <header class="appearances__intro">
    <h2 id="appearances-title">{t.title}</h2>
    <p>{t.intro}</p>
  </header>

  <div class="appearances__list">
    {appearances.map((appearance) => {
      // Only mark the language where it differs from the page; the page's own lang covers the rest
      const otherLang = appearance.inLanguage === language ? undefined : appearance.inLanguage;
      return (
        <article class="appearance">
          <div class="appearance__meta">
            <time datetime={appearance.datePublished}>{dateFormat.format(new Date(appearance.datePublished))}</time>
            <Badge class="appearance__type">Podcast</Badge>
            <span class="appearance__language">{languageNames.of(appearance.inLanguage)}</span>
          </div>
          <div class="appearance__body">
            <h3 lang={otherLang}>{appearance.name}</h3>
            <p>{appearance[language].description}</p>
            <div class="appearance__platforms">
              <span class="appearance__listen">{t.listen}</span>
              <ul>
                {[{ name: appearance.platform, url: appearance.url }, ...(appearance.alsoOn ?? [])].map((link) => (
                  <li>
                    <a href={link.url} hreflang={otherLang}>
                      {link.name}<span class="visually-hidden">: <span lang={otherLang}>{appearance.name}</span></span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .appearances {
    display: grid;
    gap: 2.5rem;
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }
  .appearances__intro h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.8rem, 4.5cqi, 2.7rem);
  }
  .appearances__intro p {
    max-width: 36rem;
    margin: 0;
  }
  .appearances__list { border-top: 1px solid var(--line); }
  .appearance {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .appearance__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: var(--font-size-ui-xs);
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .appearance__language {
    color: var(--muted);
    font-weight: var(--font-weight-body);
    letter-spacing: normal;
    text-transform: none;
  }
  .appearance__body h3 {
    margin: 0;
    font-size: clamp(1.25rem, 3cqi, 1.55rem);
  }
  .appearance__body p {
    max-width: 58ch;
    margin: 0.5rem 0 0.9rem;
    color: var(--muted);
  }
  .appearance__platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
  }
  .appearance__listen {
    color: var(--muted);
    font-size: var(--font-size-ui-xs);
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .appearance__platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .appearance__platforms a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: var(--font-size-ui-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }
  .appearance__platforms a:is(:hover, :focus-visible) {
    border-color: var(--accent);
    color: var(--accent);
    background-color: color-mix(in oklab, var(--accent) 8%, var(--bg));
  }
  .appearance__platforms a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  @container page (min-width: 46rem) {
    .appearances {
      grid-template-columns: 1fr 1.2fr;
      gap: 4.5rem;
    }
  }
</style>

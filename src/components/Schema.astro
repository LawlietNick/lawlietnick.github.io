---
import portrait from "../assets/about/portrait.jpeg";
import { getImage } from "astro:assets";
import { buildSchemaGraph } from "../utils/schema";
import { authorName } from "../data/site.js";

const {
  fm,
  fi = false,
  title,
  description,
  pageType,
  items = [],
  stats,
  service,
  hasTranslation,
  translatedPath,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const generatedPortrait = await getImage({ src: portrait, format: "webp" });
const personImage = Astro.site ? {
  src: new URL(generatedPortrait.src, Astro.site).href,
  width: generatedPortrait.attributes.width,
  height: generatedPortrait.attributes.height,
  alt: authorName,
} : undefined;
const pageImage = Astro.url.pathname === "/" || Astro.url.pathname === "/fi/" || pageType === "about"
  ? personImage
  : undefined;

const schema = canonicalUrl
  ? buildSchemaGraph({
      canonicalUrl,
      pathname: Astro.url.pathname,
      title,
      description,
      language: fi ? "fi" : "en",
      pageType,
      frontmatter: fm,
      items,
      stats,
      service,
      personImage,
      pageImage,
      hasTranslation,
      translatedPath,
    })
  : undefined;
const serializedSchema = schema
  ? JSON.stringify(schema).replace(/</g, "\\u003c")
  : undefined;
---

{serializedSchema && <script type="application/ld+json" set:html={serializedSchema} />}

---
// Mobile language list inside the burger menu, modelled on kela.fi: a labelled
// group of full-width rows with each language named in its own language, and
// the current one marked with aria-current. When the page has no translation
// the other language leads to a homepage or a listing instead, so it moves
// under its own "not translated" heading instead of hiding that in
// screen-reader text.
// Each link carries `lang` (how to pronounce it) as well as `hreflang` (what it
// points at) — without `lang` a screen reader says "Suomi" in an English voice.
const {
  fi = false,
  enLanguageHref,
  fiLanguageHref,
  postWithoutTranslation = false,
  class: className = "",
} = Astro.props;

const current = fi
  ? { name: "Suomi", lang: "fi", href: fiLanguageHref }
  : { name: "English", lang: "en", href: enLanguageHref };
const other = fi
  ? { name: "English", lang: "en", href: enLanguageHref, home: "Homepage" }
  : { name: "Suomi", lang: "fi", href: fiLanguageHref, home: "Etusivu" };

const groups = postWithoutTranslation
  ? [
      { id: "mobile-language-current", heading: fi ? "Nykyinen kieli" : "Current language", items: [current] },
      { id: "mobile-language-other", heading: fi ? "Sivua ei ole käännetty" : "This page is not translated", items: [other] },
    ]
  : [
      { id: "mobile-language-change", heading: fi ? "Vaihda sivun kieli" : "Change the page language", items: [current, other] },
    ];
---

<nav class:list={["locale-list", className]} aria-label={fi ? "Kielivalinta" : "Language selection"}>
  {groups.map((group) => (
    <div class="locale-list__group">
      <p class="locale-list__heading" id={group.id}>{group.heading}</p>
      <ul role="list" aria-labelledby={group.id}>
        {group.items.map((item) => {
          const isCurrent = item === current;
          return (
            <li>
              <a
                class="locale-list__link"
                href={item.href}
                lang={item.lang}
                hreflang={item.lang}
                rel={postWithoutTranslation ? undefined : "alternate"}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.name}
                {!isCurrent && postWithoutTranslation && (item.href === "/" || item.href === "/fi/") && ` – ${item.home}`}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .locale-list {
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }
  .locale-list__heading {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: var(--font-size-ui-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .locale-list ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* full-width rows, 48px tall: a comfortable thumb target (WCAG 2.5.8) */
  .locale-list__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 1rem;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .locale-list__link:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .locale-list__link[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-weight: 700;
  }
  .locale-list__link[aria-current="page"]::after {
    content: "✓";
    margin-left: auto;
    color: var(--accent);
  }
  .locale-list__link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
</style>

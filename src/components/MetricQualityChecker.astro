---
import { showServices } from "../data/site.js";

const { fi = false } = Astro.props;

const copy = fi
  ? {
      metricLabel: "Arvioitava mittari",
      metricPlaceholder: "Esim. asiakashankinnan kustannus",
      metricHelp: "Valinnainen. Nimi näkyy tuloksessa, kopioidussa yhteenvedossa ja jaetussa linkissä. Nimi ei vaikuta pisteisiin.",
      instructions: "Vastaa jokaiseen kysymykseen kyllä tai ei.",
      score: "Tulos",
      yes: "kyllä",
      yesAnswer: "Kyllä",
      noAnswer: "Ei",
      reset: "Tyhjennä vastaukset",
      caveat: "Pistemäärä jäsentää keskustelua. Lopullinen arvio vaatii aina liiketoimintakontekstin.",
      ranges: ["0–3 kyllä", "4–5 kyllä", "6–7 kyllä", "8–10 kyllä"],
      answeredLabel: "vastattu",
      pending: "Vastaa kaikkiin kymmeneen kysymykseen, niin näet arvion.",
      areaTitle: "Osa-alueittain",
      gapsTitle: "Korjattavaa",
      noGaps: "Ei puutteita – kaikki tarkistukset läpäisty.",
      cappedNote: "Luokitus on rajattu diagnostiseksi: mittari ei kytkeydy liiketoiminnan keskeisiin tuloksiin.",
      copySummary: "Kopioi yhteenveto",
      copyLink: "Kopioi linkki",
      copied: "Kopioitu ✓",
      unnamed: "(nimeämätön mittari)",
      sumHeading: "Mittarin laatutarkistus",
      sumRec: "Suositus",
      sumTool: "Arvioitu työkalulla",
    }
  : {
      metricLabel: "Metric to assess",
      metricPlaceholder: "For example, customer acquisition cost",
      metricHelp: "Optional. Used to label your result, copied summary, and shared link. It does not affect the score.",
      instructions: "Answer every question with Yes or No.",
      score: "Score",
      yes: "yes",
      yesAnswer: "Yes",
      noAnswer: "No",
      reset: "Clear answers",
      caveat: "The score structures the discussion. Final judgment still depends on business context.",
      ranges: ["0–3 yes", "4–5 yes", "6–7 yes", "8–10 yes"],
      answeredLabel: "answered",
      pending: "Answer all ten questions to see the verdict.",
      areaTitle: "By area",
      gapsTitle: "Gaps to close",
      noGaps: "No gaps — every check passed.",
      cappedNote: "Capped: without a link to business outcomes, a metric is diagnostic at best.",
      copySummary: "Copy summary",
      copyLink: "Copy link",
      copied: "Copied ✓",
      unnamed: "(unnamed metric)",
      sumHeading: "Metric quality check",
      sumRec: "Recommendation",
      sumTool: "Assessed with",
    };

const tiers = fi
  ? [
      {
        key: "A",
        tier: "Taso A",
        title: "Yhteys liiketoimintaan",
        questions: [
          { q: "Kytkeytyykö mittari liiketoiminnan keskeisiin tuloksiin?", hint: "Liikevaihto, tulos, asiakaspito tai asiakasarvo", gap: "Ei kytkeydy liiketoiminnan keskeisiin tuloksiin" },
          { q: "Ohjaako mittari toimintaa tai liittyykö se selvästi tulokseen vaikuttaviin tekijöihin?", hint: "Suora toimenpide tai selkeä ajuripuu", gap: "Ei ohjaa toimintaa eikä liity selvästi tulokseen vaikuttaviin tekijöihin" },
        ],
      },
      {
        key: "B",
        tier: "Taso B",
        title: "Päätökset ja vaikutus",
        questions: [
          { q: "Vaikuttaako mittarin arvon muuttuminen päätöksiin?", gap: "Arvon muuttuminen ei vaikuta päätöksentekoon" },
          { q: "Mittaako se tehokkuutta, ei vain määrää?", hint: "Ei kertyvä kokonaismäärä, joka voi vain kasvaa", gap: "Mittaa määrää, ei tehokkuutta" },
          { q: "Onko mittarin rinnalla laatu- tai vastamittari?", hint: "Esim. liikevaihto ja kate tai liidit ja niiden konversio kaupoiksi", gap: "Rinnalla ei ole laatu- tai vastamittaria" },
        ],
      },
      {
        key: "C",
        tier: "Taso C",
        title: "Mittarin luotettavuus",
        questions: [
          { q: "Onko määritelmä selkeä ja johdonmukainen?", hint: "Kaikki tulkitsevat sen samalla tavalla", gap: "Määritelmä ei ole selkeä tai johdonmukainen" },
          { q: "Onko mittari käyttökelpoinen eri segmenteissä?", hint: "Ei vain yhdessä asiakasryhmässä tai kanavassa", gap: "Ei ole käyttökelpoinen eri segmenteissä" },
          { q: "Säilyykö mittari käyttökelpoisena ajan myötä?", hint: "Ei vain yhtenä ajankohtana", gap: "Ei säily käyttökelpoisena ajan myötä" },
          { q: "Voiko mittarin arvoja vertailla?", hint: "Aiemmat jaksot, kohortit tai verrokit", gap: "Ei ole vertailtavissa" },
          { q: "Onko mittaria vaikea paisuttaa?", hint: "Arvoa ei voi nostaa nopeasti esimerkiksi ostamalla mainosnäyttöjä", gap: "Arvoa on helppo paisuttaa" },
        ],
      },
    ]
  : [
      {
        key: "A",
        tier: "Tier A",
        title: "Business relevance",
        questions: [
          { q: "Does it link to core outcomes?", hint: "Revenue, profit, retention or customer value", gap: "Not linked to core outcomes" },
          { q: "Is it actionable or tied to drivers?", hint: "Direct action or a clear driver tree", gap: "Not actionable or tied to drivers" },
        ],
      },
      {
        key: "B",
        tier: "Tier B",
        title: "Decisions and impact",
        questions: [
          { q: "Would it change decisions if it moved?", gap: "Would not change any decision" },
          { q: "Does it measure efficiency, not just volume?", hint: "Not an all-time total that can only go up", gap: "Measures volume, not efficiency" },
          { q: "Is it paired with a quality or counter metric?", hint: "Revenue with margin, leads with lead-to-deal conversion", gap: "Stands alone without a quality or counter metric" },
        ],
      },
      {
        key: "C",
        tier: "Tier C",
        title: "Reliability checks",
        questions: [
          { q: "Is its definition clear and consistent?", hint: "Everyone reads it the same way", gap: "Definition isn't clear or consistent" },
          { q: "Does it hold across segments?", hint: "Not just in one slice", gap: "Doesn't hold across segments" },
          { q: "Does it stay valid over time?", hint: "Not only in a snapshot", gap: "Doesn't stay valid over time" },
          { q: "Can it be benchmarked or compared?", hint: "Past periods, cohorts or peers", gap: "Can't be benchmarked or compared" },
          { q: "Is it hard to inflate?", hint: "It can't be quickly bought up, as with ad impressions", gap: "Easy to inflate" },
        ],
      },
    ];

const results = fi
  ? [
      { band: "vanity", label: "Koreilumittari", description: "Poista mittari tai muotoile se uudelleen niin, että yhteys päätöksiin tai tuloksiin selkeytyy." },
      { band: "diagnostic", label: "Diagnostinen mittari", description: "Mittari voi auttaa selittämään muutosta, mutta liiketoimintaa ei kannata johtaa pelkästään sen perusteella." },
      { band: "supporting", label: "Päätöksentekoa tukeva mittari", description: "Mittari sopii ajureiden seurantaan ja päätösten tueksi. Yhdistä se liiketoiminnan ydintulokseen." },
      { band: "critical", label: "Liiketoimintakriittinen mittari", description: "Mittari on riittävän vahva tiiviiseen seurantaan, koska se yhdistää päätökset kestäviin tuloksiin." },
    ]
  : [
      { band: "vanity", label: "Vanity or decorative metric", description: "Remove it, or reframe it so the connection to decisions or outcomes becomes clear." },
      { band: "diagnostic", label: "Diagnostic metric", description: "It can help explain what changed, but the business should not be managed to it on its own." },
      { band: "supporting", label: "Supporting metric", description: "Use it to monitor drivers and support decisions. Pair it with a core business outcome." },
      { band: "critical", label: "Business-critical metric", description: "It is strong enough to manage closely because it connects decisions to durable outcomes." },
    ];

const cta = fi
  ? {
      eyebrow: "Seuraava askel",
      text: "Jos mittarit eivät ohjaa päätöksiä, mittaaminen on usein suunniteltu puutteellisesti. Tilanne on korjattavissa.",
      label: "Keskustele seurantasuunnitelmasta",
      href: showServices ? "/fi/palvelut/seurannan-toteutussuunnitelma/" : "/fi/minusta/",
    }
  : {
      eyebrow: "Next step",
      text: "Metrics that don't change decisions usually trace back to a measurement setup that was never planned. That is fixable.",
      label: "Discuss a tracking plan",
      href: showServices ? "/services/tracking-implementation-plan/" : "/about/",
    };

const toolUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const questionMeta = tiers.flatMap((t) => t.questions.map((q) => ({ tier: t.key, gap: q.gap })));
const tierMeta = tiers.map((t) => ({ key: t.key, title: t.title, total: t.questions.length }));
const config = { results, questions: questionMeta, tiers: tierMeta, copy, cta, toolUrl };
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");

let questionNumber = 0;
---

<section class="metric-checker" data-metric-checker>
  <script type="application/json" data-metric-config set:html={configJson} />
  <div class="metric-checker__layout">
    <aside class="metric-checker__score" data-band="neutral" data-state="empty">
      <div class="metric-checker__score-head">
        <div>
          <p class="label">{copy.score}</p>
          <p class="metric-checker__metricname" data-metric-name hidden></p>
          <p class="metric-checker__progress" data-progress></p>
        </div>
        <output class="metric-checker__number" aria-live="polite">
          <strong data-score>0</strong><span>/10 {copy.yes}</span>
        </output>
      </div>

      <div class="metric-checker__result" role="status" aria-live="polite" aria-atomic="true">
        <p class="metric-checker__pending" data-pending>{copy.pending}</p>
        <div class="metric-checker__verdict" data-verdict hidden>
          <h2 data-result-label></h2>
          <p data-result-description></p>
          <p class="metric-checker__capped" data-capped hidden></p>
        </div>
      </div>

      <ul class="metric-checker__tierscores" data-tierscores hidden></ul>

      <div class="metric-checker__gaps" data-gaps hidden>
        <p class="label">{copy.gapsTitle}</p>
        <ul data-gaps-list></ul>
      </div>

      <a class="metric-checker__cta" data-cta hidden href={cta.href}>
        <span class="metric-checker__cta-eyebrow">{cta.eyebrow}</span>
        <span class="metric-checker__cta-text" data-cta-text></span>
        <span class="metric-checker__cta-label" data-cta-label></span>
      </a>

      <div class="metric-checker__actions" data-actions hidden>
        <button type="button" data-copy-summary>{copy.copySummary}</button>
        <button type="button" data-copy-link>{copy.copyLink}</button>
      </div>

      <div class="metric-checker__scale" aria-hidden="true">
        <div class="metric-checker__segments">
          {Array.from({ length: 10 }, (_, index) => <span data-segment={index + 1}></span>)}
        </div>
        <div class="metric-checker__ranges">
          {copy.ranges.map((range) => <span>{range}</span>)}
        </div>
      </div>

      <p class="metric-checker__caveat">{copy.caveat}</p>
    </aside>

    <form class="metric-checker__form" aria-describedby="metric-checker-instructions">
      <div class="metric-checker__metric">
        <label for="metric-name">{copy.metricLabel}</label>
        <input id="metric-name" name="metric" type="text" placeholder={copy.metricPlaceholder} autocomplete="off" aria-describedby="metric-name-help" />
        <p id="metric-name-help">{copy.metricHelp}</p>
        <p id="metric-checker-instructions">{copy.instructions}</p>
      </div>

      <div class="metric-checker__tiers">
        {
          tiers.map((tier) => (
            <fieldset>
              <legend>
                <span>{tier.tier}</span>
                <strong>{tier.title}</strong>
              </legend>
              <div class="metric-checker__questions">
                {tier.questions.map(({ q, hint }) => {
                  questionNumber += 1;
                  const id = `metric-question-${questionNumber}`;
                  return (
                    <div class="metric-checker__question">
                      <div id={id} class="metric-checker__question-copy">
                        <strong><span class="metric-checker__question-number" aria-hidden="true">{questionNumber}.</span> {q}</strong>
                        {hint && <small>{hint}</small>}
                      </div>
                      <div class="metric-checker__toggle" role="radiogroup" aria-labelledby={id}>
                        <label>
                          <input data-answer type="radio" name={`answer-${questionNumber}`} value="no" />
                          <span>{copy.noAnswer}</span>
                        </label>
                        <label>
                          <input data-answer type="radio" name={`answer-${questionNumber}`} value="yes" />
                          <span>{copy.yesAnswer}</span>
                        </label>
                      </div>
                    </div>
                  );
                })}
              </div>
            </fieldset>
          ))
        }
      </div>

      <button type="reset">{copy.reset}</button>
    </form>
  </div>
</section>

<script>
  import { metricBandIndex, gatedBandIndex } from "../utils/metric-quality.js";

  document.querySelectorAll("[data-metric-checker]").forEach((checker) => {
    const cfg = JSON.parse(checker.querySelector("[data-metric-config]").textContent);
    const { results, questions, tiers, copy, cta, toolUrl } = cfg;
    const form = checker.querySelector("form");
    const metricInput = checker.querySelector("#metric-name");
    const panel = checker.querySelector(".metric-checker__score");
    const el = (sel) => checker.querySelector(sel);
    const scoreEl = el("[data-score]");
    const progressEl = el("[data-progress]");
    const pendingEl = el("[data-pending]");
    const verdictEl = el("[data-verdict]");
    const nameEl = el("[data-metric-name]");
    const labelEl = el("[data-result-label]");
    const descEl = el("[data-result-description]");
    const cappedEl = el("[data-capped]");
    const tierScoresEl = el("[data-tierscores]");
    const gapsEl = el("[data-gaps]");
    const gapsListEl = el("[data-gaps-list]");
    const ctaEl = el("[data-cta]");
    const ctaTextEl = el("[data-cta-text]");
    const ctaLabelEl = el("[data-cta-label]");
    const actionsEl = el("[data-actions]");
    const segments = checker.querySelectorAll("[data-segment]");

    const readAnswers = () =>
      questions.map((_, i) => {
        const input = form.querySelector(`input[name="answer-${i + 1}"]:checked`);
        return input ? input.value : null;
      });

    const assess = () => {
      const answers = readAnswers();
      const answered = answers.filter((a) => a !== null).length;
      const yes = answers.filter((a) => a === "yes").length;
      const complete = answered === questions.length;
      const tierYes = {};
      tiers.forEach((t) => (tierYes[t.key] = 0));
      answers.forEach((a, i) => { if (a === "yes") tierYes[questions[i].tier] += 1; });
      const relevanceYes = tierYes.A ?? 0;
      const bandIndex = complete ? gatedBandIndex(yes, relevanceYes) : metricBandIndex(yes);
      const band = results[bandIndex];
      const capped = complete && relevanceYes === 0 && metricBandIndex(yes) > 1;
      const gaps = answers.map((a, i) => (a === "no" ? questions[i].gap : null)).filter(Boolean);
      const name = metricInput.value.trim();

      return { answers, answered, yes, complete, tierYes, bandIndex, band, capped, gaps, name };
    };

    const render = () => {
      const s = assess();
      scoreEl.textContent = s.yes;

      panel.dataset.state = s.complete ? "complete" : s.answered ? "progress" : "empty";
      panel.dataset.band = s.complete ? s.band.band : "neutral";
      segments.forEach((seg, i) => seg.classList.toggle("is-filled", i < s.yes));

      progressEl.textContent = s.complete ? "" : `${s.answered} / ${questions.length} ${copy.answeredLabel}`;
      nameEl.hidden = !s.name;
      nameEl.textContent = s.name;

      pendingEl.hidden = s.complete;
      verdictEl.hidden = !s.complete;
      tierScoresEl.hidden = !s.complete;
      gapsEl.hidden = !s.complete;
      actionsEl.hidden = !s.complete;
      ctaEl.hidden = !(s.complete && s.bandIndex <= 1);

      if (!s.complete) return;

      labelEl.textContent = s.band.label;
      descEl.textContent = s.band.description;
      cappedEl.hidden = !s.capped;
      cappedEl.textContent = s.capped ? copy.cappedNote : "";

      tierScoresEl.innerHTML = "";
      tiers.forEach((t) => {
        const li = document.createElement("li");
        li.className = "mqc-row";
        const name = document.createElement("span");
        name.textContent = t.title;
        const val = document.createElement("strong");
        val.textContent = `${s.tierYes[t.key]}/${t.total}`;
        li.append(name, val);
        tierScoresEl.append(li);
      });

      gapsListEl.innerHTML = "";
      if (s.gaps.length) {
        s.gaps.forEach((gap) => {
          const li = document.createElement("li");
          li.className = "mqc-gap";
          li.textContent = gap;
          gapsListEl.append(li);
        });
      } else {
        const li = document.createElement("li");
        li.className = "mqc-gap is-ok";
        li.textContent = copy.noGaps;
        gapsListEl.append(li);
      }

      ctaTextEl.textContent = cta.text;
      ctaLabelEl.textContent = cta.label;
    };

    const buildSummary = () => {
      const s = assess();
      const lines = [
        `${copy.sumHeading}: ${s.name || copy.unnamed}`,
        `${copy.score}: ${s.yes}/${questions.length} — ${s.band.label}`,
        tiers.map((t) => `${t.title} ${s.tierYes[t.key]}/${t.total}`).join(" · "),
      ];
      if (s.gaps.length) { lines.push(`${copy.gapsTitle}:`); s.gaps.forEach((g) => lines.push(`- ${g}`)); }
      lines.push(`${copy.sumRec}: ${s.band.description}`);
      if (s.capped) lines.push(copy.cappedNote);
      lines.push(`${copy.sumTool}: ${toolUrl}`);
      return lines.join("\n");
    };

    const buildLink = () => {
      const answers = readAnswers();
      const code = answers.map((a) => (a === "yes" ? "y" : a === "no" ? "n" : "-")).join("");
      const url = new URL(location.href);
      url.search = "";
      if (metricInput.value.trim()) url.searchParams.set("m", metricInput.value.trim());
      url.searchParams.set("a", code);
      return url.href;
    };

    const flash = (btn, done) => {
      const original = btn.textContent;
      btn.textContent = copy.copied;
      setTimeout(() => (btn.textContent = original), 1500);
      done && done();
    };

    // restore from a shared link
    const params = new URLSearchParams(location.search);
    if (params.get("m")) metricInput.value = params.get("m");
    const code = params.get("a");
    if (code) {
      [...code].slice(0, questions.length).forEach((ch, i) => {
        const value = ch === "y" ? "yes" : ch === "n" ? "no" : null;
        if (value) {
          const input = form.querySelector(`input[name="answer-${i + 1}"][value="${value}"]`);
          if (input) input.checked = true;
        }
      });
    }

    form.addEventListener("input", render);
    form.addEventListener("reset", () => {
      requestAnimationFrame(() => {
        history.replaceState(null, "", location.pathname);
        render();
      });
    });
    el("[data-copy-summary]").addEventListener("click", (e) =>
      flash(e.currentTarget, () => navigator.clipboard.writeText(buildSummary())),
    );
    el("[data-copy-link]").addEventListener("click", (e) => {
      const link = buildLink();
      history.replaceState(null, "", link);
      flash(e.currentTarget, () => navigator.clipboard.writeText(link));
    });

    render();
  });
</script>

<style>
  /* elements toggled with [hidden] also set display in CSS, so hidden must win */
  .metric-checker [hidden] { display: none !important; }

  .metric-checker {
    --score-neutral: light-dark(oklch(66% 0.03 286), oklch(58% 0.03 286));
    --score-vanity: light-dark(oklch(62% 0.2 25), oklch(72% 0.16 25));
    --score-diagnostic: light-dark(oklch(78% 0.16 87), oklch(82% 0.14 87));
    --score-supporting: light-dark(oklch(70% 0.1 182), oklch(76% 0.1 182));
    --score-critical: light-dark(oklch(55% 0.14 164), oklch(71% 0.12 164));
    margin-block: 1rem var(--section-y-large);
    padding-block: 1rem;
    font-size: var(--font-size-ui);
    line-height: var(--line-height-ui);
  }

  .metric-checker__layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .metric-checker__score {
    --score-color: var(--score-neutral);
    padding: clamp(1.25rem, 4cqi, 2rem);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--bg);
    transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
  }

  .metric-checker__score[data-band="vanity"] { --score-color: var(--score-vanity); }
  .metric-checker__score[data-band="diagnostic"] { --score-color: var(--score-diagnostic); }
  .metric-checker__score[data-band="supporting"] { --score-color: var(--score-supporting); }
  .metric-checker__score[data-band="critical"] { --score-color: var(--score-critical); }

  .metric-checker__score-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--score-color) 35%, var(--line));
  }

  .metric-checker__score-head > div { min-width: 0; }

  .metric-checker__score-head p,
  .metric-checker__number,
  .metric-checker__result p,
  .metric-checker__caveat {
    margin: 0;
  }

  .metric-checker__progress {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: var(--font-weight-medium);
  }
  .metric-checker__score[data-state="complete"] .metric-checker__progress { display: none; }

  .metric-checker__number {
    display: flex;
    gap: 0.25rem;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }

  .metric-checker__number strong {
    font-size: 2.4rem;
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .metric-checker__number span {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: var(--font-weight-medium);
  }

  .metric-checker__result {
    min-height: 8rem;
    padding-block: 1.5rem;
  }

  .metric-checker__pending {
    max-width: 40ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .metric-checker__metricname {
    max-width: 24ch;
    margin: 0.3rem 0 0 !important;
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: var(--font-weight-strong);
    line-height: 1.35;
  }

  .metric-checker__result h2 {
    margin: 0 0 0.65rem;
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
  }

  .metric-checker__result h2 + p {
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .metric-checker__capped {
    margin-top: 0.75rem !important;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);

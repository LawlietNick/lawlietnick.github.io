---
import { metricQualityTiers } from "../data/metric-quality-questions.js";
import { showServices } from "../data/site.js";
const { fi = false } = Astro.props;
const copy = fi ? {
  metricLabel: "Arvioitava mittari",
  metricPlaceholder: "Esim. asiakashankinnan kustannus",
  metricHelp: "Valinnainen. Nimi näkyy tuloksessa, kopioidussa yhteenvedossa ja jaetussa linkissä. Nimi ei vaikuta pisteisiin.",
  instructions: "Vastaa jokaiseen kysymykseen kyllä tai ei.",
  score: "Laatuarvio",
  yes: "kyllä",
  yesAnswer: "Kyllä",
  noAnswer: "Ei",

  reset: "Tyhjennä vastaukset",
  viewAssessment: "Katso laatuarvio",
  requiresJs: "Mittarin laatutarkistus tarvitsee JavaScriptin laskeakseen arvion. Voit lukea esimerkit ilman JavaScriptiä.",
  exampleLink: "Siirry esimerkkeihin",
  caveat: "Pisteet jäsentävät keskustelua. Asteikkoa ei ole validoitu tutkimuksella. Lopullinen arvio vaatii liiketoimintakontekstin.",
  ranges: [
    "0–3 kyllä",
    "4–5 kyllä",
    "6–7 kyllä",
    "8–10 kyllä"
  ],
  answeredLabel: "vastattu",
  pending: "Vastaa kaikkiin kymmeneen kysymykseen, niin näet arvion.",
  areaTitle: "Osa-alueittain",
  gapsTitle: "Korjattavaa",

  cappedNote: "Luokitus on enintään ”Vaatii täsmennystä”, kun välttämättömiä tarkistuksia puuttuu. Tarkista seuraavat kohdat:",
  copySummary: "Kopioi yhteenveto",
  copyLink: "Kopioi linkki",
  copied: "Kopioitu ✓",
  copyError: "Kopiointi epäonnistui. Yritä uudelleen tai salli leikepöydän käyttö.",
  shareHelp: "Yhteenveto muodostuu vastauksistasi. Kopioi se talteen tai jaa arvio linkillä. Linkki sisältää nimen, vastaukset ja käyttötarkoituksen.",
  unnamed: "(nimeämätön mittari)",
  sumHeading: "Mittarin laatutarkistus",
  sumRec: "Suositus",
  sumTool: "Arvioitu työkalulla",
  roleLabel: "Mahdollinen rooli",
  roleQuestion: "Mihin käytät mittaria tässä arvioinnissa?",

  roleHelp: "Valitse lähinnä omaa käyttöäsi oleva kuvaus. Työkalu ehdottaa sen perusteella roolia. Tämä lisäkysymys ei vaikuta pisteisiin, ja voit jättää sen avoimeksi.",
  roleNone: "Rooli vielä epäselvä",
  nextTitle: "Seuraava toimi",
  allGoodNext: "Sovi mittarin seuraava tarkistusajankohta.",
} : {
  metricLabel: "Metric to assess",
  metricPlaceholder: "For example, customer acquisition cost",
  metricHelp: "Optional. Used to label your result, copied summary, and shared link. It does not affect the score.",
  instructions: "Answer every question with Yes or No.",
  score: "Quality assessment",
  yes: "yes",
  yesAnswer: "Yes",
  noAnswer: "No",

  reset: "Clear answers",
  viewAssessment: "View assessment",
  requiresJs: "The metric quality checker needs JavaScript to calculate an assessment. You can read the examples without JavaScript.",
  exampleLink: "Go to examples",
  caveat: "The score structures the discussion. This scale has not been validated by research. Final judgment depends on business context.",
  ranges: [
    "0–3 yes",
    "4–5 yes",
    "6–7 yes",
    "8–10 yes"
  ],
  answeredLabel: "answered",
  pending: "Answer all ten questions to see the assessment.",
  areaTitle: "By area",
  gapsTitle: "Gaps to close",

  cappedNote: "The assessment cannot exceed “Needs clarification” while essential checks are unresolved. Review these items:",
  copySummary: "Copy summary",
  copyLink: "Copy link",
  copied: "Copied ✓",
  copyError: "Copy failed. Try again or allow clipboard access.",
  shareHelp: "Your answers generate the summary. Copy it to save it or share the assessment by link. The link includes the name, answers and purpose.",
  unnamed: "(unnamed metric)",
  sumHeading: "Metric quality check",
  sumRec: "Recommendation",
  sumTool: "Assessed with",
  roleLabel: "Suggested role",
  roleQuestion: "What do you use this metric for in this assessment?",

  roleHelp: "Choose the description closest to how you use the metric. The tool will suggest a role. This extra question does not affect the score and can be left open.",
  roleNone: "Role still unclear",
  nextTitle: "Next action",
  allGoodNext: "Agree on the next review date for this metric.",
};
const tiers = metricQualityTiers[fi ? "fi" : "en"];
const results = fi ? [
  {
    band: "unproven",
    label: "Käyttökelpoisuus osoittamatta",
    description: "Tarkenna mittarin käyttötarkoitus ja sen arviointiin tarvittavat tiedot."
  },
  {
    band: "clarify",
    label: "Vaatii täsmennystä",
    description: "Korjaa puutteet ennen kuin luotat mittariin päätöksenteossa."
  },
  {
    band: "qualified",
    label: "Käyttökelpoinen varauksin",
    description: "Mittari voi tukea päätöksiä. Huomioi listatut puutteet sen tulkinnassa."
  },
  {
    band: "sound",
    label: "Hyvä pohja päätöksenteolle",
    description: "Mittarilla on hyvä pohja päätösten tukemiseen. Sen merkitys riippuu tavoitteesta ja käyttötavasta."
  }
] : [
  {
    band: "unproven",
    label: "Usefulness not established",
    description: "Clarify the intended use and the information needed to assess the metric."
  },
  {
    band: "clarify",
    label: "Needs clarification",
    description: "Close the gaps before relying on the metric for decisions."
  },
  {
    band: "qualified",
    label: "Useful with reservations",
    description: "The metric can support decisions. Account for the listed gaps when interpreting it."
  },
  {
    band: "sound",
    label: "Sound basis for decisions",
    description: "The metric has a sound basis for supporting decisions. Its importance depends on the goal and how it is used."
  }
];
const roles = fi ? [
  {
    "value": "outcome",
    "label": "Tulosmittari",
    "purpose": "Seuraan, toteutuuko liiketoiminnan tavoite.",
    "explanation": "Seuraat tavoitteen toteutumista. Tässä käytössä mittari toimii tulosmittarina."
  },
  {
    "value": "leading",
    "label": "Ennakoiva mittari",
    "purpose": "Seuraan aiempaa vaihetta, jonka oletan kertovan tulevasta tuloksesta.",
    "explanation": "Seuraat tulosta edeltävää vaihetta. Mittari voi toimia ennakoivana mittarina, kun yhteys myöhempään tulokseen on varmistettu."
  },
  {
    "value": "diagnostic",
    "label": "Diagnostinen mittari",
    "purpose": "Selvitän, mistä tuloksen muutos johtuu.",
    "explanation": "Käytät mittaria muutoksen syiden selvittämiseen. Tässä käytössä se toimii diagnostisena mittarina."
  },
  {
    "value": "guardrail",
    "label": "Laatu- tai vastamittari",
    "purpose": "Tarkistan, ettei toisen mittarin paraneminen heikennä laatua tai aiheuta haittaa.",
    "explanation": "Seuraat toisen mittarin parantamisen sivuvaikutuksia. Tässä käytössä mittari toimii laatu- tai vastamittarina."
  }
] : [
  {
    "value": "outcome",
    "label": "Outcome metric",
    "purpose": "I track whether a business goal is being achieved.",
    "explanation": "You track progress toward a goal. In this use, the metric acts as an outcome metric."
  },
  {
    "value": "leading",
    "label": "Leading indicator",
    "purpose": "I track an earlier stage that I expect to indicate a future outcome.",
    "explanation": "You track an earlier stage. The metric can act as a leading indicator once its relationship to the later outcome has been checked."
  },
  {
    "value": "diagnostic",
    "label": "Diagnostic metric",
    "purpose": "I investigate why an outcome changed.",
    "explanation": "You use the metric to investigate reasons for a change. In this use, it acts as a diagnostic metric."
  },
  {
    "value": "guardrail",
    "label": "Quality or counter metric",
    "purpose": "I check that improving another metric does not harm quality or cause other problems.",
    "explanation": "You monitor the side effects of improving another metric. In this use, it acts as a quality or counter metric."
  }
];
const cta = fi
  ? {
      eyebrow: "Seuraava askel",
      text: "Jos mittarit eivät ohjaa päätöksiä, mittaaminen on usein suunniteltu puutteellisesti. Tilanne on korjattavissa.",
      label: "Keskustele seurantasuunnitelmasta",
      href: showServices ? "/fi/palvelut/seurannan-toteutussuunnitelma/" : "/fi/minusta/",
    }
  : {
      eyebrow: "Next step",
      text: "Metrics that don't change decisions usually trace back to a measurement setup that was never planned. That is fixable.",
      label: "Discuss a tracking plan",
      href: showServices ? "/services/tracking-implementation-plan/" : "/about/",
    };

const toolUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const questionMeta = tiers.flatMap((t) => t.questions.map((q) => ({ id: q.id, gap: q.gap, tier: t.key })));
const tierMeta = tiers.map((t) => ({ key: t.key, title: t.title, total: t.questions.length }));
const config = { results, questions: questionMeta, tiers: tierMeta, roles, copy, cta, toolUrl };
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");
let questionNumber = 0;
---
<section class="metric-checker" data-metric-checker>
  <script type="application/json" data-metric-config set:html={configJson} />
  <noscript>
    <p class="metric-checker__noscript content-links">{copy.requiresJs} <a href="#metric-examples-title">{copy.exampleLink}</a></p>
  </noscript>
  <div class="metric-checker__layout">
    <aside id="metric-quality-assessment" class="metric-checker__score" data-band="neutral" data-state="empty" tabindex="0" aria-label={copy.score}>
      <div class="metric-checker__score-head">
        <div>
          <p class="label">{copy.score}</p>
          <p class="metric-checker__metricname" data-metric-name hidden></p>
          <p class="metric-checker__progress" data-progress aria-live="polite" aria-atomic="true"></p>
        </div>
        <output class="metric-checker__number" aria-live="off">
          <strong data-score>0</strong><span>/10 {copy.yes}</span>
        </output>
      </div>

      <div class="metric-checker__result" role="status" aria-live="polite" aria-atomic="true">
        <p class="metric-checker__pending" data-pending>{copy.pending}</p>
        <div class="metric-checker__verdict" data-verdict hidden>
          <h2 data-result-label></h2>
          <p data-result-description></p>
          <p data-result-role></p>
          <p class="metric-checker__capped" data-capped hidden></p>
        </div>
      </div>

      <div data-area hidden><p class="label">{copy.areaTitle}</p><ul class="metric-checker__tierscores" data-tierscores></ul></div>

      <div class="metric-checker__gaps" data-gaps hidden>
        <p class="label">{copy.gapsTitle}</p>
        <ul data-gaps-list></ul>
      </div>

      <div class="metric-checker__next" data-next hidden>
        <p class="label">{copy.nextTitle}</p>
        <p data-next-text></p>
      </div>
      <a class="metric-checker__cta" data-cta hidden href={cta.href}>
        <span class="metric-checker__cta-eyebrow">{cta.eyebrow}</span>
        <span class="metric-checker__cta-text" data-cta-text></span>
        <span class="metric-checker__cta-label" data-cta-label></span>
      </a>

      <div class="metric-checker__actions" data-actions hidden>
        <button type="button" data-copy-summary>{copy.copySummary}</button>
        <button type="button" data-copy-link aria-describedby="metric-share-help">{copy.copyLink}</button>
        <p id="metric-share-help">{copy.shareHelp}</p>
        <p data-copy-status role="status"></p>
      </div>

      <div class="metric-checker__scale" aria-hidden="true">
        <div class="metric-checker__segments">
          {Array.from({ length: 10 }, (_, index) => <span data-segment={index + 1}></span>)}
        </div>
        <div class="metric-checker__ranges">
          {copy.ranges.map((range) => <span>{range}</span>)}
        </div>
      </div>

      <p class="metric-checker__caveat">{copy.caveat}</p>
    </aside>

    <form class="metric-checker__form" aria-describedby="metric-checker-instructions">
      <div class="metric-checker__metric">
        <label for="metric-name">{copy.metricLabel}</label>
        <input id="metric-name" name="metric" type="text" placeholder={copy.metricPlaceholder} autocomplete="off" aria-describedby="metric-name-help" />
        <p id="metric-name-help">{copy.metricHelp}</p>
        <p id="metric-checker-instructions">{copy.instructions}</p>
      </div>

      <div class="metric-checker__tiers">
        {
          tiers.map((tier) => (
            <fieldset>
              <legend>
                <span>{tier.tier}</span>
                <strong>{tier.title}</strong>
              </legend>
              <div class="metric-checker__questions">
                {tier.questions.map(({ id: questionId, q, hint }) => {
                  questionNumber += 1;
                  const id = `metric-question-${questionNumber}`;
                  return (
                    <div class="metric-checker__question">
                      <div id={id} class="metric-checker__question-copy">
                        <strong><span class="metric-checker__question-number" aria-hidden="true">{questionNumber}.</span> {q}</strong>
                        {hint && <small>{hint}</small>}
                      </div>
                      <div class="metric-checker__toggle" role="radiogroup" aria-labelledby={id}>
                        <label>
                          <input data-answer type="radio" name={questionId} value="no" />
                          <span>{copy.noAnswer}</span>
                        </label>
                        <label>
                          <input data-answer type="radio" name={questionId} value="yes" />
                          <span>{copy.yesAnswer}</span>
                        </label>
                      </div>
                    </div>
                  );
                })}
              </div>
              {tier.key === "A" && (
                <fieldset class="metric-checker__purpose" aria-describedby="metric-purpose-help">
                  <legend>{copy.roleQuestion}</legend>
                  <p id="metric-purpose-help">{copy.roleHelp}</p>
                  {roles.map(({ value, purpose }) => (
                    <label>
                      <input type="radio" name="metric-purpose" value={value} />
                      <span>{purpose}</span>
                    </label>
                  ))}
                  <p data-role-feedback role="status" hidden></p>
                </fieldset>
              )}
            </fieldset>
          ))
        }
      </div>

      <a class="metric-checker__jump content-link" href="#metric-quality-assessment" data-jump-to-score hidden>{copy.viewAssessment}</a>
      <button type="reset">{copy.reset}</button>
    </form>
  </div>
</section>

<script>
  import { assessMetric } from "../utils/metric-quality.js";

  const initializeMetricCheckers = () => {
    document.querySelectorAll("[data-metric-checker]").forEach((checker) => {
      if (checker.hasAttribute("data-initialized")) return;
      checker.setAttribute("data-initialized", "");
      const cfg = JSON.parse(checker.querySelector("[data-metric-config]").textContent);
      const { results, questions, tiers, roles, copy, cta, toolUrl } = cfg;
      const el = (selector) => checker.querySelector(selector);
      const setText = (selector, value) => {
        const element = el(selector);
        const text = String(value);
        if (element.textContent !== text) element.textContent = text;
      };
      const form = checker.querySelector("form");
      const metricInput = el("#metric-name");
      const roleValue = () => form.querySelector('input[name="metric-purpose"]:checked')?.value ?? "";
      const panel = el(".metric-checker__score");
      const questionById = Object.fromEntries(questions.map((q) => [q.id, q]));
      const readAnswers = () => Object.fromEntries(questions.map(({ id }) => [
        id, form.querySelector(`input[name="${id}"]:checked`)?.value ?? null,
      ]));
      const action = (id) => questionById[id].gap;
      const assess = () => {
        const assessment = assessMetric(readAnswers());
        return { ...assessment, band: assessment.complete ? results[assessment.bandIndex] : null,
          name: metricInput.value.trim(),
          role: roles.find(({ value }) => value === roleValue())?.label ?? copy.roleNone,
          roleExplanation: roles.find(({ value }) => value === roleValue())?.explanation ?? "",
          next: assessment.nextId ? action(assessment.nextId) : copy.allGoodNext };
      };
      const renderList = (selector, ids) => {
        const list = el(selector);
        list.replaceChildren();
        ids.forEach((id) => {
          const item = document.createElement("li");
          item.className = "mqc-gap";
          item.textContent = `${id.slice(1)}. ${action(id)}`;
          list.append(item);
        });
      };
      const render = () => {
        const s = assess();
        setText("[data-score]", s.yes);
        panel.dataset.state = s.complete ? "complete" : s.answered ? "progress" : "empty";
        panel.dataset.band = s.complete ? s.band.band : "neutral";
        checker.querySelectorAll("[data-segment]").forEach((segment, i) => segment.classList.toggle("is-filled", i < s.yes));
        setText("[data-progress]", s.complete ? "" : `${s.answered} / ${questions.length} ${copy.answeredLabel}`);
        el("[data-metric-name]").hidden = !s.name;
        setText("[data-metric-name]", s.name);
        el("[data-pending]").hidden = s.complete;
        ["[data-verdict]", "[data-area]", "[data-actions]", "[data-next]", "[data-jump-to-score]"].forEach((selector) => { el(selector).hidden = !s.complete; });
        el("[data-gaps]").hidden = !s.complete || !s.gaps.length;
        el("[data-cta]").hidden = !s.complete || s.bandIndex > 1;
        const roleFeedback = el("[data-role-feedback]");
        roleFeedback.hidden = !form.querySelector('input[name="metric-purpose"]:checked');
        setText("[data-role-feedback]", `${copy.roleLabel}: ${s.role}${s.roleExplanation ? `. ${s.roleExplanation}` : ""}`);
        if (!s.complete) return;

        setText("[data-result-label]", s.band.label);
        setText("[data-result-description]", s.band.description);
        setText("[data-result-role]", `${copy.roleLabel}: ${s.role}${s.roleExplanation ? `. ${s.roleExplanation}` : ""}`);
        el("[data-capped]").hidden = !s.unresolvedEssential.length;
        setText("[data-capped]", s.unresolvedEssential.length
          ? `${copy.cappedNote} ${s.unresolvedEssential.map((id) => `${id.slice(1)}. ${action(id)}`).join(" ")}` : "");
        const tierScores = el("[data-tierscores]");
        tierScores.replaceChildren();
        tiers.forEach((tier) => {
          const row = document.createElement("li");
          row.className = "mqc-row";
          const label = document.createElement("span");
          label.textContent = tier.title;
          const score = document.createElement("strong");
          score.textContent = `${s.tierYes[tier.key]}/${tier.total}`;
          row.append(label, score);
          tierScores.append(row);
        });
        renderList("[data-gaps-list]", s.gaps);
        el("[data-next-text]").textContent = s.next;
        el("[data-cta-text]").textContent = cta.text;
        el("[data-cta-label]").textContent = cta.label;
      };
      const buildSummary = () => {
        const s = assess();
        const lines = [
          `${copy.sumHeading}: ${s.name || copy.unnamed}`,
          `${copy.score}: ${s.yes}/${questions.length} — ${s.band.label}`,
          `${copy.roleLabel}: ${s.role}${s.roleExplanation ? `. ${s.roleExplanation}` : ""}`,
          tiers.map((tier) => `${tier.title} ${s.tierYes[tier.key]}/${tier.total}`).join(" · "),
          `${copy.sumRec}: ${s.band.description}`,
        ];
        if (s.unresolvedEssential.length) {
          lines.push(copy.cappedNote);
          s.unresolvedEssential.forEach((id) => lines.push(`- ${id.slice(1)}. ${action(id)}`));
        }
        if (s.gaps.length) {
          lines.push(`${copy.gapsTitle}:`);
          s.gaps.forEach((id) => lines.push(`- ${id.slice(1)}. ${action(id)}`));
        }
        lines.push(`${copy.nextTitle}: ${s.next}`);
        lines.push(copy.caveat, `${copy.sumTool}: ${toolUrl}`);
        return lines.join("\n");
      };
      const buildLink = () => {
        const answers = readAnswers();
        const code = questions.map(({ id }) => ({ yes: "y", no: "n" })[answers[id]] ?? "-").join("");
        const url = new URL(location.href);
        url.search = "";
        url.hash = "";
        if (metricInput.value.trim()) url.searchParams.set("m", metricInput.value.trim());
        url.searchParams.set("a", code);
        if (roleValue()) url.searchParams.set("r", roleValue());
        return url.href;
      };
      const params = new URLSearchParams(location.search);
      metricInput.value = params.get("m") ?? "";
      const sharedRole = roles.find(({ value }) => value === params.get("r"));
      if (sharedRole) form.querySelector(`input[name="metric-purpose"][value="${sharedRole.value}"]`).checked = true;
      [...(params.get("a") ?? "")].slice(0, questions.length).forEach((character, i) => {
        const value = { y: "yes", n: "no" }[character];
        if (value) form.querySelector(`input[name="${questions[i].id}"][value="${value}"]`).checked = true;
      });
      form.addEventListener("submit", (event) => event.preventDefault());
      form.addEventListener("input", render);
      form.addEventListener("reset", () => {
        requestAnimationFrame(() => {
          history.replaceState(null, "", location.pathname);
          el("[data-copy-status]").textContent = "";
          render();
        });
      });
      const copyText = async (text, link = false) => {
        try {
          await navigator.clipboard.writeText(text);
          if (link) history.replaceState(null, "", text);
          el("[data-copy-status]").textContent = copy.copied;
        } catch {
          el("[data-copy-status]").textContent = copy.copyError;
        }
      };
      el("[data-copy-summary]").addEventListener("click", () => copyText(buildSummary()));
      el("[data-copy-link]").addEventListener("click", () => copyText(buildLink(), true));
      render();
    });
  };
  initializeMetricCheckers();
  document.addEventListener("astro:page-load", initializeMetricCheckers);
</script>

<style>
  /* elements toggled with [hidden] also set display in CSS, so hidden must win */
  .metric-checker [hidden] { display: none !important; }

  .metric-checker {
    --score-neutral: light-dark(oklch(66% 0.03 286), oklch(58% 0.03 286));
    --score-unproven: light-dark(oklch(62% 0.2 25), oklch(72% 0.16 25));
    --score-clarify: light-dark(oklch(78% 0.16 87), oklch(82% 0.14 87));
    --score-qualified: light-dark(oklch(70% 0.1 182), oklch(76% 0.1 182));
    --score-sound: light-dark(oklch(55% 0.14 164), oklch(71% 0.12 164));
    margin-block: 1rem var(--section-y-large);
    padding-block: 1rem;
    font-size: var(--font-size-ui);
    line-height: var(--line-height-ui);
  }

  .metric-checker__layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .metric-checker__score {
    --score-color: var(--score-neutral);
    padding: clamp(1.25rem, 4cqi, 2rem);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--bg);
    scroll-margin-block-start: 3rem;
    transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
  }

  .metric-checker__noscript {
    padding: 1rem;
    background: var(--color-accent-panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .metric-checker__score[data-band="unproven"] { --score-color: var(--score-unproven); }
  .metric-checker__score[data-band="clarify"] { --score-color: var(--score-clarify); }
  .metric-checker__score[data-band="qualified"] { --score-color: var(--score-qualified); }
  .metric-checker__score[data-band="sound"] { --score-color: var(--score-sound); }

  .metric-checker__score-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 1rem;

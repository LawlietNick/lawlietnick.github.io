---
// Cookie banner styler widget: pick colours + title/description alignment, see a
// live preview of the real banner (isolated in an iframe), and copy the themed
// CSS plus the verbatim HTML and JS for the Cookiebot custom template.
import baseCss from "../assets/tools/cookie-banner/base.css?raw";
import bannerHtml from "../assets/tools/cookie-banner/banner.html?raw";
import bannerJs from "../assets/tools/cookie-banner/banner.js?raw";

// fi: Finnish UI and preview sample text. The generated CSS, HTML and JS are identical.
const { fi = false } = Astro.props;
const t = (en, fiText) => (fi ? fiText : en);

const defaults = {
  previewSize: "desktop",
  buttonMode: "same",
  accent: "#afcefa",
  buttonText: "#000000",
  hoverBg: "#84aee9",
  hoverText: "#000000",
  acceptBg: "#afcefa",
  acceptText: "#000000",
  acceptHoverBg: "#84aee9",
  acceptHoverText: "#000000",
  acceptBorderEnabled: true,
  acceptBorderWidth: 2,
  acceptBorderColor: "#afcefa",
  acceptBorderHoverColor: "#84aee9",
  acceptUnderline: false,
  acceptHoverUnderline: false,
  acceptRadius: 0,
  acceptPaddingY: 16,
  acceptFontSize: 16,
  acceptFontWeight: "700",
  denyBg: "#ffffff",
  denyText: "#0f0f0f",
  denyHoverBg: "#eeeeee",
  denyHoverText: "#0f0f0f",
  denyBorderEnabled: true,
  denyBorderWidth: 2,
  denyBorderColor: "#0f0f0f",
  denyBorderHoverColor: "#0f0f0f",
  denyUnderline: false,
  denyHoverUnderline: false,
  denyRadius: 0,
  denyPaddingY: 16,
  denyFontSize: 16,
  denyFontWeight: "700",
  detailsBg: "#ffffff",
  detailsText: "#0f0f0f",
  detailsHoverBg: "#eeeeee",
  detailsHoverText: "#0f0f0f",
  detailsBorderEnabled: false,
  detailsBorderWidth: 2,
  detailsBorderColor: "#0f0f0f",
  detailsBorderHoverColor: "#0f0f0f",
  detailsUnderline: true,
  detailsHoverUnderline: true,
  detailsRadius: 0,
  detailsPaddingY: 8,
  detailsFontSize: 16,
  detailsFontWeight: "400",
  selectionBg: "#afcefa",
  selectionText: "#000000",
  selectionHoverBg: "#84aee9",
  selectionHoverText: "#000000",
  selectionBorderEnabled: true,
  selectionBorderWidth: 2,
  selectionBorderColor: "#afcefa",
  selectionBorderHoverColor: "#84aee9",
  selectionUnderline: false,
  selectionHoverUnderline: false,
  selectionRadius: 0,
  selectionPaddingY: 16,
  selectionFontSize: 16,
  selectionFontWeight: "700",
  textColor: "#0f0f0f",
  dialogBg: "#ffffff",
  overlayColor: "#000000",
  overlayOpacity: 40,
  dialogPadding: 48,
  dialogRadius: 0,
  titleFontSize: 28,
  titleFontWeight: "700",
  descriptionFontSize: 16,
  contentSpacing: 24,
  preferenceBg: "#f4f4f4",
  toggleOffTrack: "#868e96",
  toggleOffHandle: "#ffffff",
  toggleOnTrack: "#afcefa",
  toggleOnHandle: "#ffffff",
  toggleDeniedTrack: "#b0b0b0",
  toggleDeniedHandle: "#ffffff",
  borderEnabled: true,
  borderWidth: 2,
  borderColor: "#afcefa",
  borderHoverColor: "#84aee9",
  underline: false,
  hoverUnderline: false,
  radius: 0,
  paddingY: 16,
  fontSize: 16,
  fontWeight: "700",
  titleAlign: "center",
  descriptionAlign: "center",
};

// sample copy so the preview shows real text instead of [#TOKENS#]
const sample = fi
  ? {
      LANGUAGE: "fi", TEXTDIRECTION: "ltr",
      TITLE: "Käytämme evästeitä",
      TEXT: "Käytämme evästeitä sivuston kehittämiseen ja sen ymmärtämiseen, mikä toimii. Voit muuttaa valintojasi milloin tahansa.",
      DECLINE: "Vain välttämättömät", ACCEPT: "Salli evästeet", DETAILS: "Näytä tiedot",
      LEVELOPTIN_ALLOW_SELECTION: "Salli valinnat",
      COOKIETYPE_NECESSARY: "Välttämättömät", COOKIETYPE_NECESSARY_RAW: "Välttämättömät",
      COOKIETYPEINTRO_NECESSARY: "Nämä evästeet tarvitaan sivuston toimintaan.", COOKIETABLE_NECESSARY: "",
      COOKIETYPE_PREFERENCE: "Asetukset", COOKIETYPE_PREFERENCE_RAW: "Asetukset",
      COOKIETYPEINTRO_PREFERENCE: "Muistavat valintoja, kuten kielen.", COOKIETABLE_PREFERENCE: "",
      COOKIETYPE_STATISTICS: "Tilastot", COOKIETYPE_STATISTICS_RAW: "Tilastot",
      COOKIETYPEINTRO_STATISTICS: "Auttavat ymmärtämään, miten sivustoa käytetään.", COOKIETABLE_STATISTICS: "",
      COOKIETYPE_ADVERTISING: "Markkinointi", COOKIETYPE_ADVERTISING_RAW: "Markkinointi",
      COOKIETYPEINTRO_ADVERTISING: "Auttavat kohdentamaan markkinointia osuvammin.", COOKIETABLE_ADVERTISING: "",
      LASTUPDATED: "Suostumuksesi on päivitetty äskettäin.",
    }
  : {
      LANGUAGE: "en", TEXTDIRECTION: "ltr",
      TITLE: "We use cookies",
      TEXT: "We use cookies to improve the site and understand what works. You can change your choices at any time.",
      DECLINE: "Only necessary", ACCEPT: "Allow cookies", DETAILS: "Show details",
      LEVELOPTIN_ALLOW_SELECTION: "Allow selection",
      COOKIETYPE_NECESSARY: "Necessary", COOKIETYPE_NECESSARY_RAW: "Necessary",
      COOKIETYPEINTRO_NECESSARY: "These cookies are needed for the site to work.", COOKIETABLE_NECESSARY: "",
      COOKIETYPE_PREFERENCE: "Preferences", COOKIETYPE_PREFERENCE_RAW: "Preferences",
      COOKIETYPEINTRO_PREFERENCE: "Remember choices such as language.", COOKIETABLE_PREFERENCE: "",
      COOKIETYPE_STATISTICS: "Statistics", COOKIETYPE_STATISTICS_RAW: "Statistics",
      COOKIETYPEINTRO_STATISTICS: "Help us understand how the site is used.", COOKIETABLE_STATISTICS: "",
      COOKIETYPE_ADVERTISING: "Marketing", COOKIETYPE_ADVERTISING_RAW: "Marketing",
      COOKIETYPEINTRO_ADVERTISING: "Used to make marketing more relevant.", COOKIETABLE_ADVERTISING: "",
      LASTUPDATED: "Your consent was last updated recently.",
    };

const previewBanner = bannerHtml
  .replace('id="CookieBanner"', 'id="CookieBanner" class="is-visible-cookie-banner"')
  .replace(/\[#(\w+)#\]/g, (_, key) => sample[key] ?? "");

const previewCss = `
  .preview-desktop #CookieBanner .cookiebanner__buttons ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px 16px;
  }
  .preview-desktop #CookieBanner .cookiebanner__buttons li {
    width: auto;
    margin: 0;
  }
  .preview-desktop #CookieBanner .cookiebanner__buttons li:last-of-type {
    grid-column: 1 / -1;
  }
  .preview-desktop #CookieBanner .cookiebanner__buttons__accept,
  .preview-desktop #CookieBanner .cookiebanner__buttons__deny {
    min-width: 0;
  }
  .preview-desktop #CookieBanner .cookiebanner__buttons__details {
    margin-top: 0;
  }
`;

// Split the script tag so Vite's dev dependency scanner does not mistake the
// iframe srcdoc script for an Astro component script block.
const scriptOpen = "<scr" + "ipt>";
const scriptClose = "</scr" + "ipt>";
const previewDoc = `<!doctype html><html lang="${t("en", "fi")}" class="preview-desktop"><head><meta charset="utf-8"><style>${baseCss}${previewCss}</style></head><body>${previewBanner}${scriptOpen}${bannerJs}${scriptClose}</body></html>`;

const rgba = (hex, opacity) => {
  const value = hex.replace("#", "");
  const full = value.length === 3 ? value.split("").map((character) => character + character).join("") : value;
  return `rgba(${parseInt(full.slice(0, 2), 16)}, ${parseInt(full.slice(2, 4), 16)}, ${parseInt(full.slice(4, 6), 16)}, ${opacity / 100})`;
};

const overrideBlock = (v) =>
  `#CookieBanner {\n  --cb-accent: ${v.accent};\n  --cb-button-text: ${v.buttonText};\n  --cb-hover-bg: ${v.hoverBg};\n  --cb-hover-text: ${v.hoverText};\n  --cb-text-color: ${v.textColor};\n  --cb-dialog-bg: ${v.dialogBg};\n  --cb-overlay: ${rgba(v.overlayColor, v.overlayOpacity)};\n  --cb-dialog-padding: ${v.dialogPadding}px;\n  --cb-dialog-radius: ${v.dialogRadius}px;\n  --cb-title-font-size-mobile: ${v.titleFontSize}px;\n  --cb-title-font-size-desktop: ${v.titleFontSize}px;\n  --cb-title-font-weight: ${v.titleFontWeight};\n  --cb-description-font-size-mobile: ${v.descriptionFontSize}px;\n  --cb-description-font-size-desktop: ${v.descriptionFontSize}px;\n  --cb-content-spacing: ${v.contentSpacing}px;\n  --cb-preference-bg: ${v.preferenceBg};\n  --cb-toggle-off: ${v.toggleOffTrack};\n  --cb-toggle-off-handle: ${v.toggleOffHandle};\n  --cb-toggle-on: ${v.toggleOnTrack};\n  --cb-toggle-on-handle: ${v.toggleOnHandle};\n  --cb-toggle-denied: ${v.toggleDeniedTrack};\n  --cb-toggle-denied-handle: ${v.toggleDeniedHandle};\n  --cb-button-border-width: ${v.borderEnabled ? v.borderWidth : 0}px;\n  --cb-button-border-color: ${v.borderColor};\n  --cb-button-border-hover-color: ${v.borderHoverColor};\n  --cb-button-text-decoration: ${v.underline ? "underline" : "none"};\n  --cb-button-hover-text-decoration: ${v.hoverUnderline ? "underline" : "none"};\n  --cb-details-display: block;\n  --cb-title-align: ${v.titleAlign};\n  --cb-description-align: ${v.descriptionAlign};\n}\n`;

const defaultCss = `${overrideBlock(defaults)}\n${baseCss}`;

const colorFields = [
  { id: "accent", label: t("Accent", "Korostusväri"), hint: t("Preference toggles", "Asetusten valintakytkimet") },
  { id: "textColor", label: t("Text", "Teksti"), hint: t("Title and description", "Otsikko ja kuvaus") },
];
const buttonGroups = [
  { id: "same", label: t("All buttons", "Kaikki painikkeet"), prefix: "" },
  { id: "accept", label: t("Accept button", "Hyväksy-painike"), prefix: "accept" },
  { id: "deny", label: t("Deny button", "Hylkää-painike"), prefix: "deny" },
  { id: "details", label: t("Show details button", "Näytä tiedot -painike"), prefix: "details" },
  { id: "selection", label: t("Allow selection button", "Salli valinnat -painike"), prefix: "selection" },
];
const buttonColorFields = [
  { suffix: "Bg", shared: "accent", label: t("Button colour", "Painikkeen väri") },
  { suffix: "Text", shared: "buttonText", label: t("Text colour", "Tekstin väri") },
  { suffix: "HoverBg", shared: "hoverBg", label: t("Hover colour", "Hover-väri") },
  { suffix: "HoverText", shared: "hoverText", label: t("Hover text colour", "Tekstin hover-väri") },
];
const scriptCopy = {
  buttonContrast: t("Button text contrast is low ({r}:1).", "Painikkeen tekstin kontrasti on heikko ({r}:1)."),
  textContrast: t("Text contrast is low ({r}:1).", "Tekstin kontrasti on heikko ({r}:1)."),
  hoverContrast: t("Hover text contrast is low ({r}:1).", "Tekstin kontrasti hover-tilassa on heikko ({r}:1)."),
  bodyContrast: t("Body text contrast is low ({r}:1).", "Leipätekstin kontrasti on heikko ({r}:1)."),
  previewTitle: t("Cookie banner preview, {size} size", "Evästebannerin esikatselu, {size}"),
  mobile: t("mobile", "mobiilikoko"), desktop: t("desktop", "työpöytäkoko"),
  copied: t("Copied ✓", "Kopioitu ✓"),
};
const alignFields = [
  { id: "titleAlign", label: t("Title alignment", "Otsikon tasaus") },
  { id: "descriptionAlign", label: t("Description alignment", "Kuvauksen tasaus") },
];
---

<div class="cbs" data-defaults={JSON.stringify(defaults)} data-copy={JSON.stringify(scriptCopy)}>
  <form class="cbs__controls" aria-label={t("Banner styling controls", "Bannerin tyyliasetukset")}>
    <details class="cbs__group" open>
      <summary class="cbs__h">{t("Button styles", "Painikkeiden tyylit")}</summary>
      <div class="cbs__group-content">
        <div class="cbs__field">
          <span class="cbs__legend">{t("Banner buttons", "Bannerin painikkeet")}</span>
          <div class="cbs__seg cbs__seg--stack" role="group" aria-label={t("Banner button styles", "Bannerin painikkeiden tyylit")}>
            <label class="cbs__seg__opt">
              <input type="radio" name="buttonMode" value="same" checked />
              <span>{t("Use the same style", "Sama tyyli kaikille")}</span>
            </label>
            <label class="cbs__seg__opt">
              <input type="radio" name="buttonMode" value="separate" />
              <span>{t("Style separately", "Erilliset tyylit")}</span>
            </label>
          </div>
        </div>
        {
          buttonGroups.map((group) => (
            <details class="cbs__button-set" data-button-panel={group.id} open={group.id === "same"}>
              <summary class="cbs__subhead">{group.label}</summary>
              <div class="cbs__button-content">
                {buttonColorFields.map((field) => {
                  const key = group.prefix ? `${group.prefix}${field.suffix}` : field.shared;
                  const inputId = `cbs-${key}`;
                  return (
                    <div class="cbs__field">
                      <label for={inputId}>{field.label}</label>
                      <div class="cbs__color">
                        <input type="color" id={inputId} name={key} value={defaults[key]} />
                        <input type="text" class="cbs__hex" aria-label={`${group.label} ${field.label} hex`} value={defaults[key]} data-hex-for={inputId} spellcheck="false" />
                      </div>
                    </div>
                  );
                })}
                <details class="cbs__advanced">
                  <summary>{t("Advanced settings", "Lisäasetukset")}</summary>
                  <div class="cbs__advanced-content">
                    <div class="cbs__option-pair">
                      <label class="cbs__check">
                        <input type="checkbox" name={group.prefix ? `${group.prefix}Underline` : "underline"} checked={defaults[group.prefix ? `${group.prefix}Underline` : "underline"]} />
                        <span>{t("Underline text", "Alleviivaa teksti")}</span>
                      </label>
                      <label class="cbs__check">
                        <input type="checkbox" name={group.prefix ? `${group.prefix}HoverUnderline` : "hoverUnderline"} checked={defaults[group.prefix ? `${group.prefix}HoverUnderline` : "hoverUnderline"]} />
                        <span>{t("Underline on hover", "Alleviivaa hover-tilassa")}</span>
                      </label>
                    </div>
                    <div class="cbs__shape-grid">
                  {[
                    { suffix: "Radius", shared: "radius", label: t("Corner radius", "Kulmien pyöristys") },
                    { suffix: "PaddingY", shared: "paddingY", label: t("Vertical padding", "Pystysuuntainen täyte") },
                    { suffix: "FontSize", shared: "fontSize", label: t("Font size", "Fonttikoko") },
                  ].map((field) => {
                    const key = group.prefix ? `${group.prefix}${field.suffix}` : field.shared;
                    return (
                      <div class="cbs__field">
                        <label for={`cbs-${key}`}>{field.label}</label>
                        <div class="cbs__number">
                          <input type="number" id={`cbs-${key}`} name={key} value={defaults[key]} min="0" max="48" step="1" />
                          <span aria-hidden="true">px</span>
                        </div>
                      </div>
                    );
                  })}
                    </div>
                    <div class="cbs__field">
                      <label for={`cbs-${group.prefix || "shared"}-font-weight`}>{t("Font weight", "Fontin paksuus")}</label>
                      <select class="cbs__select" id={`cbs-${group.prefix || "shared"}-font-weight`} name={group.prefix ? `${group.prefix}FontWeight` : "fontWeight"}>
                        <option value="400" selected={defaults[group.prefix ? `${group.prefix}FontWeight` : "fontWeight"] === "400"}>{t("Regular", "Normaali")}</option>
                        <option value="600" selected={defaults[group.prefix ? `${group.prefix}FontWeight` : "fontWeight"] === "600"}>{t("Semibold", "Puolilihava")}</option>
                        <option value="700" selected={defaults[group.prefix ? `${group.prefix}FontWeight` : "fontWeight"] === "700"}>{t("Bold", "Lihava")}</option>
                      </select>
                    </div>
                    <label class="cbs__check">
                      <input type="checkbox" name={group.prefix ? `${group.prefix}BorderEnabled` : "borderEnabled"} checked={defaults[group.prefix ? `${group.prefix}BorderEnabled` : "borderEnabled"]} />
                      <span>{t("Show border", "Näytä reunaviiva")}</span>
                    </label>
                    <div class="cbs__field" data-border-setting={group.id}>
                  <label for={`cbs-${group.prefix || "shared"}-border-width`}>{t("Border width", "Reunaviivan leveys")}<span>{t("Width in pixels", "Leveys pikseleinä")}</span></label>
                  <div class="cbs__number">
                    <input type="number" id={`cbs-${group.prefix || "shared"}-border-width`} name={group.prefix ? `${group.prefix}BorderWidth` : "borderWidth"} value={defaults[group.prefix ? `${group.prefix}BorderWidth` : "borderWidth"]} min="0" max="12" step="1" />
                    <span aria-hidden="true">px</span>
                  </div>
                    </div>
                    <div class="cbs__field" data-border-setting={group.id}>
                  <label for={`cbs-${group.prefix || "shared"}-border-color`}>{t("Border colour", "Reunaviivan väri")}</label>
                  <div class="cbs__color">
                    <input type="color" id={`cbs-${group.prefix || "shared"}-border-color`} name={group.prefix ? `${group.prefix}BorderColor` : "borderColor"} value={defaults[group.prefix ? `${group.prefix}BorderColor` : "borderColor"]} />
                    <input type="text" class="cbs__hex" aria-label={`${group.label} ${t("border colour", "reunaviivan väri")} hex`} value={defaults[group.prefix ? `${group.prefix}BorderColor` : "borderColor"]} data-hex-for={`cbs-${group.prefix || "shared"}-border-color`} spellcheck="false" />
                  </div>
                    </div>
                    <div class="cbs__field" data-border-setting={group.id}>
                  <label for={`cbs-${group.prefix || "shared"}-border-hover-color`}>{t("Border hover colour", "Reunaviivan hover-väri")}</label>
                  <div class="cbs__color">
                    <input type="color" id={`cbs-${group.prefix || "shared"}-border-hover-color`} name={group.prefix ? `${group.prefix}BorderHoverColor` : "borderHoverColor"} value={defaults[group.prefix ? `${group.prefix}BorderHoverColor` : "borderHoverColor"]} />
                    <input type="text" class="cbs__hex" aria-label={`${group.label} ${t("border hover colour", "reunaviivan hover-väri")} hex`} value={defaults[group.prefix ? `${group.prefix}BorderHoverColor` : "borderHoverColor"]} data-hex-for={`cbs-${group.prefix || "shared"}-border-hover-color`} spellcheck="false" />
                  </div>
                    </div>
                  </div>
                </details>
                <p class="cbs__warn" data-contrast={group.id} role="status" hidden></p>
                <button type="button" class="cbs__section-reset" data-reset-scope={group.id}>{t("Reset", "Palauta")} {group.label.toLowerCase()}</button>
                {group.id === "accept" && (
                  <div class="cbs__copy-style">
                    <button type="button" data-copy-style="deny">{t("Copy Accept style to Deny", "Kopioi Hyväksy-tyyli Hylkää-painikkeeseen")}</button>
                    <button type="button" data-copy-style="details">{t("Copy Accept style to Show details", "Kopioi Hyväksy-tyyli Näytä tiedot -painikkeeseen")}</button>
                    <button type="button" data-copy-style="selection">{t("Copy Accept style to Allow selection", "Kopioi Hyväksy-tyyli Salli valinnat -painikkeeseen")}</button>
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </details>

    <details class="cbs__group">
      <summary class="cbs__h">{t("Banner", "Banneri")}</summary>
      <div class="cbs__group-content">
        {
          [
            { id: "dialogBg", label: t("Banner background", "Bannerin tausta") },
            { id: "overlayColor", label: t("Overlay colour", "Taustapeiton väri") },
            { id: "preferenceBg", label: t("Preference-panel background", "Asetuspaneelin tausta") },
          ].map((field) => (
            <div class="cbs__field">
              <label for={`cbs-${field.id}`}>{field.label}</label>
              <div class="cbs__color">
                <input type="color" id={`cbs-${field.id}`} name={field.id} value={defaults[field.id]} />
                <input type="text" class="cbs__hex" aria-label={`${field.label} hex`} value={defaults[field.id]} data-hex-for={`cbs-${field.id}`} spellcheck="false" />
              </div>
            </div>
          ))
        }
        <div class="cbs__shape-grid">
          {
            [
              { id: "overlayOpacity", label: t("Overlay opacity", "Taustapeiton peittävyys"), unit: "%" },
              { id: "dialogPadding", label: t("Outer padding", "Ulkoreunan täyte"), unit: "px" },
              { id: "dialogRadius", label: t("Corner radius", "Kulmien pyöristys"), unit: "px" },
            ].map((field) => (
              <div class="cbs__field">
                <label for={`cbs-${field.id}`}>{field.label}</label>
                <div class="cbs__number">
                  <input type="number" id={`cbs-${field.id}`} name={field.id} value={defaults[field.id]} min="0" max={field.id === "overlayOpacity" ? "100" : "96"} step="1" />
                  <span aria-hidden="true">{field.unit}</span>
                </div>
              </div>
            ))
          }
        </div>
        <details class="cbs__advanced">
          <summary>{t("Typography and spacing", "Typografia ja välistys")}</summary>
          <div class="cbs__advanced-content">
            <div class="cbs__shape-grid">
              {
                [
                  { id: "titleFontSize", label: t("Title font size", "Otsikon fonttikoko") },
                  { id: "descriptionFontSize", label: t("Description font size", "Kuvauksen fonttikoko") },
                  { id: "contentSpacing", label: t("Content spacing", "Sisällön välistys") },
                ].map((field) => (
                  <div class="cbs__field">
                    <label for={`cbs-${field.id}`}>{field.label}</label>
                    <div class="cbs__number">
                      <input type="number" id={`cbs-${field.id}`} name={field.id} value={defaults[field.id]} min="0" max="72" step="1" />
                      <span aria-hidden="true">px</span>
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="cbs__field">
              <label for="cbs-title-font-weight">{t("Title font weight", "Otsikon fontin paksuus")}</label>
              <select class="cbs__select" id="cbs-title-font-weight" name="titleFontWeight">
                <option value="400">{t("Regular", "Normaali")}</option>
                <option value="600">{t("Semibold", "Puolilihava")}</option>
                <option value="700" selected>{t("Bold", "Lihava")}</option>
              </select>
            </div>
          </div>
        </details>
        <button type="button" class="cbs__section-reset" data-reset-scope="banner">{t("Reset banner", "Palauta banneri")}</button>
      </div>
    </details>

    <details class="cbs__group">
      <summary class="cbs__h">{t("Preference toggles", "Asetusten valintakytkimet")}</summary>
      <div class="cbs__group-content">
        {
          [
            { title: t("Off", "Pois päältä"), fields: [["toggleOffTrack", t("Track colour", "Uran väri")], ["toggleOffHandle", t("Handle colour", "Nupin väri")]] },
            { title: t("On", "Päällä"), fields: [["toggleOnTrack", t("Track colour", "Uran väri")], ["toggleOnHandle", t("Handle colour", "Nupin väri")]] },
            { title: t("Denied or disabled", "Estetty tai pois käytöstä"), fields: [["toggleDeniedTrack", t("Track colour", "Uran väri")], ["toggleDeniedHandle", t("Handle colour", "Nupin väri")]] },
          ].map((group) => (
            <fieldset class="cbs__toggle-colours">
              <legend>{group.title}</legend>
              {group.fields.map(([id, label]) => (
                <div class="cbs__field">
                  <label for={`cbs-${id}`}>{label}</label>
                  <div class="cbs__color">
                    <input type="color" id={`cbs-${id}`} name={id} value={defaults[id]} />

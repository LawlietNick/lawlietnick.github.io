<script>
  const root = document.querySelector(".cbs");
  if (root) {
    const defaults = JSON.parse(root.dataset.defaults);
    const copy = JSON.parse(root.dataset.copy);
    const fmt = (text, r) => text.replace("{r}", r.toFixed(1));
    const frame = root.querySelector(".cbs__frame");
    const cssOut = root.querySelector("#cbs-css-out");
    const baseCss = root.querySelector("#cbs-base").value;
    const bodyContrast = root.querySelector("#cbs-body-contrast");

    const storageKey = "cookiebot-banner-styler";
    let savedState = {};
    try { savedState = JSON.parse(localStorage.getItem(storageKey)) || {}; } catch {}
    const state = { ...defaults, ...savedState };

    // apply a CSS variable to the live preview's banner element
    const applyVar = (cssVar, value) => {
      const el = frame.contentDocument && frame.contentDocument.getElementById("CookieBanner");
      if (el) el.style.setProperty(cssVar, value);
    };

    const buttonValues = (prefix) => state.buttonMode === "same"
      ? {
          bg: state.accent, text: state.buttonText, hoverBg: state.hoverBg, hoverText: state.hoverText,
          borderWidth: state.borderEnabled ? state.borderWidth : 0, borderColor: state.borderColor,
          borderHoverColor: state.borderHoverColor,
          textDecoration: state.underline ? "underline" : "none",
          hoverTextDecoration: state.hoverUnderline ? "underline" : "none",
          radius: state.radius, paddingY: state.paddingY,
          fontSize: state.fontSize, fontWeight: state.fontWeight,
        }
      : {
          bg: state[`${prefix}Bg`], text: state[`${prefix}Text`],
          hoverBg: state[`${prefix}HoverBg`], hoverText: state[`${prefix}HoverText`],
          borderWidth: state[`${prefix}BorderEnabled`] ? state[`${prefix}BorderWidth`] : 0,
          borderColor: state[`${prefix}BorderColor`],
          borderHoverColor: state[`${prefix}BorderHoverColor`],
          textDecoration: state[`${prefix}Underline`] ? "underline" : "none",
          hoverTextDecoration: state[`${prefix}HoverUnderline`] ? "underline" : "none",
          radius: state[`${prefix}Radius`], paddingY: state[`${prefix}PaddingY`],
          fontSize: state[`${prefix}FontSize`], fontWeight: state[`${prefix}FontWeight`],
        };

    const buildCss = () => {
      const accept = buttonValues("accept");
      const deny = buttonValues("deny");
      const details = buttonValues("details");
      return `#CookieBanner {\n  --cb-accent: ${state.accent};\n  --cb-accept-bg: ${accept.bg};\n  --cb-accept-text: ${accept.text};\n  --cb-accept-hover-bg: ${accept.hoverBg};\n  --cb-accept-hover-text: ${accept.hoverText};\n  --cb-accept-border-width: ${accept.borderWidth}px;\n  --cb-accept-border-color: ${accept.borderColor};\n  --cb-accept-border-hover-color: ${accept.borderHoverColor};\n  --cb-accept-text-decoration: ${accept.textDecoration};\n  --cb-accept-hover-text-decoration: ${accept.hoverTextDecoration};\n  --cb-accept-radius: ${accept.radius}px;\n  --cb-accept-padding-y: ${accept.paddingY}px;\n  --cb-accept-font-size: ${accept.fontSize}px;\n  --cb-accept-font-weight: ${accept.fontWeight};\n  --cb-deny-bg: ${deny.bg};\n  --cb-deny-text: ${deny.text};\n  --cb-deny-hover-bg: ${deny.hoverBg};\n  --cb-deny-hover-text: ${deny.hoverText};\n  --cb-deny-border-width: ${deny.borderWidth}px;\n  --cb-deny-border-color: ${deny.borderColor};\n  --cb-deny-border-hover-color: ${deny.borderHoverColor};\n  --cb-deny-text-decoration: ${deny.textDecoration};\n  --cb-deny-hover-text-decoration: ${deny.hoverTextDecoration};\n  --cb-deny-radius: ${deny.radius}px;\n  --cb-deny-padding-y: ${deny.paddingY}px;\n  --cb-deny-font-size: ${deny.fontSize}px;\n  --cb-deny-font-weight: ${deny.fontWeight};\n  --cb-details-display: block;\n  --cb-details-bg: ${details.bg};\n  --cb-details-text: ${details.text};\n  --cb-details-hover-bg: ${details.hoverBg};\n  --cb-details-hover-text: ${details.hoverText};\n  --cb-details-border-width: ${details.borderWidth}px;\n  --cb-details-border-color: ${details.borderColor};\n  --cb-details-border-hover-color: ${details.borderHoverColor};\n  --cb-details-text-decoration: ${details.textDecoration};\n  --cb-details-hover-text-decoration: ${details.hoverTextDecoration};\n  --cb-details-radius: ${details.radius}px;\n  --cb-details-padding-y: ${details.paddingY}px;\n  --cb-details-font-size: ${details.fontSize}px;\n  --cb-details-font-weight: ${details.fontWeight};\n  --cb-text-color: ${state.textColor};\n  --cb-dialog-bg: ${state.dialogBg};\n  --cb-overlay: ${rgba(state.overlayColor, state.overlayOpacity)};\n  --cb-dialog-padding: ${state.dialogPadding}px;\n  --cb-dialog-radius: ${state.dialogRadius}px;\n  --cb-title-font-size-desktop: ${state.titleFontSize}px;\n  --cb-title-font-weight: ${state.titleFontWeight};\n  --cb-description-font-size-desktop: ${state.descriptionFontSize}px;\n  --cb-content-spacing: ${state.contentSpacing}px;\n  --cb-preference-bg: ${state.preferenceBg};\n  --cb-title-align: ${state.titleAlign};\n  --cb-description-align: ${state.descriptionAlign};\n}\n\n${baseCss}`;
    };
    const buildSelectionCss = () => {
      const selection = buttonValues("selection");
      return `\n#CookieBanner {\n  --cb-selection-bg: ${selection.bg};\n  --cb-selection-text: ${selection.text};\n  --cb-selection-hover-bg: ${selection.hoverBg};\n  --cb-selection-hover-text: ${selection.hoverText};\n  --cb-selection-border-width: ${selection.borderWidth}px;\n  --cb-selection-border-color: ${selection.borderColor};\n  --cb-selection-border-hover-color: ${selection.borderHoverColor};\n  --cb-selection-text-decoration: ${selection.textDecoration};\n  --cb-selection-hover-text-decoration: ${selection.hoverTextDecoration};\n  --cb-selection-radius: ${selection.radius}px;\n  --cb-selection-padding-y: ${selection.paddingY}px;\n  --cb-selection-font-size: ${selection.fontSize}px;\n  --cb-selection-font-weight: ${selection.fontWeight};\n}\n`;
    };
    const buildToggleCss = () =>
      `\n#CookieBanner {\n  --cb-toggle-off: ${state.toggleOffTrack};\n  --cb-toggle-off-handle: ${state.toggleOffHandle};\n  --cb-toggle-on: ${state.toggleOnTrack};\n  --cb-toggle-on-handle: ${state.toggleOnHandle};\n  --cb-toggle-denied: ${state.toggleDeniedTrack};\n  --cb-toggle-denied-handle: ${state.toggleDeniedHandle};\n}\n`;

    // WCAG relative luminance + contrast ratio
    const lum = (hex) => {
      const h = hex.replace("#", "");
      const n = h.length === 3 ? h.split("").map((c) => c + c).join("") : h;
      const c = [0, 2, 4].map((i) => {
        const v = parseInt(n.slice(i, i + 2), 16) / 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
    };
    const ratio = (a, b) => {
      const l1 = lum(a), l2 = lum(b);
      return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
    };
    const isHex = (v) => /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v);
    const rgbaValue = (hex, opacity) => {
      const value = hex.replace("#", "");
      const full = value.length === 3 ? value.split("").map((character) => character + character).join("") : value;
      return `rgba(${parseInt(full.slice(0, 2), 16)}, ${parseInt(full.slice(2, 4), 16)}, ${parseInt(full.slice(4, 6), 16)}, ${opacity / 100})`;
    };
    const rgba = rgbaValue;

    const checkContrast = () => {
      const setMessage = (element, messages) => {
        element.textContent = messages.join(" ");
        element.hidden = messages.length === 0;
      };
      if (state.buttonMode === "same") {
        const values = buttonValues("accept");
        const messages = [];
        const normal = ratio(values.bg, values.text);
        const hover = ratio(values.hoverBg, values.hoverText);
        if (normal < 4.5) messages.push(fmt(copy.buttonContrast, normal));
        if (hover < 4.5) messages.push(fmt(copy.hoverContrast, hover));
        setMessage(root.querySelector('[data-contrast="same"]'), messages);
      } else {
        ["accept", "deny", "details", "selection"].forEach((name) => {
          const messages = [];
          const values = buttonValues(name);
          const normal = ratio(values.bg, values.text);
          const hover = ratio(values.hoverBg, values.hoverText);
          if (normal < 4.5) messages.push(fmt(copy.textContrast, normal));
          if (hover < 4.5) messages.push(fmt(copy.hoverContrast, hover));
          setMessage(root.querySelector(`[data-contrast="${name}"]`), messages);
        });
      }
      root.querySelectorAll("[data-contrast]").forEach((element) => {
        if (element.closest("[data-button-panel]")?.hidden) element.hidden = true;
      });
      const bodyMessages = [];
      const rText = ratio(state.textColor, state.dialogBg);
      if (rText < 4.5) bodyMessages.push(fmt(copy.bodyContrast, rText));
      setMessage(bodyContrast, bodyMessages);
    };

    const refresh = () => {
      const accept = buttonValues("accept");
      const deny = buttonValues("deny");
      const details = buttonValues("details");
      const selection = buttonValues("selection");
      applyVar("--cb-accent", state.accent);
      const unitValue = (key, value) => ["borderWidth", "radius", "paddingY", "fontSize"].includes(key) ? `${value}px` : value;
      Object.entries(accept).forEach(([key, value]) => applyVar(`--cb-accept-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`, unitValue(key, value)));
      Object.entries(deny).forEach(([key, value]) => applyVar(`--cb-deny-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`, unitValue(key, value)));
      Object.entries(details).forEach(([key, value]) => applyVar(`--cb-details-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`, unitValue(key, value)));
      Object.entries(selection).forEach(([key, value]) => applyVar(`--cb-selection-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`, unitValue(key, value)));
      applyVar("--cb-details-display", "block");
      applyVar("--cb-text-color", state.textColor);
      applyVar("--cb-dialog-bg", state.dialogBg);
      applyVar("--cb-overlay", rgbaValue(state.overlayColor, state.overlayOpacity));
      applyVar("--cb-dialog-padding", `${state.dialogPadding}px`);
      applyVar("--cb-dialog-radius", `${state.dialogRadius}px`);
      applyVar("--cb-title-font-size-mobile", `${state.titleFontSize}px`);
      applyVar("--cb-title-font-size-desktop", `${state.titleFontSize}px`);
      applyVar("--cb-title-font-weight", state.titleFontWeight);
      applyVar("--cb-description-font-size-mobile", `${state.descriptionFontSize}px`);
      applyVar("--cb-description-font-size-desktop", `${state.descriptionFontSize}px`);
      applyVar("--cb-content-spacing", `${state.contentSpacing}px`);
      applyVar("--cb-preference-bg", state.preferenceBg);
      applyVar("--cb-toggle-off", state.toggleOffTrack);
      applyVar("--cb-toggle-off-handle", state.toggleOffHandle);
      applyVar("--cb-toggle-on", state.toggleOnTrack);
      applyVar("--cb-toggle-on-handle", state.toggleOnHandle);
      applyVar("--cb-toggle-denied", state.toggleDeniedTrack);
      applyVar("--cb-toggle-denied-handle", state.toggleDeniedHandle);
      applyVar("--cb-title-align", state.titleAlign);
      applyVar("--cb-description-align", state.descriptionAlign);
      cssOut.value = buildCss() + buildSelectionCss() + buildToggleCss();
      checkContrast();
      localStorage.setItem(storageKey, JSON.stringify(state));
    };

    // colour inputs (+ synced hex fields)
    root.querySelectorAll('input[type="color"]').forEach((input) => {
      const key = input.name;
      const hex = root.querySelector(`[data-hex-for="${input.id}"]`);
      input.addEventListener("input", () => { state[key] = input.value; if (hex) hex.value = input.value; refresh(); });
      if (hex) hex.addEventListener("input", () => {
        if (isHex(hex.value)) { input.value = hex.value.length === 4 ? hex.value : hex.value; state[key] = input.value; refresh(); }
      });
    });

    // radio controls
    root.querySelectorAll('input[type="radio"]').forEach((input) => {
      input.addEventListener("change", () => {
        if (input.checked) {
          state[input.name] = input.value;
          syncButtonPanels();
          refresh();
        }
      });
    });

    const syncButtonPanels = () => {
      root.querySelector('[data-button-panel="same"]').hidden = state.buttonMode !== "same";
      root.querySelectorAll('[data-button-panel]:not([data-button-panel="same"])').forEach((panel) => { panel.hidden = state.buttonMode !== "separate"; });
    };

    root.querySelectorAll('input[type="checkbox"]').forEach((input) => {
      input.addEventListener("change", () => { state[input.name] = input.checked; syncBorderControls(); refresh(); });
    });
    root.querySelectorAll('input[type="number"]').forEach((input) => {
      input.addEventListener("input", () => { state[input.name] = Math.max(Number(input.min), Math.min(Number(input.max), Number(input.value) || 0)); refresh(); });
    });
    root.querySelectorAll("select").forEach((select) => {
      select.addEventListener("change", () => { state[select.name] = select.value; refresh(); });
    });

    const syncBorderControls = () => {
      ["", "accept", "deny", "details", "selection"].forEach((prefix) => {
        const enabledKey = prefix ? `${prefix}BorderEnabled` : "borderEnabled";
        const panel = prefix || "same";
        root.querySelectorAll(`[data-border-setting="${panel}"]`).forEach((el) => el.classList.toggle("is-disabled", !state[enabledKey]));
        root.querySelectorAll(`[data-button-panel="${panel}"] input[name$="BorderWidth"], [data-button-panel="${panel}"] input[name$="BorderColor"], [data-button-panel="${panel}"] input[name$="BorderHoverColor"], [data-button-panel="${panel}"] input[name="borderWidth"], [data-button-panel="${panel}"] input[name="borderColor"], [data-button-panel="${panel}"] input[name="borderHoverColor"]`).forEach((input) => { input.disabled = !state[enabledKey]; });
        root.querySelectorAll(`[data-button-panel="${panel}"] [data-hex-for*="border-color"], [data-button-panel="${panel}"] [data-hex-for*="border-hover-color"]`).forEach((input) => { input.disabled = !state[enabledKey]; });
      });
    };

    const syncKeys = (keys) => {
      keys.forEach((key) => {
        root.querySelectorAll(`[name="${key}"]`).forEach((control) => {
          if (control.type === "radio") control.checked = control.value === state[key];
          else if (control.type === "checkbox") control.checked = state[key];
          else control.value = state[key];
          if (control.type === "color") {
            const hex = root.querySelector(`[data-hex-for="${control.id}"]`);
            if (hex) hex.value = state[key];
          }
        });
      });
    };
    const resetKeys = (keys) => {
      keys.forEach((key) => { state[key] = defaults[key]; });
      syncKeys(keys);
      syncButtonPanels();
      syncBorderControls();
      refresh();
    };

    const sharedButtonKeys = ["accent", "buttonText", "hoverBg", "hoverText", "borderEnabled", "borderWidth", "borderColor", "borderHoverColor", "underline", "hoverUnderline", "radius", "paddingY", "fontSize", "fontWeight"];
    const resetScopes = {
      same: sharedButtonKeys,
      accept: Object.keys(defaults).filter((key) => key.startsWith("accept")),
      deny: Object.keys(defaults).filter((key) => key.startsWith("deny")),
      details: Object.keys(defaults).filter((key) => key.startsWith("details")),
      selection: Object.keys(defaults).filter((key) => key.startsWith("selection")),
      banner: ["dialogBg", "overlayColor", "overlayOpacity", "dialogPadding", "dialogRadius", "titleFontSize", "titleFontWeight", "descriptionFontSize", "contentSpacing", "preferenceBg"],
      toggles: ["toggleOffTrack", "toggleOffHandle", "toggleOnTrack", "toggleOnHandle", "toggleDeniedTrack", "toggleDeniedHandle"],
      alignment: ["titleAlign", "descriptionAlign"],
      colours: ["accent", "textColor"],
    };
    root.querySelectorAll("[data-reset-scope]").forEach((button) => {
      button.addEventListener("click", () => resetKeys(resetScopes[button.dataset.resetScope]));
    });
    root.querySelector("#cbs-reset").addEventListener("click", () => resetKeys(Object.keys(defaults)));
    root.querySelectorAll("[data-copy-style]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = button.dataset.copyStyle;
        const targetKeys = [];
        Object.keys(defaults).filter((key) => key.startsWith("accept")).forEach((sourceKey) => {
          const targetKey = `${target}${sourceKey.slice("accept".length)}`;
          state[targetKey] = state[sourceKey];
          targetKeys.push(targetKey);
        });
        syncKeys(targetKeys);
        syncBorderControls();
        refresh();
      });
    });

    const setPreviewSize = (size) => {
      const mobile = size === "mobile";
      frame.classList.toggle("is-mobile", mobile);
      frame.title = copy.previewTitle.replace("{size}", mobile ? copy.mobile : copy.desktop);
      frame.contentDocument?.documentElement.classList.toggle("preview-desktop", !mobile);
      root.querySelectorAll(".cbs__preview-size").forEach((item) => {
        const active = item.dataset.previewSize === size;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    };
    root.querySelectorAll(".cbs__preview-size").forEach((button) => {
      button.addEventListener("click", () => {
        state.previewSize = button.dataset.previewSize;
        setPreviewSize(state.previewSize);
        refresh();
      });
    });

    // tabs
    root.querySelectorAll(".cbs__tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        root.querySelectorAll(".cbs__tab").forEach((t) => { t.classList.toggle("is-active", t === tab); t.setAttribute("aria-selected", String(t === tab)); });
        root.querySelectorAll(".cbs__panel").forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
      });
    });

    // copy buttons
    root.querySelectorAll(".cbs__copy").forEach((btn) => {
      const label = btn.textContent;
      btn.addEventListener("click", () => {
        const el = document.getElementById(btn.dataset.copy);
        navigator.clipboard.writeText(el.value);
        btn.textContent = copy.copied;
        setTimeout(() => (btn.textContent = label), 1500);
      });
    });

    // preview may not be ready on first paint
    frame.addEventListener("load", () => { setPreviewSize(state.previewSize); refresh(); });
    root.querySelectorAll("[name]").forEach((control) => {
      if (!(control.name in state)) return;
      if (control.type === "radio") control.checked = control.value === state[control.name];
      else if (control.type === "checkbox") control.checked = state[control.name];
      else control.value = state[control.name];
      if (control.type === "color") {
        const hex = root.querySelector(`[data-hex-for="${control.id}"]`);
        if (hex) hex.value = state[control.name];
      }
    });
    setPreviewSize(state.previewSize);
    syncButtonPanels();
    syncBorderControls();
    refresh();
  }
</script>

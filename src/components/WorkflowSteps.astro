---
import BlogImage from "./BlogImage.astro";

interface Props {
  id: string;
  label: string;
  steps: { label: string; title: string; description: string; outcome: string; image: string; imageAlt: string }[];
  outcomeLabel?: string;
  previousLabel?: string;
  nextLabel?: string;
  imageCredit?: string;
}

const { id, label, steps, outcomeLabel = "Output", previousLabel = "Previous step", nextLabel = "Next step", imageCredit } = Astro.props;
---

<workflow-steps class="workflow" aria-label={label}>
  <div class="workflow__navigation" hidden>
  <div class="workflow__tabs">
    {steps.map((step, index) => (
      <button type="button" id={`${id}-tab-${index}`} data-step={index}>
        <span class="workflow__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span>{step.label}</span>
        <span class="workflow__tab-arrow" aria-hidden="true">↗</span>
      </button>
    ))}
  </div>
  <div class="workflow__progress" role="progressbar" aria-label={label} aria-valuemin="1" aria-valuemax={steps.length} aria-valuenow="1">
    {steps.map(() => <span aria-hidden="true"></span>)}
  </div>
  </div>
  <div class="workflow__panels">
    {steps.map((step, index) => (
      <section class="workflow__panel" id={`${id}-panel-${index}`} aria-labelledby={`${id}-title-${index}`}>
        <figure class="workflow__figure">
          <BlogImage src={step.image} alt={step.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
          {imageCredit && <figcaption>{imageCredit}</figcaption>}
        </figure>
        <div class="workflow__copy">
          <h3 id={`${id}-title-${index}`}>{step.title}</h3>
          <p>{step.description}</p>
          <dl class="workflow__outcome"><dt>{outcomeLabel}</dt><dd>{step.outcome}</dd></dl>
        </div>
      </section>
    ))}
  </div>
  <div class="workflow__controls" hidden>
    <span class="workflow__position" aria-hidden="true"></span>
    <div class="workflow__arrows">
      <button type="button" data-previous aria-label={previousLabel}><span aria-hidden="true">←</span></button>
      <button type="button" data-next aria-label={nextLabel}><span aria-hidden="true">→</span></button>
    </div>
  </div>
</workflow-steps>

<script>
  class WorkflowSteps extends HTMLElement {
    wideLayout = matchMedia("(min-width: 768px)");
    updateOrientation = () => {
      this.querySelector(".workflow__tabs")?.setAttribute("aria-orientation", this.wideLayout.matches ? "vertical" : "horizontal");
    };

    disconnectedCallback() {
      this.wideLayout.removeEventListener("change", this.updateOrientation);
    }

    connectedCallback() {
      this.wideLayout.addEventListener("change", this.updateOrientation);
      this.updateOrientation();
      if (this.dataset.ready) return;
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-step]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>(".workflow__panel"));
      const tablist = this.querySelector<HTMLElement>(".workflow__tabs")!;
      const progress = this.querySelector<HTMLElement>(".workflow__progress")!;
      const segments = Array.from(progress.children);
      const controls = this.querySelector<HTMLElement>(".workflow__controls")!;
      const previous = this.querySelector<HTMLButtonElement>("[data-previous]")!;
      const next = this.querySelector<HTMLButtonElement>("[data-next]")!;
      if (!tabs.length) return;
      let current = 0;
      const select = (index: number, focus = false) => {
        current = index;
        tabs.forEach((tab, i) => {
          tab.setAttribute("aria-selected", String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i].hidden = i !== index;
        });
        previous.disabled = index === 0;
        next.disabled = index === tabs.length - 1;
        progress.setAttribute("aria-valuenow", String(index + 1));
        segments.forEach((segment, i) => segment.classList.toggle("is-reached", i <= index));
        this.querySelector(".workflow__position")!.textContent = `${String(index + 1).padStart(2, "0")} / ${String(tabs.length).padStart(2, "0")}`;
        if (focus) tabs[index].focus({ preventScroll: true });
        if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          panels[index].getAnimations().forEach((animation) => animation.cancel());
          panels[index].animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 180, easing: "ease-out" });
        }
      };
      tablist.setAttribute("role", "tablist");
      tablist.setAttribute("aria-label", this.getAttribute("aria-label") || "Workflow");
      tabs.forEach((tab, index) => {
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panels[index].id);
        panels[index].setAttribute("role", "tabpanel");
        panels[index].setAttribute("aria-labelledby", tab.id);
        panels[index].tabIndex = 0;
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          let target = index;
          if (event.key === (this.wideLayout.matches ? "ArrowDown" : "ArrowRight")) target = (index + 1) % tabs.length;
          else if (event.key === (this.wideLayout.matches ? "ArrowUp" : "ArrowLeft")) target = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") target = 0;
          else if (event.key === "End") target = tabs.length - 1;
          else return;
          event.preventDefault();
          select(target, true);
        });
      });
      previous.addEventListener("click", () => select(Math.max(0, current - 1), true));
      next.addEventListener("click", () => select(Math.min(tabs.length - 1, current + 1), true));
      this.dataset.ready = "true";
      this.querySelector<HTMLElement>(".workflow__navigation")!.hidden = false;
      controls.hidden = false;
      select(0);
    }
  }
  if (!customElements.get("workflow-steps")) customElements.define("workflow-steps", WorkflowSteps);
</script>

<style>
  .workflow { display: block; min-width: 0; overflow: clip; border: 1px solid var(--line); border-radius: var(--radius-xl); background: var(--color-surface); }
  .workflow [hidden] { display: none; }
  .workflow__navigation { border-bottom: 1px solid var(--line); }
  .workflow__tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; padding: 0.75rem; }
  .workflow__progress { display: flex; gap: 0.5rem; margin: 0 0.75rem 1rem; }
  .workflow__progress span { flex: 1; height: 3px; border-radius: var(--radius-pill); background: var(--line); }
  .workflow__progress .is-reached { background: var(--ink); }
  .workflow button { font: inherit; font-weight: var(--font-weight-medium); cursor: pointer; border: 1px solid transparent; border-radius: var(--radius-md); color: var(--ink); background: transparent; min-height: 48px; }
  .workflow__tabs button { display: flex; justify-content: center; align-items: center; gap: 0.65rem; padding: 0.75rem; }
  .workflow__tabs button[aria-selected="true"] { background: var(--pop); color: var(--color-neutral-950); border-color: color-mix(in srgb, var(--color-neutral-950) 20%, transparent); font-weight: var(--font-weight-bold); }
  .workflow button:hover:not(:disabled) { border-color: var(--ink); }
  .workflow button:active:not(:disabled) { transform: scale(0.98); }
  .workflow :is(button, [role="tabpanel"]):focus-visible { outline: var(--focus-ring); outline-offset: -4px; }
  .workflow__number { font-size: var(--font-size-ui-sm); font-variant-numeric: tabular-nums; }
  .workflow__tab-arrow { display: none; }
  .workflow__panels { display: grid; }
  .workflow[data-ready] .workflow__panel { grid-area: 1 / 1; }
  /* Inactive panels reserve the tallest step's space without exposing its content. */
  .workflow[data-ready] .workflow__panel[hidden] { display: grid; visibility: hidden; pointer-events: none; }
  .workflow__panel { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.5rem; padding: clamp(1rem, 3cqi, 2rem); margin: 0; }
  .workflow__figure { margin: 0; min-width: 0; }
  .workflow__figure :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-md); }
  .workflow__figure figcaption { margin-top: 0.5rem; color: var(--muted); font-size: var(--font-size-ui-xs); }
  .workflow__copy h3 { margin: 0; font-size: clamp(1.65rem, 3.5cqi, 2.4rem); line-height: 1.15; }
  .workflow__copy p { margin: 1rem 0 1.5rem; max-width: 42ch; color: var(--muted); }
  .workflow__outcome { margin: 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .workflow__outcome dt { font-weight: var(--font-weight-bold); font-size: var(--font-size-ui-sm); }
  .workflow__outcome dd { margin: 0.35rem 0 0; }
  .workflow__controls { display: flex; align-items: center; justify-content: space-between; padding: 1rem clamp(1rem, 3cqi, 2rem); border-top: 1px solid var(--line); }
  .workflow__position { color: var(--muted); font-variant-numeric: tabular-nums; font-size: var(--font-size-ui-sm); }
  .workflow__arrows { display: flex; gap: 0.5rem; }
  .workflow__arrows button { width: 48px; border-color: var(--line); background: var(--bg); font-size: 1.4rem; }
  .workflow button:disabled { opacity: 0.4; cursor: default; }
  @media (min-width: 768px) {
    .workflow[data-ready] { display: grid; grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr); }
    .workflow__navigation { grid-column: 1; grid-row: 1 / 3; display: grid; align-content: center; padding: clamp(1rem, 3cqi, 2rem); border-bottom: 0; border-right: 1px solid var(--line); }
    .workflow__tabs { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; padding: 0; }
    .workflow__progress { margin: 1.75rem 0 0; }
    .workflow__tabs button { justify-content: start; gap: 1rem; min-height: 76px; padding: 1rem 1.25rem; color: var(--muted); font-size: clamp(1.05rem, 2.2cqi, 1.4rem); font-weight: var(--font-weight-body); }
    .workflow__tabs button[aria-selected="true"] { background: var(--bg); color: var(--ink); border-color: var(--line); font-weight: var(--font-weight-medium); }
    .workflow__number { font-size: inherit; }
    .workflow__tab-arrow { display: block; margin-left: auto; color: var(--ink); opacity: 0.22; }
    .workflow__tabs button[aria-selected="true"] .workflow__tab-arrow { opacity: 1; }
    .workflow__tabs button:hover:not(:disabled) { border-color: var(--line); }
    .workflow__tabs button[aria-selected="false"]:hover:not(:disabled) { border-color: transparent; }
    .workflow__tabs button[aria-selected="false"]:hover .workflow__tab-arrow { opacity: 0.65; }
    .workflow__panels { grid-column: 2; min-width: 0; }
    .workflow__panel { gap: 1.25rem; }
    .workflow__figure :global(img) { aspect-ratio: 12 / 5; max-height: 15rem; }
    .workflow__copy h3 { font-size: clamp(1.4rem, 2.5cqi, 1.8rem); line-height: 1.2; }
    .workflow__copy p { margin: 0.75rem 0 1rem; max-width: 50ch; }
    .workflow__controls { grid-column: 2; }
  }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .workflow__tab-arrow { transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-snap); }
    .workflow__tabs button:hover .workflow__tab-arrow { transform: translate(3px, -3px); }
  }
  @media (max-width: 767px) {
    .workflow__panel { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .workflow__tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .workflow__tabs button { justify-content: start; padding: 0.6rem; gap: 0.4rem; }
  }
</style>

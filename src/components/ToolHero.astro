---
const { title, summary } = Astro.props;
---

<section class="about tool-hero wide-band">
  <div><h1>{title}</h1></div>
  <div>
    {summary && <p class="tool-hero__lead">{summary}</p>}
    <slot />
  </div>
</section>

<style>
  .tool-hero__lead {
    margin-top: 0;
    color: var(--ink);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .tool-hero :global(.tool-note) {
    max-width: 58ch;
    color: var(--muted);
  }
</style>

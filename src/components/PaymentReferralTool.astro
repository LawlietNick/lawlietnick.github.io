---
import { groups, rows, services } from "../data/payment-referrals.js";
import { fi } from "../data/payment-referrals.fi.js";
import { en } from "../data/payment-referrals.en.js";

// Texts come from one language file per language, with the same keys
const { lang = "fi" } = Astro.props;
const t = lang === "en" ? en : fi;
const copyIcon = `<svg class="pr__i pr__i-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><svg class="pr__i pr__i-done" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
const fill = (text, values) => text.replace(/\{(\w+)\}/g, (_, key) => values[key]);
const config = { script: { ...t.script, ownTag: t.own.tag, exampleTag: t.own.exampleTag, skipped: t.own.skipped }, example: t.own.example };
---

<div class="pr" data-payment-referrals>
  <script type="application/json" data-pr-config set:html={JSON.stringify(config).replace(/</g, "\\u003c")} />

  <section class="pr__panel" aria-labelledby="pr-own">
    <h2 id="pr-own">{t.own.title}</h2>
    <p class="pr__hint" set:html={t.own.hintHtml} />
    <label class="pr__field">
      <span class="pr__label">{t.own.label}</span>
      <textarea rows="4" data-own-input placeholder={t.own.placeholder} autocomplete="off" spellcheck="false"></textarea>
    </label>
    <p class="pr__hint" set:html={t.own.mergeHintHtml} />
    <p class="pr__status" role="status" data-own-status></p>
  </section>

  <section class="pr__panel" aria-labelledby="pr-use">
    <h2 id="pr-use">{t.use.title}</h2>
    <p class="pr__hint">{t.use.hint}</p>
    <fieldset class="pr__uses">
      <legend class="pr__sr">{t.use.legend}</legend>
      <label class="pr__use"><input type="checkbox" data-own-use checked /> <span>{t.use.own}</span></label>
      {
        Object.entries(services).map(([key, label]) => (
          <label class="pr__use"><input type="checkbox" value={key} data-service checked /> <span>{label}</span></label>
        ))
      }
    </fieldset>
  </section>

  <section class="pr__panel" aria-labelledby="pr-list">
    <h2 id="pr-list">{t.list.title}</h2>
    <p class="pr__hint" set:html={t.list.hintHtml} />
    <div class="pr__bar">
      <button type="button" class="pr__copy" data-merge-all>{t.list.mergeAll}</button>
      <p class="pr__status" role="status" data-status></p>
    </div>
    <p class="pr__warn" role="status" data-limit></p>
    <div class="pr__tablewrap">
      <table class="pr__table">
        <thead>
          <tr>
            <th scope="col">{t.list.colDone}</th>
            <th scope="col">{t.list.colMatch}</th>
            <th scope="col">{t.list.colValue}</th>
            <th scope="col"><span class="pr__sr">{t.list.colCopy}</span></th>
          </tr>
        </thead>
        <tbody data-own-rows>
          <tr class="pr__grouphead" data-own-head>
            <th scope="colgroup" colspan="4">
              <div class="pr__headrow">
                <span class="pr__groupname">{t.own.title}</span>
                <span class="pr__groupcount" data-own-count></span>
              </div>
            </th>
          </tr>
        </tbody>
        {
          groups.map((key) => (
            <tbody data-group={key} data-group-label={t.groups[key]}>
              {rows
                .filter((r) => r.group === key)
                .map((r) => (
                  <tr data-row-service={r.service} data-match={r.match} data-default-group={key}>
                    <td>
                      <span class="pr__handle" data-handle draggable="true" title={t.list.handleTitle} aria-hidden="true">⋮⋮</span>
                      <input type="checkbox" data-done value={r.value} aria-label={fill(t.list.doneAria, { value: r.value })} />
                    </td>
                    <td>{t.matchLabels[r.match]}</td>
                    <td>
                      <code>{r.value}</code>
                      {r.service && <span class="pr__tag">{services[r.service]}</span>}
                      <label class="pr__move">
                        <span>{t.list.groupLabel}</span>
                        <select data-move aria-label={fill(t.list.moveAria, { value: r.value })}></select>
                      </label>
                    </td>
                    <td><button type="button" class="pr__copy" data-value={r.value} aria-label={fill(t.list.copyAria, { value: r.value })} set:html={copyIcon}></button></td>
                  </tr>
                ))}
            </tbody>
          ))
        }
      </table>
    </div>
    <button type="button" class="pr__newgroup" data-new-group>{t.list.newGroup} <span>{t.list.newGroupHint}</span></button>

    <template data-chrome>
      <tr class="pr__grouphead">
        <th scope="colgroup" colspan="4">
          <div class="pr__headrow">
            <span class="pr__groupname" data-group-name></span>
            <input type="text" class="pr__groupinput" data-group-input aria-label={t.list.groupNameAria} autocomplete="off" hidden />
            <span class="pr__groupcount" data-group-count></span>
            <label class="pr__merge">
              <input type="checkbox" data-merge />
              <span>{t.list.merge}</span>
            </label>
            <button type="button" class="pr__copy" data-remove-group hidden>{t.list.removeGroup}</button>
          </div>
        </th>
      </tr>
      <tr class="pr__merged" data-merged hidden>
        <td><input type="checkbox" data-done value="" aria-label={t.list.mergedDoneAria} /></td>
        <td>{t.matchLabels.regex}</td>
        <td>
          <code data-merged-code></code>
          <span class="pr__tag" data-merged-tag></span>
        </td>
        <td><button type="button" class="pr__copy" data-value="" data-merged-copy aria-label={t.list.mergedCopyAria} set:html={copyIcon}></button></td>
      </tr>
      <tr class="pr__emptyrow" data-empty hidden>
        <td colspan="4">{t.list.emptyGroup}</td>
      </tr>
    </template>
  </section>

  <section class="pr__panel" aria-labelledby="pr-big">
    <h2 id="pr-big">{t.big.title}</h2>
    <p class="pr__hint" set:html={t.big.hintHtml} />
    <label class="pr__field">
      <span class="pr__label">{t.big.maxLabel}</span>
      <input type="number" min="100" step="100" inputmode="numeric" data-big-max placeholder={t.big.maxPlaceholder} />
    </label>
    <p class="pr__hint">{t.big.limitHint}</p>
    <p class="pr__status" role="status" data-big-status></p>
    <ol class="pr__bigs" data-big></ol>
  </section>

  <section class="pr__panel" aria-labelledby="pr-steps">
    <h2 id="pr-steps">{t.steps.title}</h2>
    <ol class="pr__steps">
      {t.steps.itemsHtml.map((item) => <li set:html={item} />)}
    </ol>
    <p class="pr__hint">{t.steps.rule}</p>
  </section>
</div>

<script>
  import { bigRegexes, ga4RowLimit, ownDomainRows } from "../utils/referral-exclusions.js";

  const init = () => {
    document.querySelectorAll("[data-payment-referrals]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";

      const { script: ui, example: exampleText } = JSON.parse(root.querySelector("[data-pr-config]").textContent);
      const fmt = (text, values) => text.replace(/\{(\w+)\}/g, (_, key) => values[key]);

      const status = root.querySelector("[data-status]");
      const ownStatus = root.querySelector("[data-own-status]");
      const ownBody = root.querySelector("[data-own-rows]");
      const ownUse = root.querySelector("[data-own-use]");
      const ownCount = () => (ownUse.checked ? ownBody.querySelectorAll("[data-own-row]").length : 0);
      const table = root.querySelector(".pr__table");
      const chrome = root.querySelector("[data-chrome]");

      // Both the done marks and the group layout are remembered in this browser only
      const read = (key, fallback) => {
        try {
          return JSON.parse(localStorage.getItem(key) ?? "") ?? fallback;
        } catch {
          return fallback;
        }
      };
      const write = (key, value) => {
        try {
          localStorage.setItem(key, JSON.stringify(value));
        } catch {}
      };
      const doneKey = "referral-exclusions-done";
      const groupsKey = "referral-exclusions-groups";
      const done = new Set(read(doneKey, []));
      const mark = (tr) => {
        const box = tr.querySelector("[data-done]");
        box.checked = done.has(box.value);
        tr.classList.toggle("pr__done", box.checked);
      };

      const rowsText = (n) => (n === 1 ? ui.rowOne : fmt(ui.rowMany, { n }));
      const bodies = () => [...root.querySelectorAll("tbody[data-group]")];
      const bodyOf = (id) => bodies().find((body) => body.dataset.group === id);
      const items = () => [...root.querySelectorAll("tr[data-match]")];
      const itemRows = (body) => [...body.querySelectorAll("tr[data-match]")];
      const shownRows = (body) => itemRows(body).filter((tr) => !tr.hidden);
      const valueOf = (tr) => tr.querySelector("[data-value]").dataset.value;
      const rowOf = (tr) => ({ match: tr.dataset.match, value: valueOf(tr) });
      const isCustom = (body) => "custom" in body.dataset;

      // Every group, ready-made or the user's own, gets the same header, merged row and empty row
      const setupChrome = (body) => {
        body.prepend(chrome.content.cloneNode(true));
        const name = body.querySelector("[data-group-name]");
        name.textContent = body.dataset.groupLabel;
        if (isCustom(body)) {
          const input = body.querySelector("[data-group-input]");
          input.value = body.dataset.groupLabel;
          input.hidden = false;
          name.hidden = true;
          body.querySelector("[data-remove-group]").hidden = false;
        }
      };
      const makeBody = (id, label) => {
        const body = document.createElement("tbody");
        body.dataset.group = id;
        body.dataset.groupLabel = label;
        body.dataset.custom = "";
        setupChrome(body);
        table.append(body);
        return body;
      };
      const addGroup = () => {
        const used = bodies().filter(isCustom).map((body) => Number(body.dataset.group.split("-")[1]));
        const n = Math.max(0, ...used) + 1;
        return makeBody(`custom-${n}`, fmt(ui.customGroup, { n }));
      };

      const saveGroups = () => {
        write(groupsKey, {
          custom: bodies().filter(isCustom).map((body) => ({ id: body.dataset.group, name: body.dataset.groupLabel })),
          assign: Object.fromEntries(
            items()
              .filter((tr) => tr.closest("tbody").dataset.group !== tr.dataset.defaultGroup)
              .map((tr) => [valueOf(tr), tr.closest("tbody").dataset.group])
          ),
        });
      };

      const syncSelects = () => {
        const list = bodies();
        items().forEach((tr) => {
          const current = tr.closest("tbody").dataset.group;
          const select = tr.querySelector("[data-move]");
          select.replaceChildren(
            ...list.map((body) => {
              const option = document.createElement("option");
              option.value = body.dataset.group;
              option.textContent = body.dataset.groupLabel;
              return option;
            })
          );
          select.value = current;
        });
      };

      // A merged section hides its rows and shows one regex row in their place
      const refreshGroups = () => {
        bodies().forEach((body) => {
          const merge = body.querySelector("[data-merge]").checked;
          const visible = shownRows(body);
          const merged = body.querySelector("[data-merged]");
          itemRows(body).forEach((tr) => tr.classList.toggle("pr__collapsed", merge));
          body.querySelector("[data-group-count]").textContent = rowsText(visible.length);
          body.querySelector("[data-empty]").hidden = itemRows(body).length > 0;
          merged.hidden = !(merge && visible.length);
          if (merged.hidden) return;
          const value = bigRegexes(visible.map(rowOf))[0];
          merged.querySelector("[data-merged-code]").textContent = value;
          merged.querySelector("[data-merged-tag]").textContent = fmt(ui.mergedTag, { group: body.dataset.groupLabel, n: visible.length, chars: value.length });
          merged.querySelector("[data-merged-copy]").dataset.value = value;
          merged.querySelector("[data-done]").value = value;
          mark(merged);
        });
        const all = bodies().every((body) => body.querySelector("[data-merge]").checked);
        root.querySelector("[data-merge-all]").textContent = all ? ui.unmergeAll : ui.mergeAll;
      };

      const count = () => {
        const own = ownCount();
        let list = 0;
        let before = 0;
        bodies().forEach((body) => {
          const visible = shownRows(body).length;
          before += visible;
          list += body.querySelector("[data-merge]").checked ? Math.min(visible, 1) : visible;
        });
        const gaRows = own + list;
        const added = root.querySelectorAll("tbody tr:not([hidden]):not(.pr__collapsed) [data-done]:checked").length;
        status.textContent = fmt(ui.status, { ga: gaRows, own, list, before, added });
        root.querySelector("[data-limit]").textContent =
          gaRows > ga4RowLimit
            ? fmt(ui.limitWarning, { ga: gaRows, limit: ga4RowLimit })
            : "";
      };

      // One big regex from the visible list rows; own domains stay rows of their own
      const copyIcon = `<svg class="pr__i pr__i-copy" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><svg class="pr__i pr__i-done" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
      const bigList = root.querySelector("[data-big]");
      const bigStatus = root.querySelector("[data-big-status]");
      const renderBig = () => {
        const max = Number(root.querySelector("[data-big-max]").value) || Infinity;
        const listRows = bodies().flatMap((body) => shownRows(body).map(rowOf));
        const chunks = bigRegexes(listRows, { maxLength: max });
        const gaRows = ownCount() + chunks.length;
        bigStatus.textContent = chunks.length
          ? fmt(ui.bigStatus, {
              rows: listRows.length,
              chunks: chunks.length,
              chars: chunks.reduce((sum, c) => sum + c.length, 0),
              ga: gaRows,
              limit: ga4RowLimit,
              over: gaRows > ga4RowLimit ? ui.bigOver : "",
            })
          : ui.bigEmpty;
        bigList.replaceChildren(
          ...chunks.map((chunk) => {
            const li = document.createElement("li");
            li.className = "pr__big";
            const code = document.createElement("code");
            code.className = "pr__bigcode";
            code.textContent = chunk;
            const meta = document.createElement("div");
            meta.className = "pr__bigmeta";
            const length = document.createElement("span");
            length.textContent = fmt(ui.bigLength, { n: chunk.length }) + (chunk.length > max ? ui.bigLengthOver : "");
            const button = document.createElement("button");
            button.type = "button";
            button.className = "pr__copy";
            button.dataset.value = chunk;
            button.setAttribute("aria-label", fmt(ui.bigCopyAria, { n: chunk.length }));
            button.innerHTML = copyIcon;
            const label = document.createElement("span");
            label.textContent = ui.copy;
            button.append(label);
            meta.append(length, button);
            li.append(code, meta);
            return li;
          })
        );
      };

      const update = () => {
        refreshGroups();
        count();
        renderBig();
      };
      const filter = () => {
        const on = new Set([...root.querySelectorAll("[data-service]:checked")].map((i) => i.value));
        root.querySelectorAll("[data-row-service]").forEach((tr) => {
          tr.hidden = !on.has(tr.dataset.rowService);
        });
        update();
      };
      // Any change of the group layout: selects, saved layout and counts follow
      const layoutChanged = () => {
        syncSelects();
        saveGroups();
        update();
      };
      const moveRow = (tr, body) => {
        if (!body || tr.closest("tbody") === body) return;
        body.append(tr);
        layoutChanged();
      };
      const removeGroup = (body) => {
        itemRows(body).forEach((tr) => (bodyOf(tr.dataset.defaultGroup) ?? bodies()[0]).append(tr));
        body.remove();
        layoutChanged();
      };

      // Own domains: the label cell copies the wording of the merged rows
      const matchLabel = chrome.content.querySelector("[data-merged] td:nth-child(2)")?.textContent ?? "";
      // Without own domains the list shows an example row (yritys.fi) that is not counted and cannot be copied
      const buildOwnRow = (value, example) => {
        const tr = document.createElement("tr");
        tr.dataset[example ? "ownExample" : "ownRow"] = "";
        const doneCell = document.createElement("td");
        const box = document.createElement("input");
        box.type = "checkbox";
        box.value = value;
        box.dataset.done = "";
        box.disabled = example;
        box.setAttribute("aria-label", fmt(ui.doneAria, { value }));
        doneCell.append(box);
        const label = document.createElement("td");
        label.textContent = matchLabel;
        const cell = document.createElement("td");
        const code = document.createElement("code");
        code.textContent = value;
        const tag = document.createElement("span");
        tag.className = "pr__tag";
        tag.textContent = example ? ui.exampleTag : ui.ownTag;
        cell.append(code, tag);
        const action = document.createElement("td");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "pr__copy";
        button.disabled = example;
        // an empty data-value gives the example the same icon-button look without anything to copy
        button.dataset.value = example ? "" : value;
        button.setAttribute("aria-label", fmt(ui.copyAria, { value }));
        button.innerHTML = copyIcon;
        action.append(button);
        tr.append(doneCell, label, cell, action);
        if (!example) mark(tr);
        return tr;
      };
      const renderOwn = () => {
        const { rows: own, skipped } = ownDomainRows(root.querySelector("[data-own-input]").value);
        ownBody.querySelectorAll("[data-own-row], [data-own-example]").forEach((tr) => tr.remove());
        const shown = own.length ? own.map((value) => buildOwnRow(value, false)) : ownDomainRows(exampleText).rows.map((value) => buildOwnRow(value, true));
        ownBody.append(...shown);
        ownStatus.textContent = skipped.length ? fmt(ui.skipped, { list: skipped.join(", ") }) : "";
        showOwn();
      };
      // The own section is on by default and leaves the list and the counts when "Omat domainit" is unchecked
      const showOwn = () => {
        const rows = [...ownBody.querySelectorAll("[data-own-row]")];
        const use = ownUse.checked;
        ownBody.querySelector("[data-own-head]").hidden = !use;
        ownBody.querySelector("[data-own-count]").textContent = rowsText(rows.length);
        ownBody.querySelectorAll("[data-own-row], [data-own-example]").forEach((tr) => (tr.hidden = !use));
        count();
        renderBig();
      };

      root.addEventListener("input", (event) => {
        const target = event.target;
        if (target.matches("[data-service]")) filter();
        if (target.matches("[data-merge]")) update();
        if (target.matches("[data-big-max]")) renderBig();
        if (target.matches("[data-own-input]")) renderOwn();
        if (target.matches("[data-own-use]")) showOwn();
        if (target.matches("[data-move]")) moveRow(target.closest("tr"), bodyOf(target.value));
        if (target.matches("[data-group-input]")) {
          target.closest("tbody").dataset.groupLabel = target.value.trim() || ui.groupFallback;
          layoutChanged();
        }
        if (target.matches("[data-done]")) {
          done[target.checked ? "add" : "delete"](target.value);
          write(doneKey, [...done]);
          mark(target.closest("tr"));
          count();
        }
      });

      // The button itself says it was copied for a moment, then goes back to its own label
      const flash = (button) => {
        clearTimeout(button.flashTimer);
        button.classList.add("pr__copied");
        button.flashTimer = setTimeout(() => button.classList.remove("pr__copied"), 1800);
      };

      root.addEventListener("click", async (event) => {
        const target = event.target;
        if (target.closest("[data-merge-all]")) {
          const boxes = bodies().map((body) => body.querySelector("[data-merge]"));
          const next = !boxes.every((box) => box.checked);
          boxes.forEach((box) => (box.checked = next));
          update();
          return;
        }
        if (target.closest("[data-new-group]")) {
          const body = addGroup();
          layoutChanged();
          body.querySelector("[data-group-input]").focus();
          return;
        }
        const remove = target.closest("[data-remove-group]");
        if (remove) {
          removeGroup(remove.closest("tbody"));
          return;
        }
        const button = target.closest("[data-value]");
        if (!button) return;
        const value = button.dataset.value;
        const isBig = Boolean(button.closest("[data-big]"));
        const message = isBig ? bigStatus : status;
        try {
          await navigator.clipboard.writeText(value);
          flash(button);
          message.textContent = isBig || value.length > 120 ? fmt(ui.copiedRegex, { n: value.length }) : fmt(ui.copied, { value });
        } catch {
          message.textContent = ui.copyFailed;
        }
      });

      // Drag and drop (mouse): the handle drags its row onto a group or onto "new group".
      // Keyboard and touch use the group select in every row.
      let dragged = null;
      const dropTarget = (event) => {
        const el = event.target instanceof Element ? event.target : event.target.parentElement;
        return el?.closest("tbody[data-group], [data-new-group]") ?? null;
      };
      const clearDrop = () => root.querySelectorAll(".pr__dropping").forEach((el) => el.classList.remove("pr__dropping"));
      root.addEventListener("dragstart", (event) => {
        const handle = event.target instanceof Element ? event.target.closest("[data-handle]") : null;
        if (!handle) return;
        dragged = handle.closest("tr");
        event.dataTransfer.effectAllowed = "move";
        event.dataTransfer.setData("text/plain", valueOf(dragged));
        event.dataTransfer.setDragImage(dragged, 16, 16);
        dragged.classList.add("pr__dragging");
      });
      root.addEventListener("dragover", (event) => {
        const target = dropTarget(event);
        if (!dragged || !target) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = "move";
        clearDrop();
        target.classList.add("pr__dropping");
      });
      root.addEventListener("dragleave", (event) => {
        if (!root.contains(event.relatedTarget)) clearDrop();
      });
      root.addEventListener("drop", (event) => {
        const target = dropTarget(event);
        if (!dragged || !target) return;
        event.preventDefault();
        const row = dragged;
        clearDrop();
        moveRow(row, target.matches("[data-new-group]") ? addGroup() : target);
      });
      root.addEventListener("dragend", () => {
        dragged?.classList.remove("pr__dragging");
        dragged = null;
        clearDrop();
      });

      // Start-up: ready-made groups get their chrome, the saved layout is applied, then everything is drawn
      bodies().forEach(setupChrome);
      const saved = read(groupsKey, { custom: [], assign: {} });
      (saved.custom ?? []).forEach(({ id, name }) => {
        if (/^custom-\d+$/.test(id) && !bodyOf(id)) makeBody(id, String(name || ui.groupFallback));
      });
      items().forEach((tr) => {
        const body = bodyOf(saved.assign?.[valueOf(tr)]);
        if (body) body.append(tr);
      });
      items().forEach(mark);
      syncSelects();
      filter();
      renderOwn();
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style is:global>

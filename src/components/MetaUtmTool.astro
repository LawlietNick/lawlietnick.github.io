  .mu__compshead .field-hint { margin: 0.25rem 0 0; }
  /* the separator and lowercase controls have their own row between the heading and the components */
  .mu__levelopts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: flex-end; margin-bottom: 1rem; }

---
import { directory, en, formats, kinds, metaDocsChecked, metaDocsUrl, platforms, tactics, terms } from "../data/meta-utm.js";
import { fi } from "../data/meta-utm.fi.js";
import { levelKeys, library, templates } from "../data/meta-naming.js";
import { tableRows } from "../utils/meta-utm.js";

// Texts come from one language file per language, with the same keys. The page renders in
// Finnish; applyLanguage can swap every [data-i18n] text and the JavaScript-built rows.
const bare = (macro) => macro.replace(/[{}]/g, "");
const i = (key) => ({ "data-i18n": key });
const ia = (pairs) => ({ "data-i18n-attr": Object.entries(pairs).map(([attr, key]) => `${attr}:${key}`).join(";") });

const checkedDate = (locale) => new Intl.DateTimeFormat(locale, { day: "numeric", month: locale === "fi-FI" ? "numeric" : "long", year: "numeric", timeZone: "UTC" }).format(new Date(metaDocsChecked));

const forLang = (copy, locale) => {
  const items = directory.map((entry) => ({
    ...entry,
    ...copy.entries[entry.id],
    platformLabel: entry.platform ? copy.platforms[entry.platform] : "",
    variable: bare(entry.macro ?? entry.value),
    shown: entry.example ?? entry.value,
    isExample: Boolean(entry.example),
  }));
  return {
    ui: { ...copy.ui, checkedOn: copy.ui.checkedOn.replace("{date}", checkedDate(locale)) },
    kinds: copy.kinds,
    params: copy.params,
    terms: copy.terms,
    naming: copy.naming,
    utm: copy.utm,
    page: copy.page,
    faq: copy.faq,
    encoding: copy.encoding,
    selects: {
      tactic: tactics.map((v) => [v, copy.tactics[v]]),
      format: formats.map((v) => [v, copy.formats[v]]),
    },
    items: tableRows(items, platforms),
  };
};
// The page renders in one language: "fi" (default) or "en". Both sets of copy are in the config so
// applyLanguage can swap them.
const { locale = "fi" } = Astro.props;
const config = { langs: { fi: forLang(fi, "fi-FI"), en: forLang(en, "en-GB") }, library, templates };
const t = config.langs[locale];
const selects = t.selects;

const combo = (id, key, label, code, labelKey) => ({ id, key, label, code, labelKey, first: selects[key][0] });
const mediumPresets = ["paidsocial", "paid_social", "cpc"];
const levelLabel = (key) => t.naming.levels[key];
// "Kampanja (Campaign)": the part in brackets gets its own span, which narrow screens hide
const levelParts = (key) => { const [, main, sub] = levelLabel(key).match(/^(.*?)(?:\s*(\([^)]*\)))?$/); return { main, sub }; };
const separators = [["_", "_"], ["-", "-"], ["|", "|"], ["/", "/"], [" ", t.naming.sepSpace], ["", t.naming.sepNone]];
---

<div class="mu" data-meta-utm lang={locale} data-locale={locale}>
  <script type="application/json" data-mu-config set:html={JSON.stringify(config).replace(/</g, "\\u003c")} />

  <dialog class="mu__dialog" data-custom-dialog aria-labelledby="mu-dialog-title">
    <form method="dialog" class="mu__dialogform" data-custom-form>
      <div class="mu__dialoghead">
        <h3 id="mu-dialog-title" {...i("naming.customToggle")}>{t.naming.customToggle}</h3>
        <button type="button" class="mu__remove" data-custom-close aria-label={t.naming.close} {...ia({ "aria-label": "naming.close" })}>✕</button>
      </div>
      <label class="mu__field">
        <span class="field-label" {...i("naming.customKey")}>{t.naming.customKey}</span>
        <input class="field" type="text" data-custom-key autocomplete="off" spellcheck="false" />
        <span class="field-hint" {...i("naming.customKeyHint")}>{t.naming.customKeyHint}</span>
      </label>
      <label class="mu__field">
        <span class="field-label" {...i("naming.customLabel")}>{t.naming.customLabel}</span>
        <input class="field" type="text" data-custom-label autocomplete="off" />
      </label>
      <div class="mu__field">
        <label class="field-label" data-custom-type-label {...i("naming.customType")}>{t.naming.customType}</label>
        <div data-custom-type-host></div>
      </div>
      <label class="mu__field" data-custom-allowed-group hidden>
        <span class="field-label" {...i("naming.customAllowed")}>{t.naming.customAllowed}</span>
        <input class="field" type="text" data-custom-allowed autocomplete="off" spellcheck="false" />
        <span class="field-hint" {...i("naming.customAllowedHint")}>{t.naming.customAllowedHint}</span>
      </label>
      <p class="field-error" id="mu-custom-error" data-custom-error role="alert" hidden></p>
      <div class="mu__dialogact">
        <button type="button" class="cta cta--secondary" data-custom-cancel><span class="cta__surface" {...i("naming.customCancel")}>{t.naming.customCancel}</span></button>
        <button type="button" class="cta cta--primary" data-custom-save><span class="cta__surface" {...i("naming.customSave")}>{t.naming.customSave}</span></button>
      </div>
    </form>
  </dialog>

  <dialog class="mu__dialog" data-confirm-dialog aria-labelledby="mu-confirm-title" aria-describedby="mu-confirm-body">
    <form method="dialog" class="mu__dialogform" data-confirm-form>
      <div class="mu__dialoghead">
        <h3 id="mu-confirm-title" data-confirm-title></h3>
      </div>
      <p id="mu-confirm-body" data-confirm-body></p>
      <div class="mu__dialogact">
        <button type="button" class="cta cta--secondary" data-confirm-cancel><span class="cta__surface" {...i("naming.tpl.cancel")}>{t.naming.tpl.cancel}</span></button>
        <button type="button" class="cta cta--primary" data-confirm-ok><span class="cta__surface" data-confirm-ok-text></span></button>
      </div>
    </form>
  </dialog>

  <div class="mu__frame">
  <div class="mu__stepbar">
    <div class="mu__steptabs" role="tablist" aria-label={t.ui.stepsLabel} {...ia({ "aria-label": "ui.stepsLabel" })}>
      <button type="button" role="tab" id="mu-steptab-naming" aria-controls="mu-step-naming" aria-selected="true" data-step-btn="naming"><span class="mu__num" aria-hidden="true">1</span><span {...i("ui.stepNaming")}>{t.ui.stepNaming}</span></button>
      <button type="button" role="tab" id="mu-steptab-utm" aria-controls="mu-step-utm" aria-selected="false" tabindex="-1" data-step-btn="utm"><span class="mu__num" aria-hidden="true">2</span><span {...i("ui.stepUtm")}>{t.ui.stepUtm}</span></button>
    </div>
  </div>

  <!-- Step 1: naming convention -->
  <div class="mu__view mu__naming" data-step="naming" id="mu-step-naming" role="tabpanel" aria-labelledby="mu-steptab-naming">
    <header class="mu__head">
      <div>
        <p class="mu__eyebrow" {...i("naming.step")}>{t.naming.step}</p>
        <h2 {...i("naming.title")}>{t.naming.title}</h2>
        <p class="mu__intro" {...i("naming.intro")}>{t.naming.intro}</p>
      </div>
      <button type="button" class="cta cta--primary" data-continue><span class="cta__surface" {...i("naming.continue")}>{t.naming.continue}</span></button>
    </header>

    <section class="mu__picker" data-tpl-picker aria-labelledby="mu-tpl-title">
      <h3 class="mu__tpltitle" id="mu-tpl-title" tabindex="-1" {...i("naming.tpl.title")}>{t.naming.tpl.title}</h3>
      <div class="mu__termcards mu__tplcards" role="radiogroup" aria-labelledby="mu-tpl-title" data-tpl-cards></div>
      <button type="button" class="mu__link mu__tpltoggle" data-tpl-toggle aria-expanded="false"></button>
      <div class="mu__tplpreview" data-tpl-preview aria-live="polite"></div>
      <div class="mu__act">
        <button type="button" class="cta cta--primary" data-tpl-use disabled><span class="cta__surface" {...i("naming.tpl.use")}>{t.naming.tpl.use}</span></button>
        <button type="button" class="cta cta--secondary" data-tpl-cancel hidden><span class="cta__surface" {...i("naming.tpl.cancel")}>{t.naming.tpl.cancel}</span></button>
      </div>
    </section>

    <div class="mu__tplbar" data-tpl-bar hidden>
      <p class="mu__tplname" role="status"><strong data-tpl-name tabindex="-1"></strong><span data-tpl-edited hidden><span aria-hidden="true"> · </span><span {...i("naming.tpl.edited")}>{t.naming.tpl.edited}</span></span></p>
      <div class="mu__tplactions">
        <button type="button" class="btn-quiet" data-tpl-reset hidden {...i("naming.tpl.reset")}>{t.naming.tpl.reset}</button>
        <button type="button" class="btn-quiet" data-tpl-change {...i("naming.tpl.change")}>{t.naming.tpl.change}</button>
      </div>
    </div>

    <div class="mu__tabbox" data-tpl-builder hidden>
    <div class="mu__tabs" role="tablist" aria-label={t.naming.levelsLabel} {...ia({ "aria-label": "naming.levelsLabel" })}>
      {levelKeys.map((key, n) => <button type="button" role="tab" id={`mu-tab-${key}`} aria-controls="mu-levelpanel" aria-selected={n === 0 ? "true" : "false"} tabindex={n === 0 ? 0 : -1} data-level-btn={key}>{n + 1}. {levelParts(key).main}{levelParts(key).sub && <span class="mu__tabsub"> {levelParts(key).sub}</span>}</button>)}
    </div>

    <div class="mu__build mu__levelpanel" id="mu-levelpanel" role="tabpanel" aria-labelledby="mu-tab-campaign" tabindex="0">
      <div class="mu__leftcol">
      <section class="surface mu__panel mu__comps" aria-labelledby="mu-comps-heading">
        <div class="panel-heading mu__compshead">
          <div>
            <h3 class="panel-heading__title" id="mu-comps-heading" data-comps-heading></h3>
            <p class="field-hint" {...i("naming.componentsHint")}>{t.naming.componentsHint}</p>
          </div>
        </div>

        <div class="mu__levelopts">
          <div class="mu__sepgroup">
            <span class="field-label" {...i("naming.separatorLabel")}>{t.naming.separatorLabel}</span>
            <div class="segmented" role="group" aria-label={t.naming.separatorLabel} {...ia({ "aria-label": "naming.separatorLabel" })}>
              {separators.map(([value, shown]) => <button type="button" data-sep-btn={value} aria-pressed="false">{shown}</button>)}
            </div>
          </div>
          <label class="mu__check"><input type="checkbox" data-lowercase /><span {...i("naming.lowercase")}>{t.naming.lowercase}</span></label>
        </div>

        <ul class="mu__complist" data-comps></ul>

        <div class="mu__add">
          <div class="mu__field mu__addselect" data-library></div>
          <button type="button" class="btn-quiet btn-quiet--dashed" data-custom-open {...i("naming.customToggle")}>{t.naming.customToggle}</button>
        </div>
      </section>
      <div class="notice mu__validation" data-validation role="status"></div>
      </div>

      <aside class="surface mu__panel mu__result" aria-label={t.naming.resultTitle} {...ia({ "aria-label": "naming.resultTitle" })}>
        <h3 class="field-label" id="mu-formula-label" {...i("naming.formulaTitle")}>{t.naming.formulaTitle}</h3>
        <output class="code-output mu__out" data-formula tabindex="0" aria-labelledby="mu-formula-label"></output>
        <div class="mu__linkrow">
          <button type="button" class="mu__link" data-copy-formula>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            <span {...i("naming.copyFormula")}>{t.naming.copyFormula}</span>
          </button>
        </div>

        <h3 class="field-label mu__gap" id="mu-example-label" {...i("naming.exampleTitle")}>{t.naming.exampleTitle}</h3>
        <output class="code-output mu__out" data-example tabindex="0" aria-labelledby="mu-example-label"></output>
        <div class="mu__act mu__exampleact">
          <button type="button" class="cta cta--secondary" data-copy-example><span class="cta__surface" {...i("naming.copyExample")}>{t.naming.copyExample}</span></button>
        </div>
        <p class="mu__status" role="status" data-naming-status></p>

        <h3 class="field-label mu__gap" {...i("naming.overviewTitle")}>{t.naming.overviewTitle}</h3>
        <dl class="mu__overview" data-overview></dl>
      </aside>
    </div>
    </div>
  </div>

  <!-- Step 2: UTM builder -->
  <div class="mu__view" data-step="utm" id="mu-step-utm" role="tabpanel" aria-labelledby="mu-steptab-utm" hidden>
    <header class="mu__head">
      <div>
        <p class="mu__eyebrow" {...i("utm.step")}>{t.utm.step}</p>
        <h2 id="mu-build" {...i("ui.buildTitle")}>{t.ui.buildTitle}</h2>
      </div>
    </header>
    <div class="notice mu__banner" data-banner></div>

  <div class="mu__build">
  <section class="surface mu__panel mu__choices-card" aria-labelledby="mu-build">
    <fieldset class="mu__choices">
      <legend {...i("ui.trackingLegend")}>{t.ui.trackingLegend}</legend>

      <div class="mu__field" role="radiogroup" aria-labelledby="mu-mode-label">
        <span class="field-label" id="mu-mode-label" {...i("ui.modeLegend")}>{t.ui.modeLegend}</span>
        <div class="mu__termcards">
          {
            ["new", "published"].map((key, n) => (
              <label class="mu__termcard">
                <span class="mu__termtop">
                  <span class="mu__termname" {...i(`ui.mode.${key}`)}>{t.ui.mode[key]}</span>
                  <input type="radio" name="mu-mode" value={key} data-mode checked={n === 0} />
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="mu__published" data-published-group hidden>
        <button type="button" class="mu__link mu__linkstart" data-open-naming {...i("ui.namingLink")}>{t.ui.namingLink}</button>
        {
          [["campaign", "utm_campaign"], ["term", "utm_term"], ["content", "utm_content"]].map(([key, param]) => (
            <label class="mu__field">
              <span class="field-label"><span {...i(`ui.fixed.${key}`)}>{t.ui.fixed[key]}</span> <code>{param}</code></span>
              <input class="field mu__mono" type="text" {...{ [`data-fixed-${key}`]: "" }} placeholder={t.ui.fixedPlaceholder} {...ia({ placeholder: "ui.fixedPlaceholder" })} autocomplete="off" spellcheck="false" />
            </label>
          ))
        }
      </div>

      {
        [combo("mu-tactic", "tactic", t.ui.tacticLabel, "utm_marketing_tactic", "ui.tacticLabel"), combo("mu-format", "format", t.ui.formatLabel, "utm_creative_format", "ui.formatLabel")].map((c) => (
          <div class="mu__field">
            <label class="field-label" for={c.id}><span {...i(c.labelKey)}>{c.label}</span> <code>{c.code}</code></label>
            <div class="combobox">
              <div class="combobox__control">
                <input class="field combobox__input" id={c.id} role="combobox" readonly aria-haspopup="listbox" aria-controls={`${c.id}-menu`} aria-expanded="false" type="text" value={c.first[1]} data-value={c.first[0]} data-select={c.key} {...{ [`data-${c.key}`]: "" }} />
                <button class="combobox__toggle" type="button" tabindex="-1" aria-label={t.ui.listToggle} {...ia({ "aria-label": "ui.listToggle" })} aria-controls={`${c.id}-menu`} aria-expanded="false" data-select-toggle={c.key}>
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>
                </button>
              </div>
              <div class="combobox__menu" hidden id={`${c.id}-menu`} role="listbox" aria-label={c.label} {...ia({ "aria-label": c.labelKey })} data-select-menu={c.key}></div>
            </div>
          </div>
        ))
      }

      <label class="mu__field" data-tactic-custom-group hidden>
        <span class="visually-hidden" {...i("ui.tacticCustomLabel")}>{t.ui.tacticCustomLabel}</span>
        <input class="field" type="text" data-tactic-custom placeholder={t.ui.tacticCustomPlaceholder} {...ia({ placeholder: "ui.tacticCustomPlaceholder" })} autocomplete="off" spellcheck="false" />
      </label>

      <div class="mu__field" role="radiogroup" aria-labelledby="mu-term-label" data-term-group>
        <span class="field-label" id="mu-term-label"><span {...i("ui.termLegend")}>{t.ui.termLegend}</span> <code>utm_term</code></span>
        <div class="mu__termcards">
          {
            Object.keys(terms).map((key, n) => (
              <label class="mu__termcard">
                <span class="mu__termtop">
                  <span class="mu__termname" {...i(`terms.${key}.label`)}>{t.terms[key].label}</span>
                  <input type="radio" name="mu-term" value={key} data-term checked={n === 0} />
                </span>
                <code class="mu__termchip" {...(terms[key] ? {} : i("ui.noTermChip"))}>{terms[key] || t.ui.noTermChip}</code>
                <span class="mu__termnote" {...i(`terms.${key}.card`)}>{t.terms[key].card}</span>
              </label>
            ))
          }
        </div>
        <p class="field-hint" data-term-effect aria-live="polite"></p>
      </div>
    </fieldset>
  </section>

    <div class="surface mu__panel mu__result">
      <p class="field-label" id="mu-output-label" {...i("ui.outputTitle")}>{t.ui.outputTitle}</p>
      <output class="code-output mu__out" data-out tabindex="0" aria-labelledby="mu-output-label"></output>
      <div class="mu__act">
        <button type="button" class="cta cta--primary" data-copy><span class="cta__surface" {...i("ui.copy")}>{t.ui.copy}</span></button>
        <p class="mu__status" role="status" data-copy-status></p>
      </div>
      <details class="mu__parts" open>
        <summary {...i("ui.partsSummary")}>{t.ui.partsSummary}</summary>
        <div class="mu__tablewrap">
          <table class="mu__table mu__parttable" role="table" aria-label={t.ui.partsSummary} {...ia({ "aria-label": "ui.partsSummary" })}>
            <colgroup><col class="mu__col-partvar" /><col class="mu__col-partvalue" /></colgroup>
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col" {...i("ui.colVariable")}>{t.ui.colVariable}</th>
                <th role="columnheader" scope="col" {...i("ui.colValue")}>{t.ui.colValue}</th>
              </tr>
            </thead>
            <tbody role="rowgroup" data-parts></tbody>
          </table>
        </div>
      </details>
      <div class="mu__place">
        <p class="mu__placetitle" {...i("ui.placeTitle")}>{t.ui.placeTitle}</p>
        <p {...i("ui.placeBody")}>{t.ui.placeBody}</p>
      </div>
    </div>

    <details class="surface mu__panel mu__advanced">
      <summary {...i("ui.advancedSummary")}>{t.ui.advancedSummary}</summary>
      <p class="field-hint" {...i("ui.advancedHint")}>{t.ui.advancedHint}</p>
      <div class="mu__field">
        <div class="mu__mediumhead">
          <label class="field-label" for="mu-medium"><span {...i("ui.mediumLabel")}>{t.ui.mediumLabel}</span> <code>utm_medium</code></label>
          <span class="mu__muted" {...i("ui.mediumHint")}>{t.ui.mediumHint}</span>
        </div>
        <div class="mu__chips" role="group" aria-label={t.ui.mediumLabel} {...ia({ "aria-label": "ui.mediumLabel" })}>
          {mediumPresets.map((v) => (
            <button type="button" class="mu__chip" data-medium-preset={v} aria-pressed="false">{v}{v === mediumPresets[0] && <span class="mu__chipnote" {...i("ui.recommended")}>{t.ui.recommended}</span>}</button>
          ))}
          <button type="button" class="mu__chip mu__chip--text" data-medium-preset="custom" aria-pressed="false" {...i("ui.mediumCustom")}>{t.ui.mediumCustom}</button>
        </div>
        <input class="field mu__mono" id="mu-medium" type="text" data-medium value="paidsocial" autocomplete="off" spellcheck="false" />
      </div>
      <label class="mu__field">
        <span class="field-label"><span {...i("ui.platformLabel")}>{t.ui.platformLabel}</span> <code>utm_source_platform</code></span>
        <input class="field" type="text" data-platform value="Meta Ads" autocomplete="off" spellcheck="false" />
      </label>
    </details>
  </div>

  <section class="surface mu__panel" aria-labelledby="mu-preview">
    <h2 id="mu-preview" {...i("ui.previewTitle")}>{t.ui.previewTitle}</h2>
    <p class="field-hint" {...i("ui.previewNote")}>{t.ui.previewNote}</p>
    <div class="mu__urlcard"><code class="mu__url" data-url aria-label={t.ui.urlLabel} {...ia({ "aria-label": "ui.urlLabel" })}></code></div>
    <ul class="mu__legend">
      <li><span class="mu__swatch mu__swatch--base"></span><span {...i("ui.legendBase")}>{t.ui.legendBase}</span></li>
      <li><span class="mu__swatch mu__swatch--sep"></span><span {...i("ui.legendSep")}>{t.ui.legendSep}</span></li>
      <li><span class="mu__swatch mu__swatch--key"></span><span {...i("ui.legendKey")}>{t.ui.legendKey}</span></li>
      {kinds.map((k) => <li><span class={`mu__swatch mu__swatch--${k}`}></span><span {...i(`kinds.${k}.label`)}>{t.kinds[k].label}</span></li>)}
    </ul>
    <dl class="mu__kinds">
      {kinds.map((k) => (
        <div>
          <dt><span class={`mu__tag mu__tag--${k}`} {...i(`kinds.${k}.label`)}>{t.kinds[k].label}</span></dt>
          <dd {...i(`kinds.${k}.hint`)}>{t.kinds[k].hint}</dd>
        </div>
      ))}
    </dl>
    <ul class="mu__rows" data-preview></ul>

  </section>

  <section class="surface mu__panel" aria-labelledby="mu-dir">
    <h2 id="mu-dir" {...i("ui.directoryTitle")}>{t.ui.directoryTitle}</h2>
    <p class="mu__intro" {...i("ui.directoryIntro")}>{t.ui.directoryIntro}</p>
    <div data-dir-controls>
      <label class="mu__field mu__search">
        <span class="field-label" {...i("ui.searchLabel")}>{t.ui.searchLabel}</span>
        <input class="field" type="search" data-search placeholder={t.ui.searchPlaceholder} {...ia({ placeholder: "ui.searchPlaceholder" })} autocomplete="off" spellcheck="false" />
      </label>
    </div>
    <p class="mu__status" role="status" data-count></p>
    <div class="mu__tablewrap">
      <table class="mu__table" role="table" aria-label={t.ui.directoryTitle} {...ia({ "aria-label": "ui.directoryTitle" })}>
        <colgroup><col class="mu__col-var" /><col class="mu__col-value" /><col class="mu__col-note" /></colgroup>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col" {...i("ui.colVariable")}>{t.ui.colVariable}</th>
            <th role="columnheader" scope="col" {...i("ui.colValue")}>{t.ui.colValue}</th>
            <th role="columnheader" scope="col" {...i("ui.colNote")}>{t.ui.colNote}</th>
          </tr>
        </thead>
        <tbody role="rowgroup" data-dir></tbody>
      </table>
    </div>
    <p class="mu__empty" data-empty hidden {...i("ui.resultNone")}>{t.ui.resultNone}</p>
  </section>

  <section class="surface mu__panel" aria-labelledby="mu-tech">
    <h2 id="mu-tech" {...i("ui.techTitle")}>{t.ui.techTitle}</h2>
    <h3 class="mu__sub" {...i("ui.faqTitle")}>{t.ui.faqTitle}</h3>
    <div class="mu__faq">
      {
        t.faq.map((item, n) => (
          <details>
            <summary {...i(`faq.${n}.q`)}>{item.q}</summary>
            {item.a.map((p, j) => <p {...i(`faq.${n}.a.${j}`)}>{p}</p>)}
          </details>
        ))
      }
    </div>
    <h3 class="mu__sub" {...i("ui.encodingTitle")}>{t.ui.encodingTitle}</h3>
    {t.encoding.map((p, n) => <p class="mu__note" {...i(`encoding.${n}`)}>{p}</p>)}
    <p class="mu__source">
      <span {...i("ui.sourceLine")}>{t.ui.sourceLine}</span>: <a href={metaDocsUrl} rel="noopener">facebook.com/business/help/2360940870872492</a>, <span {...i("ui.checkedOn")}>{t.ui.checkedOn}</span>.
    </p>
  </section>
  </div>
  </div>
</div>

<script>
  import { initSelectCombobox } from "../scripts/select-combobox.js";
  import { filterDirectory, metaUtm, metaUtmParts, previewRows } from "../utils/meta-utm.js";
  import { addComponent, cleanKey, example, formula, levelKeys, levelsFromTemplate, move, newLevels, sameStructure, setLowercase, setSeparator, startValue, validate } from "../utils/meta-naming.js";

  const el = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  };
  const get = (object, path) => path.split(".").reduce((value, key) => value?.[key], object);

  // The same combobox as the two in the UTM step, built with JavaScript for rows that come and go.
  // options: [[value, label]]. text overrides what the input shows (for a placeholder).
  let comboSeq = 0;
  const makeCombobox = ({ options, value, label, toggleLabel, text, onSelect }) => {
    const id = `mu-combo-${++comboSeq}`;
    const root = el("div", "combobox");
    const control = el("div", "combobox__control");
    const input = el("input", "field combobox__input");
    const toggle = el("button", "combobox__toggle");
    const menu = el("div", "combobox__menu");
    const labelOf = (list, v) => list.find(([key]) => key === v)?.[1] ?? v;

    input.id = id;
    input.type = "text";
    input.readOnly = true;
    input.autocomplete = "off";
    input.setAttribute("role", "combobox");
    input.setAttribute("aria-haspopup", "listbox");
    input.setAttribute("aria-controls", `${id}-menu`);
    input.setAttribute("aria-expanded", "false");
    input.setAttribute("aria-label", label);
    input.dataset.value = value;
    input.value = text ?? labelOf(options, value);

    toggle.type = "button";
    toggle.tabIndex = -1;
    toggle.setAttribute("aria-label", toggleLabel);
    toggle.setAttribute("aria-controls", `${id}-menu`);
    toggle.setAttribute("aria-expanded", "false");
    toggle.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>';

    menu.id = `${id}-menu`;
    menu.hidden = true;
    menu.setAttribute("role", "listbox");
    menu.setAttribute("aria-label", label);

    control.append(input, toggle);
    root.append(control, menu);
    // Escape closes an open list first; without this a combobox inside the dialog would close the dialog too
    input.addEventListener("keydown", (event) => { if (event.key === "Escape" && !menu.hidden) { event.stopPropagation(); event.preventDefault(); } });
    initSelectCombobox(input, toggle, menu, options, () => onSelect(input.dataset.value));

    return {
      root,
      input,
      set(next) {
        input.dataset.value = next;
        input.value = labelOf(options, next);
        menu.querySelectorAll(".combobox__option").forEach((option) => option.setAttribute("aria-selected", String(option.dataset.value === next)));
      },
      relabel(next, nextLabel, nextToggleLabel) {
        options = next;
        menu.querySelectorAll(".combobox__option").forEach((option) => (option.querySelector(".combobox__name").textContent = labelOf(next, option.dataset.value)));
        input.value = labelOf(next, input.dataset.value);
        input.setAttribute("aria-label", nextLabel);
        menu.setAttribute("aria-label", nextLabel);
        toggle.setAttribute("aria-label", nextToggleLabel);
      },
    };
  };

  const mediumPresets = ["paidsocial", "paid_social", "cpc"];

  const initMetaUtmTools = () => {
    document.querySelectorAll("[data-meta-utm]").forEach((root) => {
      // astro:page-load also fires on first load, and the router may restore a
      // page that is already set up: never bind the same elements twice.
      if (root.dataset.ready) return;
      root.dataset.ready = "true";

      const config = JSON.parse(root.querySelector("[data-mu-config]").textContent);
      const library = Object.fromEntries(Object.entries(config.library).map(([key, def]) => [key, { ...def }]));
      const levels = newLevels();
      const selects = ["tactic", "format"];
      const q = (selector) => root.querySelector(selector);
      const qa = (selector) => [...root.querySelectorAll(selector)];

      let lang = root.dataset.locale ?? "fi";
      let step = "naming";
      let activeLevel = levelKeys[0];
      let configured = false;
      const L = () => config.langs[lang];
      const tag = (kind) => el("span", `mu__tag mu__tag--${kind}`, L().kinds[kind].label);
      const fill = (text, values) => Object.entries(values).reduce((out, [k, v]) => out.replaceAll(`{${k}}`, v), text);

      const tacticValue = () => {
        const chosen = q("[data-tactic]").dataset.value;
        if (chosen !== "custom") return chosen;
        return q("[data-tactic-custom]").value.trim().toLowerCase().replace(/\s+/g, "_") || "custom";
      };
      const options = () => ({
        tactic: tacticValue(),
        format: q("[data-format]").dataset.value,
        term: q("[data-term]:checked").value,
        published: q("[data-mode]:checked").value === "published",
        campaign: q("[data-fixed-campaign]").value,
        content: q("[data-fixed-content]").value,
        termText: q("[data-fixed-term]").value,
        medium: q("[data-medium]").value,
        platform: q("[data-platform]").value,
      });

      const out = q("[data-out]");
      const copyStatus = q("[data-copy-status]");
      const namingStatus = q("[data-naming-status]");

      // ---------- UTM step ----------

      // The published-campaign fields start from the names built in the naming step, once that step has
      // been completed, and never overwrite a value the user has typed.
      const fixedLevels = { campaign: "campaign", term: "adset", content: "ad" };
      function syncFixed() {
        if (!configured) return;
        Object.entries(fixedLevels).forEach(([field, level]) => {
          const input = q(`[data-fixed-${field}]`);
          if (!input.dataset.touched) input.value = nameOf(level);
        });
      }

      function renderBuilder() {
        syncFixed();
        const { ui, params, terms } = L();
        const o = options();
        out.textContent = metaUtm(o);
        copyStatus.textContent = "";

        q("[data-parts]").replaceChildren(
          ...metaUtmParts(o).map(({ key, value }) => {
            const tr = el("tr");
            tr.setAttribute("role", "row");
            const cell = (label) => {
              const td = el("td");
              td.setAttribute("role", "cell");
              td.dataset.label = label;
              return td;
            };
            const variableCell = cell(ui.colVariable);
            variableCell.append(el("code", "mu__code", key), el("span", "mu__name", params[key].label));
            const valueCell = cell(ui.colValue);
            valueCell.append(el("code", "mu__code", value));
            tr.append(variableCell, valueCell);
            return tr;
          })
        );

        const urlParts = [el("span", "mu__u-base", ui.urlBase)];
        metaUtmParts(o).forEach(({ key, value, kind }, n) => {
          urlParts.push(el("span", "mu__u-sep", n === 0 ? "?" : "&"), el("span", "mu__u-key", key), el("span", "mu__u-sep", "="), el("span", `mu__u-val mu__u-val--${kind}`, value));
        });
        q("[data-url]").replaceChildren(...urlParts);

        q("[data-preview]").replaceChildren(
          ...previewRows(o).map((row) => {
            const li = el("li", `mu__row mu__row--${row.kind}`);
            const head = el("div", "mu__rowhead");
            head.append(el("code", "mu__key", row.key), tag(row.kind));
            const value = el("div", "mu__rowvalue");
            if (row.shown == null) value.append(el("span", "mu__muted", ui.noExample));
            else value.append(el("code", "", row.shown), el("span", "mu__muted", ` ${row.isExample ? ui.exampleTag : ui.yourChoiceTag}`));
            const body = el("div", "mu__rowbody");
            body.append(el("p", "mu__meaning", `${params[row.key].label}. ${params[row.key].meaning}`), value);
            li.append(head, body);
            return li;
          })
        );

        q("[data-published-group]").hidden = !o.published;
        q("[data-term-group]").hidden = o.published;
        q("[data-tactic-custom-group]").hidden = q("[data-tactic]").dataset.value !== "custom";
        const mediumNow = q("[data-medium]").value;
        qa("[data-medium-preset]").forEach((chip) => {
          const preset = chip.dataset.mediumPreset;
          chip.setAttribute("aria-pressed", String(preset === "custom" ? !mediumPresets.includes(mediumNow) : preset === mediumNow));
        });
        q("[data-term-effect]").textContent = terms[o.term].effect;
      }

      function renderDirectory() {
        const { ui, items } = L();
        const found = filterDirectory(items, { query: q("[data-search]").value });
        q("[data-count]").textContent = found.length === 1 ? ui.resultOne : ui.resultCount.replace("{n}", found.length);
        q("[data-empty]").hidden = found.length > 0;
        q("[data-dir]").replaceChildren(
          ...found.map((item) => {
            const tr = el("tr", "mu__entry");
            tr.setAttribute("role", "row");
            const cell = (label, column) => {
              const td = el("td");
              td.setAttribute("role", "cell");
              td.dataset.label = label;
              td.dataset.cell = column;
              return td;
            };

            const variableCell = cell(ui.colVariable, "variable");
            variableCell.append(el("code", "mu__code", item.variable));

            const valueCell = cell(ui.colValue, "value");
            valueCell.append(el("code", "mu__code", item.shown));
            if (item.isExample) valueCell.append(el("span", "mu__name", ui.exampleTag));

            const noteCell = cell(ui.colNote, "note");
            noteCell.append(el("p", "mu__desc", item.description));
            if (item.name !== item.platformLabel && item.platformLabel) noteCell.append(el("p", "mu__meta", `${item.name} · ${item.platformLabel}`));
            else if (item.isExample) noteCell.append(el("p", "mu__meta", item.name));

            tr.append(variableCell, valueCell, noteCell);
            return tr;
          })
        );
      }

      async function copyText(text, statusEl, doneText) {
        try {
          await navigator.clipboard.writeText(text);
          statusEl.textContent = doneText;
        } catch {
          statusEl.textContent = L().ui.copyError;
        }
      }

      // ---------- Naming step ----------

      // Templates: the picker chooses a template, "use" copies it into `levels`, and the bar above the
      // builder compares the live structure with the template's own, so the edited state is always
      // computed and never remembered.
      const tplById = Object.fromEntries(config.templates.map((template) => [template.id, template]));
      // the builder opens with the recommended template already in place; the picker only shows on request
      let tplId = "recommended";
      let pickId = "recommended";
      let showAllTpl = false;
      let picking = false;
      const tplLevels = (id) => levelsFromTemplate(tplById[id]);
      const isEdited = () => tplId !== null && !sameStructure(levels, tplLevels(tplId));
      const loadTemplate = (id) => {
        const fresh = tplLevels(id);
        levelKeys.forEach((key) => (levels[key] = fresh[key]));
      };

      function renderTplPreview() {
        const { naming } = L();
        const box = q("[data-tpl-preview]");
        if (!pickId) {
          box.replaceChildren(el("p", "mu__muted", naming.tpl.noSelection));
        } else {
          const preview = tplLevels(pickId);
          const list = el("dl", "mu__overview");
          levelKeys.forEach((key) => {
            const dd = el("dd");
            dd.append(el("code", "", example(preview[key], naming.missingValue) || naming.emptyValue));
            list.append(el("dt", "", naming.levels[key]), dd);
          });
          box.replaceChildren(el("h4", "field-label", naming.tpl.previewTitle), list);
        }
        q("[data-tpl-use]").disabled = !pickId;
      }

      function renderTplBar() {
        const { naming } = L();
        q("[data-tpl-bar]").hidden = picking || tplId === null;
        if (tplId === null) return;
        q("[data-tpl-name]").textContent = naming.templates[tplId].name;
        const edited = isEdited();
        q("[data-tpl-edited]").hidden = !edited;
        q("[data-tpl-reset]").hidden = !edited;
      }

      function renderTemplates() {
        const { naming } = L();
        q("[data-tpl-picker]").hidden = !picking;
        q("[data-tpl-builder]").hidden = picking;
        q("[data-continue]").hidden = picking;
        q("[data-tpl-cancel]").hidden = tplId === null;
        q("[data-tpl-cards]").replaceChildren(
          ...config.templates
            .filter((template) => showAllTpl || template.main)
            .map((template) => {
              const copy = naming.templates[template.id];
              const label = el("label", "mu__termcard mu__tplcard");
              const top = el("span", "mu__termtop");
              const radio = el("input");
              radio.type = "radio";
              radio.name = "mu-tpl";
              radio.value = template.id;
              radio.checked = pickId === template.id;
              radio.dataset.tplRadio = "";
              top.append(el("span", "mu__termname", copy.name), radio);
              label.append(top, el("span", "mu__termnote", copy.description));
              return label;
            })
        );
        const toggle = q("[data-tpl-toggle]");
        toggle.textContent = showAllTpl ? naming.tpl.showLess : naming.tpl.showAll;
        toggle.setAttribute("aria-expanded", String(showAllTpl));
        renderTplPreview();
        renderTplBar();
      }

      function applyTemplate(id) {
        loadTemplate(id);
        tplId = id;
        pickId = id;
        picking = false;
        activeLevel = levelKeys[0];
        renderTemplates();
        renderNaming();
        q("[data-tpl-name]").focus();
      }

      function showPicker() {
        picking = true;
        pickId = tplId;
        renderTemplates();
        q("#mu-tpl-title").focus();
      }

      // one confirm dialog for both questions; Escape and the backdrop cancel it and give focus back
      const confirmDialog = q("[data-confirm-dialog]");
      let confirmAction = null;
      let confirmOpener = null;
      function openConfirm(kind, action) {
        const { tpl } = L().naming;
        q("[data-confirm-title]").textContent = tpl[`${kind}Title`];
        q("[data-confirm-body]").textContent = tpl[`${kind}Body`];
        q("[data-confirm-ok-text]").textContent = tpl[`${kind}Confirm`];
        confirmAction = action;
        confirmOpener = document.activeElement;
        confirmDialog.showModal();
        q("[data-confirm-cancel]").focus();
      }

      // every place that shows or copies a generated name goes through here
      const nameOf = (key) => example(levels[key], L().naming.missingValue);
      const labelOf = (key) => (library[key].custom ? library[key].label : (L().naming.components[key] ?? key));
      const sepName = (value) => (value === " " ? L().naming.sepSpaceName : value === "" ? L().naming.sepNoneName : value);

      function renderRows() {
        const { naming } = L();
        const level = levels[activeLevel];
        const list = q("[data-comps]");

        if (!level.components.length) {
          list.replaceChildren(el("li", "mu__nocomps", naming.noComponents));
          return;
        }

        list.replaceChildren(
          ...level.components.map((comp, index) => {
            const def = library[comp.key];
            const isLast = index === level.components.length - 1;
            const row = el("li", "field-row mu__comp");
            const top = el("div", "field-row__top");
            const label = el("div", "field-row__label");
            const controls = el("div", "field-row__controls");

            const arrows = el("div", "mu__arrows");
            const up = el("button", "mu__arrow-btn", "▲");
            const down = el("button", "mu__arrow-btn", "▼");
            up.dataset.act = "up";
            down.dataset.act = "down";
            [up, down].forEach((b) => (b.type = "button"));
            up.setAttribute("aria-label", naming.moveUp);
            down.setAttribute("aria-label", naming.moveDown);
            up.disabled = index === 0;
            down.disabled = isLast;
            up.addEventListener("click", () => { move(level, index, -1); renderNaming({ index: index - 1, act: "up" }); });
            down.addEventListener("click", () => { move(level, index, 1); renderNaming({ index: index + 1, act: "down" }); });
            arrows.append(up, down);

            label.append(el("span", "field-row__key mu__key", `{${comp.key}}`), el("span", "mu__muted", labelOf(comp.key)));

            let value;
            if (def.type === "predefined" && def.allowed?.length) {
              // a value outside the list (for example after the list was edited) falls back to the first one
              if (!def.allowed.includes(comp.value)) comp.value = def.allowed[0];
              const combo = makeCombobox({
                options: def.allowed.map((opt) => [opt, opt]),
                value: comp.value,
                label: fill(naming.valueFor, { key: comp.key }),
                toggleLabel: L().ui.listToggle,
                onSelect: (picked) => { comp.value = picked; renderOutputs(); },
              });
              value = combo.root;
              value.classList.add("mu__compvalue");
            } else {
              value = el("input", "field");
              value.type = "text";
              value.value = comp.value ?? "";
              value.placeholder = naming.valuePlaceholder;
              value.autocomplete = "off";
              value.spellcheck = false;
              value.classList.add("mu__compvalue");
              value.setAttribute("aria-label", fill(naming.valueFor, { key: comp.key }));
              value.addEventListener("input", () => { comp.value = value.value; renderOutputs(); });
            }

            const sepWrap = el("label", "mu__compsep");
            sepWrap.append(el("span", "mu__muted", naming.separatorField));
            const sep = el("input", "field");
            sep.type = "text";
            sep.maxLength = 3;
            sep.value = isLast ? "" : (comp.sepAfter ?? level.separator);
            sep.disabled = isLast;
            sep.spellcheck = false;
            sep.addEventListener("input", () => { comp.sepAfter = sep.value; renderOutputs(); });
            sepWrap.append(sep);

            const remove = el("button", "field-row__remove", "×");
            remove.type = "button";
            remove.dataset.act = "remove";
            remove.setAttribute("aria-label", `${naming.remove}: ${comp.key}`);
            remove.addEventListener("click", () => { level.components.splice(index, 1); renderNaming({ index, act: "remove" }); });

            controls.append(value, sepWrap, arrows, remove);
            top.append(label, controls);
            row.append(top);
            return row;
          })
        );
      }

      function renderLibrary() {
        const { naming } = L();
        const used = new Set(levels[activeLevel].components.map((c) => c.key));
        const combo = makeCombobox({
          options: Object.keys(library).map((key) => [key, `${labelOf(key)} {${key}}${used.has(key) ? ` (${naming.alreadyAdded})` : ""}`]),
          value: "",
          label: naming.addPlaceholder,
          toggleLabel: L().ui.listToggle,
          text: `+ ${naming.addPlaceholder}`,
          onSelect: (key) => {
            if (!library[key]) return;
            addComponent(levels[activeLevel], key, startValue(library[key], L().naming.sampleValue));
            renderNaming();
            q("[data-library] input").focus();
          },
        });
        q("[data-library]").replaceChildren(combo.root);
      }

      function renderOutputs() {
        const { naming } = L();
        const level = levels[activeLevel];
        // a "copied" message is about the name that was copied, not the one that replaced it
        namingStatus.textContent = "";

        q("[data-formula]").textContent = formula(level) || naming.emptyFormula;
        q("[data-example]").textContent = nameOf(activeLevel) || naming.emptyValue;

        renderTplBar();
        q("[data-overview]").replaceChildren(
          ...levelKeys.flatMap((key) => {
            const dt = el("dt", "", naming.levels[key]);
            const dd = el("dd");
            dd.append(el("code", "", nameOf(key) || naming.emptyValue));
            return [dt, dd];
          })
        );

        const warnings = validate(level);
        const box = q("[data-validation]");
        if (!warnings.length) {
          box.replaceChildren(el("span", "", naming.validationOk));
        } else {
          const list = el("ul", "mu__warnings");
          warnings.forEach((w) => list.append(el("li", "", fill(naming.warnings[w.code], { key: `{${w.key ?? ""}}` }))));
          box.replaceChildren(el("strong", "", naming.validationTitle), list);
        }
      }

      // the rows are rebuilt on every change, so a button the user just pressed is gone: put focus on
      // the matching new one. A disabled arrow hands focus to its neighbour; after the last removal it goes to the add list.
      function restoreFocus({ index, act }) {
        const rows = qa("[data-comps] .mu__comp");
        const button = (row, name) => row?.querySelector(`[data-act="${name}"]`);
        const target = act === "remove"
          ? (button(rows[index], "remove") ?? q("[data-library] input"))
          : (() => { const own = button(rows[index], act); return own && !own.disabled ? own : button(rows[index], act === "up" ? "down" : "up"); })();
        target?.focus();
      }

      function renderNaming(focus) {
        const { naming } = L();
        const level = levels[activeLevel];
        q("[data-comps-heading]").textContent = fill(naming.componentsHeading, { level: naming.levels[activeLevel] });
        qa("[data-level-btn]").forEach((b, n) => {
          const [, main, sub] = naming.levels[b.dataset.levelBtn].match(/^(.*?)(?:\s*(\([^)]*\)))?$/);
          b.replaceChildren(`${n + 1}. ${main}`);
          if (sub) b.append(el("span", "mu__tabsub", ` ${sub}`));
          const on = b.dataset.levelBtn === activeLevel;
          b.setAttribute("aria-selected", String(on));
          b.tabIndex = on ? 0 : -1;
        });
        q("#mu-levelpanel").setAttribute("aria-labelledby", `mu-tab-${activeLevel}`);
        qa("[data-sep-btn]").forEach((b) => {
          b.setAttribute("aria-pressed", String(b.dataset.sepBtn === level.separator));
          b.setAttribute("aria-label", sepName(b.dataset.sepBtn));
          b.textContent = b.dataset.sepBtn === " " ? naming.sepSpace : b.dataset.sepBtn === "" ? naming.sepNone : b.dataset.sepBtn;
        });
        q("[data-lowercase]").checked = level.lowercase;
        renderRows();
        renderLibrary();
        renderOutputs();
        if (focus) restoreFocus(focus);
      }

      function renderBanner() {
        const { naming } = L();
        const box = q("[data-banner]");
        const button = (text, onClick) => {
          const b = el("button", "mu__link", text);
          b.type = "button";
          b.addEventListener("click", onClick);
          return b;
        };
        if (!configured) {
          box.replaceChildren(el("span", "", naming.bannerOff), button(naming.bannerOffAction, () => setStep("naming", { scroll: true })));
          return;
        }
        const details = el("details", "mu__bannerdetails");
        details.append(el("summary", "", naming.bannerShow));
        const grid = el("dl", "mu__overview");
        levelKeys.forEach((key) => {
          const dd = el("dd");
          dd.append(el("code", "", formula(levels[key])), el("br"), el("code", "mu__strong", nameOf(key)));
          grid.append(el("dt", "", naming.levels[key]), dd);
        });
        details.append(grid);
        details.addEventListener("toggle", () => (details.querySelector("summary").textContent = details.open ? naming.bannerHide : naming.bannerShow));
        box.replaceChildren(el("span", "", naming.bannerOn), button(naming.bannerEdit, () => setStep("naming", { scroll: true })), details);
      }

      // ---------- Steps and language ----------

      function setStep(next, { scroll = false } = {}) {
        step = next;
        qa("[data-step]").forEach((view) => (view.hidden = view.dataset.step !== step));
        qa("[data-step-btn]").forEach((b) => {
          const on = b.dataset.stepBtn === step;
          b.setAttribute("aria-selected", String(on));
          b.tabIndex = on ? 0 : -1;
        });
        if (step === "utm") { renderBanner(); renderBuilder(); }
        if (scroll) q(".mu__stepbar").scrollIntoView({ block: "start" });
      }

      function applyLanguage() {
        const d = L();
        root.lang = lang;
        qa("[data-i18n]").forEach((node) => {
          const value = get(d, node.dataset.i18n);
          if (value == null) return;
          if ("i18nHtml" in node.dataset) node.innerHTML = value;
          else node.textContent = value;
        });
        // the hero note sits outside the tool, in the page
        const note = document.querySelector('[data-i18n="page.note"]');
        if (note) note.innerHTML = d.page.note;
        qa("[data-i18n-attr]").forEach((node) => {
          node.dataset.i18nAttr.split(";").forEach((pair) => {
            const [attr, key] = pair.split(":");
            const value = get(d, key);
            if (value != null) node.setAttribute(attr, value);
          });
        });

        customType.relabel(typeOptions(), d.naming.customType, d.ui.listToggle);

        // the shared combobox builds its options once, so swap their labels here
        selects.forEach((key) => {
          const labels = Object.fromEntries(d.selects[key]);
          const input = q(`[data-select="${key}"]`);
          qa(`[data-select-menu="${key}"] .combobox__option`).forEach((option) => (option.querySelector(".combobox__name").textContent = labels[option.dataset.value]));
          input.value = labels[input.dataset.value];
        });

        namingStatus.textContent = "";
        copyStatus.textContent = "";
        renderTemplates();
        renderNaming();
        renderBuilder();
        renderDirectory();
        if (step === "utm") renderBanner();
      }

      // ---------- Events ----------

      root.addEventListener("input", (event) => {
        if (!event.target.closest('[data-step="utm"]')) return;
        if (event.target.matches("[data-fixed-campaign], [data-fixed-term], [data-fixed-content]")) event.target.dataset.touched = "1";
        if (event.target.closest("[data-dir-controls]")) renderDirectory();
        else renderBuilder();
      });
      q("[data-copy]").addEventListener("click", () => copyText(out.textContent, copyStatus, L().ui.copied));
      q("[data-copy-formula]").addEventListener("click", () => copyText(formula(levels[activeLevel]), namingStatus, L().naming.formulaCopied));
      q("[data-copy-example]").addEventListener("click", () => copyText(nameOf(activeLevel), namingStatus, L().naming.exampleCopied));

      // the tabs never scroll the page: only the continue and edit buttons below do
      qa("[data-step-btn]").forEach((b) => b.addEventListener("click", () => setStep(b.dataset.stepBtn)));
      qa("[data-level-btn]").forEach((b) => b.addEventListener("click", () => { activeLevel = b.dataset.levelBtn; namingStatus.textContent = ""; renderNaming(); }));
      qa("[data-step-btn], [data-level-btn]").forEach((b) => b.addEventListener("keydown", (event) => {
        const all = qa(b.matches("[data-step-btn]") ? "[data-step-btn]" : "[data-level-btn]");
        const n = all.indexOf(b);
        const to = { ArrowRight: n + 1, ArrowLeft: n - 1, Home: 0, End: all.length - 1 }[event.key];
        if (to == null) return;
        event.preventDefault();
        const next = all[(to + all.length) % all.length];
        next.click();
        next.focus();
      }));
      qa("[data-sep-btn]").forEach((b) => b.addEventListener("click", () => { setSeparator(levels[activeLevel], b.dataset.sepBtn); renderNaming(); }));
      q("[data-lowercase]").addEventListener("change", (event) => { setLowercase(levels[activeLevel], event.target.checked); renderOutputs(); });
      q("[data-open-naming]").addEventListener("click", () => setStep("naming"));

      q("[data-tpl-cards]").addEventListener("change", (event) => {
        if (!event.target.matches("[data-tpl-radio]")) return;
        pickId = event.target.value;
        renderTplPreview();
      });
      q("[data-tpl-toggle]").addEventListener("click", () => {
        showAllTpl = !showAllTpl;
        if (!showAllTpl && pickId && !tplById[pickId].main) pickId = null;
        renderTemplates();
      });
      q("[data-tpl-use]").addEventListener("click", () => {
        if (!pickId) return;
        if (isEdited()) openConfirm("switch", () => applyTemplate(pickId));
        else applyTemplate(pickId);
      });
      q("[data-tpl-cancel]").addEventListener("click", () => {
        picking = false;
        renderTemplates();
        q("[data-tpl-change]").focus();
      });
      q("[data-tpl-change]").addEventListener("click", showPicker);
      q("[data-tpl-reset]").addEventListener("click", () => openConfirm("reset", () => {
        loadTemplate(tplId);
        renderNaming();
        q("[data-tpl-name]").focus();
      }));
      q("[data-confirm-cancel]").addEventListener("click", () => confirmDialog.close());
      q("[data-confirm-ok]").addEventListener("click", () => {
        const action = confirmAction;
        confirmAction = null;
        confirmDialog.close();
        action?.();
      });
      confirmDialog.addEventListener("click", (event) => { if (event.target === confirmDialog) confirmDialog.close(); });
      confirmDialog.addEventListener("close", () => {
        if (!confirmAction) return;
        confirmAction = null;
        confirmOpener?.focus();
      });
      q("[data-confirm-form]").addEventListener("submit", (event) => event.preventDefault());
      q("[data-continue]").addEventListener("click", () => { configured = true; setStep("utm", { scroll: true }); });

      // custom component form
      const typeOptions = () => [["free", L().naming.typeFree], ["predefined", L().naming.typePredefined]];
      const customType = makeCombobox({
        options: typeOptions(),
        value: "free",
        label: L().naming.customType,
        toggleLabel: L().ui.listToggle,
        onSelect: (picked) => (q("[data-custom-allowed-group]").hidden = picked !== "predefined"),
      });
      q("[data-custom-type-host]").replaceChildren(customType.root);
      q("[data-custom-type-label]").htmlFor = customType.input.id;
      const customError = q("[data-custom-error]");
      const dialog = q("[data-custom-dialog]");
      const clearInvalid = () => {
        customError.hidden = true;
        q("[data-custom-key]").removeAttribute("aria-invalid");
        q("[data-custom-key]").removeAttribute("aria-describedby");
      };
      const resetCustom = () => {
        qa("[data-custom-key], [data-custom-label], [data-custom-allowed]").forEach((input) => (input.value = ""));
        customType.set("free");
        q("[data-custom-allowed-group]").hidden = true;
        clearInvalid();
      };
      q("[data-custom-key]").addEventListener("input", clearInvalid);
      q("[data-custom-open]").addEventListener("click", () => { resetCustom(); dialog.showModal(); q("[data-custom-key]").focus(); });
      qa("[data-custom-close], [data-custom-cancel]").forEach((b) => b.addEventListener("click", () => dialog.close()));
      // a click on the backdrop (the dialog element itself) closes it
      dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
      q("[data-custom-form]").addEventListener("submit", (event) => event.preventDefault());
      q("[data-custom-save]").addEventListener("click", () => {
        const key = cleanKey(q("[data-custom-key]").value);
        // the message is a data-i18n text, so a language switch rewrites it
        const keyInput = q("[data-custom-key]");
        const fail = (i18nKey) => {
          customError.dataset.i18n = i18nKey;
          customError.textContent = get(L(), i18nKey);
          customError.hidden = false;
          keyInput.setAttribute("aria-invalid", "true");
          keyInput.setAttribute("aria-describedby", customError.id);
          keyInput.focus();
        };
        if (!key) return fail("naming.customKeyMissing");
        if (library[key]) return fail("naming.customKeyExists");
        clearInvalid();

        const label = q("[data-custom-label]").value.trim() || key;
        const def = { custom: true, label, type: customType.input.dataset.value };
        if (def.type === "predefined") {
          def.allowed = q("[data-custom-allowed]").value.split(",").map((s) => s.trim()).filter(Boolean);
          if (!def.allowed.length) def.type = "free";
        }
        library[key] = def;
        addComponent(levels[activeLevel], key, startValue(def, L().naming.sampleValue));

        resetCustom();
        dialog.close();
        renderNaming();
      });

      // utm_medium: shortcut chips fill the field; "other" moves the cursor to it
      qa("[data-medium-preset]").forEach((chip) => chip.addEventListener("click", () => {
        const field = q("[data-medium]");
        if (chip.dataset.mediumPreset === "custom") {
          field.focus();
          field.select();
        } else {
          field.value = chip.dataset.mediumPreset;
        }
        renderBuilder();
      }));
      selects.forEach((key) => initSelectCombobox(q(`[data-select="${key}"]`), q(`[data-select-toggle="${key}"]`), q(`[data-select-menu="${key}"]`), config.langs[lang].selects[key], renderBuilder));

      loadTemplate(tplId);
      renderTemplates();
      renderNaming();
      renderBuilder();
      renderDirectory();
    });
  };

  initMetaUtmTools();
  document.addEventListener("astro:page-load", initMetaUtmTools);
</script>

<style is:global>
  /* the tool renders most of its rows with JavaScript, so scoped styles would miss them; every selector starts with .mu */
  /* elements toggled with [hidden] also set display in CSS, so hidden must win */
  .mu [hidden] { display: none !important; }

  .mu {

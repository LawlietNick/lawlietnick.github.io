  .mu__stepbar, .mu__tabs { display: flex; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 4%, var(--bg)); border-radius: calc(var(--mu-radius) - 1px) calc(var(--mu-radius) - 1px) 0 0; }
